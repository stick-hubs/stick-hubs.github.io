+                                checked={addScript}
+                                type="checkbox"
+                                onChange={e => this.setState({addScript: e.target.checked})} // eslint-disable-line react/jsx-no-bind
+                            />
+                            {'Add a script that plays the animation when the green flag is clicked'}
+                        </label>
+                        {message ? <div className={styles.message}>{message}</div> : null}
+                    </div>
+                </div>
+                <div className={styles.timeline}>
+                    <div className={styles.controls}>
+                        <button
+                            className={styles.ctrl}
+                            title="Previous frame (,)"
+                            onClick={() => this.goTo(current - 1)} // eslint-disable-line react/jsx-no-bind
+                        >{'⏮'}</button>
+                        <button
+                            className={classNames(styles.ctrl, styles.playButton)}
+                            title="Play / stop (Enter)"
+                            onClick={this.togglePlay}
+                        >{playing ? '■' : '▶'}</button>
+                        <button
+                            className={styles.ctrl}
+                            title="Next frame (.)"
+                            onClick={() => this.goTo(current + 1)} // eslint-disable-line react/jsx-no-bind
+                        >{'⏭'}</button>
+                        <label className={styles.fps}>
+                            <input
+                                max="60"
+                                min="1"
+                                type="number"
+                                value={fps}
+                                onChange={e => this.setState({fps: Math.max(1, Math.min(60, +e.target.value || 1))})} // eslint-disable-line react/jsx-no-bind
+                            />
+                            {'fps'}
+                        </label>
+                        <label className={styles.check}>
+                            <input
+                                checked={loop}
+                                type="checkbox"
+                                onChange={e => this.setState({loop: e.target.checked})} // eslint-disable-line react/jsx-no-bind
+                            />
+                            {'Loop'}
+                        </label>
+                        <span className={styles.ctrlSep} />
+                        <button
+                            className={styles.button}
+                            title="Copy this frame into a new frame (F6)"
+                            onClick={this.insertKeyframe}
+                        >{'+ Keyframe'}</button>
+                        <button
+                            className={styles.button}
+                            title="Add an empty frame (F7)"
+                            onClick={this.insertBlank}
+                        >{'+ Blank'}</button>
+                        <button
+                            className={styles.button}
+                            title="Move frame left"
+                            onClick={() => this.moveFrame(-1)} // eslint-disable-line react/jsx-no-bind
+                        >{'◀'}</button>
+                        <button
+                            className={styles.button}
+                            title="Move frame right"
+                            onClick={() => this.moveFrame(1)} // eslint-disable-line react/jsx-no-bind
+                        >{'▶'}</button>
+                        <button
+                            className={styles.button}
+                            title="Delete frame (Delete)"
+                            onClick={this.deleteFrame}
+                        >{'Delete'}</button>
+                        <span className={styles.ctrlSep} />
+                        <button
+                            className={styles.button}
+                            title="Make in-between frames from this frame to the next one, like a Flash tween"
+                            onClick={this.tween}
+                        >{'Tween'}</button>
+                        <label className={styles.fps}>
+                            <input
+                                max="30"
+                                min="1"
+                                type="number"
+                                value={this.state.tweenCount}
+                                onChange={e => this.setState({tweenCount: Math.max(1, Math.min(30, +e.target.value || 1))})} // eslint-disable-line react/jsx-no-bind
+                            />
+                            {'in-betweens'}
+                        </label>
+                        <span className={styles.frameCount}>{`Frame ${current + 1} of ${frames.length}`}</span>
+                    </div>
+                    <div className={styles.cells}>
+                        {frames.map((f, i) => (
+                            <button
+                                key={f.key}
+                                className={classNames(styles.cell, {[styles.cellActive]: i === current})}
+                                title={f.name || 'New frame'}
+                                onClick={() => this.setState({current: i})} // eslint-disable-line react/jsx-no-bind
+                            >
+                                <span className={styles.cellNumber}>{i + 1}</span>
+                                {f.thumb ? <img
+                                    alt=""
+                                    className={styles.cellThumb}
+                                    draggable={false}
+                                    src={f.thumb}
+                                /> : null}
+                                {f.dirty ? <span className={styles.cellDot} /> : null}
+                            </button>
+                        ))}
+                    </div>
+                </div>
+            </div>
+        );
+    }
+}
+
+AnimateEditor.propTypes = {
+    onClose: PropTypes.func.isRequired,
+    vm: PropTypes.shape({
+        editingTarget: PropTypes.object,
+        runtime: PropTypes.object
+    }).isRequired
+};
+
+export default AnimateEditor;
