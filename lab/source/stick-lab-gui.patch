+                setTimeout(() => {
+                    sessionCache.set(target.id, {...snapshot, signature: costumeSignature(target)});
+                }, 1500);
+            } else {
+                sessionCache.delete(target.id);
+            }
+            this.props.onClose(true);
+        } catch (e) {
+            console.error(e); // eslint-disable-line no-console
+            this.setState({saving: false, message: `Couldn't save the animation: ${e.message}`});
+        }
+    }
+
+    addPlayScript (target, firstName) {
+        const id = n => `slAnim${Date.now().toString(36)}${n}`;
+        const ids = [1, 2, 3, 4, 5, 6, 7].map(id);
+        const wait = Math.round((1 / Math.max(1, this.state.fps)) * 1000) / 1000;
+        const blocks = [
+            {id: ids[0], opcode: 'event_whenflagclicked', inputs: {}, fields: {}, next: ids[1], parent: null,
+                shadow: false, topLevel: true, x: 40, y: 40},
+            {id: ids[1], opcode: 'looks_switchcostumeto',
+                inputs: {COSTUME: {name: 'COSTUME', block: ids[2], shadow: ids[2]}}, fields: {},
+                next: ids[3], parent: ids[0], shadow: false, topLevel: false},
+            {id: ids[2], opcode: 'looks_costume', inputs: {}, fields: {COSTUME: {name: 'COSTUME', value: firstName}},
+                next: null, parent: ids[1], shadow: true, topLevel: false},
+            {id: ids[3], opcode: 'control_forever', inputs: {SUBSTACK: {name: 'SUBSTACK', block: ids[4], shadow: null}},
+                fields: {}, next: null, parent: ids[1], shadow: false, topLevel: false},
+            {id: ids[4], opcode: 'control_wait', inputs: {DURATION: {name: 'DURATION', block: ids[5], shadow: ids[5]}},
+                fields: {}, next: ids[6], parent: ids[3], shadow: false, topLevel: false},
+            {id: ids[5], opcode: 'math_positive_number', inputs: {}, fields: {NUM: {name: 'NUM', value: String(wait)}},
+                next: null, parent: ids[4], shadow: true, topLevel: false},
+            {id: ids[6], opcode: 'looks_nextcostume', inputs: {}, fields: {}, next: null, parent: ids[4],
+                shadow: false, topLevel: false}
+        ];
+        return Promise.resolve(this.props.vm.shareBlocksToTarget(blocks, target.id)).then(() => {
+            if (this.props.vm.editingTarget === target) this.props.vm.emitWorkspaceUpdate();
+        });
+    }
+
+    handleClose () {
