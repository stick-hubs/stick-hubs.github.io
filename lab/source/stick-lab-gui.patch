+    }
+    handleReplaceCode (code, id) {
+        const ws = getWorkspace();
+        if (!ws) {
+            this.setState({error: 'Open the Script tab first, then try again.'});
+            return;
+        }
+        // eslint-disable-next-line no-alert
+        if (!window.confirm('Replace all the scripts of this sprite with Duo\'s fixed scripts?')) return;
+        try {
+            applyText(`${code}\n`, {
+                ScratchBlocks: ws.ScratchBlocks,
+                workspace: ws.workspace,
+                vm: this.props.vm,
+                toolboxXML: this.props.toolboxXML
