diff --git a/src/components/sl-duo/duo-panel.jsx b/src/components/sl-duo/duo-panel.jsx
new file mode 100644
index 0000000..4814f90
--- /dev/null
+++ b/src/components/sl-duo/duo-panel.jsx
@@ -0,0 +1,462 @@
+import React from 'react';
+import PropTypes from 'prop-types';
+import {connect} from 'react-redux';
+import classNames from 'classnames';
+import {isDuoOpen, setDuoOpen, onDuoChange} from './duo-store';
+import {loadSettings, saveSettings, loadConfig, sendToDuo} from '../../lib/sl-duo/duo-client';
+import {getWorkspace} from '../../lib/sl-workspace-registry';
+import {workspaceToText} from '../../lib/sl-text-code/printer';
+import {applyText, commandList} from '../../lib/sl-text-code/apply';
+import styles from './duo.css';
+
+const WELCOME = 'Hi! I\'m **Stick Lab Duo**. I can explain blocks, find bugs, and write scripts for you. ' +
+    'Try: "make my sprite jump when I press space" or "why doesn\'t my score go up?"';
+
+const SUGGESTIONS = [
+    'Make my sprite jump when I press space',
+    'Explain what my scripts do',
+    'Give me an idea for a game'
+];
+
+const SYNTAX = `Stick Lab Text coding (each script starts with a "when" block):
+when_flag_clicked {
+    go_to_xy(0, 0)
+    repeat (10) {
+        move(10)
+        if (touching("_edge_")) {
+            turn_right(180)
+        } else {
+            change_var($score, 1)
+        }
+    }
+}
+Rules: values go in ( ) separated by commas. Text and menu choices go in "quotes". $name is a variable,
+@name is a list, %name is a custom block input. Maths: + - * / mod. Compare: > < ==. Logic: and or not.
+C blocks (if, repeat, forever, repeat_until, while) use { }. if ... else uses } else {.
+Custom blocks: define "jump %s" (%height) { ... } and call "jump %s" (50).
+Loose commands go in stack { ... }. Comments start with //.`;
+
+const escapeHtml = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+
+const inlineMarkdown = text => escapeHtml(text)
+    .replace(/`([^`]+)`/g, '<code>$1</code>')
+    .replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>')
+    .replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<i>$2</i>');
+
+const splitMessage = text => {
+    const parts = [];
+    const re = /```([a-zA-Z]*)\n?([\s\S]*?)(```|$)/g;
+    let last = 0;
+    let m;
+    while ((m = re.exec(text))) {
+        if (m.index > last) parts.push({type: 'text', text: text.slice(last, m.index)});
+        parts.push({type: 'code', lang: m[1], text: m[2].replace(/\n$/, ''), closed: m[3] === '```'});
+        last = re.lastIndex;
+        if (m[0] === '') re.lastIndex++;
+    }
+    if (last < text.length) parts.push({type: 'text', text: text.slice(last)});
+    return parts;
+};
+
+const TextPart = ({text}) => {
+    const lines = text.split('\n');
+    const out = [];
+    let list = null;
+    lines.forEach((line, i) => {
+        const bullet = /^\s*[-*]\s+(.*)$/.exec(line) || /^\s*\d+[.)]\s+(.*)$/.exec(line);
+        if (bullet) {
+            if (!list) {
+                list = [];
+                out.push({type: 'list', items: list, key: i});
+            }
+            list.push(bullet[1]);
+        } else {
+            list = null;
+            if (line.trim()) out.push({type: 'p', text: line.replace(/^#+\s*/, ''), key: i, heading: /^#+\s/.test(line)});
+        }
+    });
+    return (
+        <React.Fragment>
+            {out.map(block => (block.type === 'list' ? (
+                <ul key={block.key}>
+                    {block.items.map((item, j) => (
+                        <li
+                            key={j}
+                            dangerouslySetInnerHTML={{__html: inlineMarkdown(item)}} // eslint-disable-line react/no-danger
+                        />
+                    ))}
+                </ul>
+            ) : (
+                <p
+                    className={block.heading ? styles.heading : null}
+                    key={block.key}
+                    dangerouslySetInnerHTML={{__html: inlineMarkdown(block.text)}} // eslint-disable-line react/no-danger
+                />
+            )))}
+        </React.Fragment>
+    );
+};
+TextPart.propTypes = {text: PropTypes.string};
+
+class DuoPanel extends React.Component {
+    constructor (props) {
+        super(props);
+        this.state = {
+            open: isDuoOpen(),
+            messages: [],
+            input: '',
+            busy: false,
+            error: null,
+            remaining: null,
+            showSettings: false,
+            settings: loadSettings(),
+            serverReady: null,
+            applied: {}
+        };
+        this.listRef = React.createRef();
+        this.inputRef = React.createRef();
+        this.handleSend = this.handleSend.bind(this);
+        this.handleKeyDown = this.handleKeyDown.bind(this);
+        this.handleStop = this.handleStop.bind(this);
+        this.handleNewChat = this.handleNewChat.bind(this);
+        this.handleClose = () => setDuoOpen(false);
+        this.toggleSettings = () => this.setState(s => ({showSettings: !s.showSettings}));
+    }
+    componentDidMount () {
+        this.unsubscribe = onDuoChange(open => {
+            this.setState({open});
+            if (open) setTimeout(() => this.inputRef.current && this.inputRef.current.focus(), 50);
+        });
+        loadConfig().then(c => this.setState({serverReady: !!c.serverUrl}));
+    }
+    componentDidUpdate (prevProps, prevState) {
+        if (prevState.messages !== this.state.messages && this.listRef.current) {
+            this.listRef.current.scrollTop = this.listRef.current.scrollHeight;
+        }
+    }
+    componentWillUnmount () {
+        this.unsubscribe();
+        if (this.abort) this.abort.abort();
+    }
+    updateSetting (key, value) {
+        const settings = {...this.state.settings, [key]: value};
+        saveSettings(settings);
+        this.setState({settings});
+    }
+    buildSystem () {
+        const lines = [
+            'You are Stick Lab Duo, the friendly coding helper inside Stick Lab, a block coding app by Stick Hubs ' +
+            '(based on Scratch 3 and TurboWarp). Many users are kids and beginners: use simple words, be encouraging, ' +
+            'keep answers short (a few sentences or a short list), and keep everything suitable for children.',
+            'Stick Lab has Block coding and Text coding (a switch under the block categories), a Script tab, a Costumes ' +
+            'tab with an Animate button (Flash-style timeline), and saves projects as .sl files. There are no extensions.',
+            'When you write scripts, write them in Stick Lab Text coding inside a ```stick code block, with complete ' +
+            'scripts that each start with a "when" block, so the user can press "Add to my scripts". ' +
+            'Only use commands from the list below. When explaining blocks in words, use their block names.',
+            '',
+            SYNTAX
+        ];
+        const ws = getWorkspace();
+        if (ws && this.props.toolboxXML) {
+            try {
+                const groups = commandList(ws.ScratchBlocks, this.props.toolboxXML);
+                lines.push('', 'Commands available for this sprite (with example values):');
+                for (const group of groups) {
+                    lines.push(`${group.category}: ${group.items.map(i => i.label).join('  |  ')}`);
+                }
+            } catch (e) {
+                // the command list is optional
+            }
+        }
+        const vm = this.props.vm;
+        const target = vm.editingTarget;
+        if (target) {
+            const sprites = vm.runtime.targets.filter(t => t.isOriginal && !t.isStage).map(t => t.getName());
+            lines.push('', `The user is editing: ${target.isStage ? 'the Stage' : `the sprite "${target.getName()}"`}.`);
+            lines.push(`Sprites in the project: ${sprites.join(', ') || 'none'}.`);
+            lines.push(`Costumes of ${target.getName()}: ${target.getCostumes().map(c => c.name).join(', ')}.`);
+            const vars = Object.values(target.variables).concat(
+                target.isStage ? [] : Object.values(vm.runtime.getTargetForStage().variables)
+            ).filter(v => v.type === '' || v.type === 'list').map(v => (v.type === 'list' ? `@${v.name}` : `$${v.name}`));
+            if (vars.length) lines.push(`Variables and lists: ${vars.join(', ')}.`);
+            if (this.state.settings.seeCode && ws) {
+                try {
+                    const code = workspaceToText(ws.workspace, ws.ScratchBlocks).text.trim();
+                    lines.push('', code ? `The user's current scripts for this sprite:\n\`\`\`stick\n${code}\n\`\`\`` :
+                        'This sprite has no scripts yet.');
+                } catch (e) {
+                    // ignore
+                }
+            }
+        }
+        return lines.join('\n');
+    }
+    async handleSend (textOverride) {
+        const text = (typeof textOverride === 'string' ? textOverride : this.state.input).trim();
+        if (!text || this.state.busy) return;
+        const history = this.state.messages.concat({role: 'user', content: text});
+        this.setState({messages: history.concat({role: 'assistant', content: '', pending: true}), input: '',
+            busy: true, error: null});
+        this.abort = new AbortController();
+        try {
+            const result = await sendToDuo({
+                system: this.buildSystem(),
+                messages: history.map(m => ({role: m.role, content: m.content})).slice(-30),
+                settings: this.state.settings,
+                signal: this.abort.signal,
+                onText: partial => this.setState({messages: history.concat({role: 'assistant', content: partial, pending: true})})
+            });
+            this.setState({
+                messages: history.concat({role: 'assistant', content: result.text || '(no answer)'}),
+                busy: false,
+                remaining: result.remaining
+            });
+        } catch (e) {
+            const stopped = e.name === 'AbortError';
+            this.setState(s => {
+                const last = s.messages[s.messages.length - 1];
+                const keep = last && last.content ? s.messages.slice(0, -1).concat({...last, pending: false}) : history;
+                return {
+                    messages: keep,
+                    busy: false,
+                    error: stopped ? null : e.message,
+                    remaining: typeof e.remaining === 'string' ? e.remaining : s.remaining
+                };
+            });
+        }
+        this.abort = null;
+    }
+    handleStop () {
+        if (this.abort) this.abort.abort();
+    }
+    handleNewChat () {
+        this.handleStop();
+        this.setState({messages: [], error: null, applied: {}});
+    }
+    handleKeyDown (e) {
+        if (e.key === 'Enter' && !e.shiftKey) {
+            e.preventDefault();
+            this.handleSend();
+        }
+    }
+    handleAddCode (code, id) {
+        const ws = getWorkspace();
+        if (!ws) {
+            this.setState({error: 'Open the Script tab first, then try again.'});
+            return;
+        }
+        try {
+            const current = workspaceToText(ws.workspace, ws.ScratchBlocks).text;
+            applyText(`${current}\n\n${code}\n`, {
+                ScratchBlocks: ws.ScratchBlocks,
+                workspace: ws.workspace,
+                vm: this.props.vm,
+                toolboxXML: this.props.toolboxXML
+            });
+            this.setState(s => ({applied: {...s.applied, [id]: true}, error: null}));
+        } catch (e) {
+            this.setState({error: `That code didn't fit: ${e.message}. Ask Duo to fix it.`});
+        }
+    }
+    renderMessage (m, i) {
+        if (m.role === 'user') {
+            return (
+                <div
+                    key={i}
+                    className={classNames(styles.bubble, styles.user)}
+                >{m.content}</div>
+            );
+        }
+        const parts = splitMessage(m.content);
+        return (
+            <div
+                key={i}
+                className={classNames(styles.bubble, styles.duo)}
+            >
+                {parts.map((part, j) => {
+                    if (part.type === 'text') {
+                        return (<TextPart
+                            key={j}
+                            text={part.text}
+                        />);
+                    }
+                    const id = `${i}-${j}`;
+                    const canAdd = part.closed && !m.pending && (part.lang === 'stick' || part.lang === '');
+                    return (
+                        <div
+                            key={j}
+                            className={styles.code}
+                        >
+                            <pre>{part.text}</pre>
+                            {canAdd ? (
+                                <button
+                                    className={styles.addButton}
+                                    disabled={this.state.applied[id]}
+                                    onClick={() => this.handleAddCode(part.text, id)} // eslint-disable-line react/jsx-no-bind
+                                >{this.state.applied[id] ? '✓ Added to your scripts' : '+ Add to my scripts'}</button>
+                            ) : null}
+                        </div>
+                    );
+                })}
+                {m.pending && !m.content ? <span className={styles.typing}><i /><i /><i /></span> : null}
+            </div>
+        );
+    }
+    render () {
+        if (!this.state.open) return null;
+        const {messages, input, busy, error, remaining, showSettings, settings, serverReady} = this.state;
+        return (
+            <div
+                aria-label="Stick Lab Duo"
+                className={styles.panel}
+                role="dialog"
+            >
+                <div className={styles.header}>
+                    <span className={styles.logo}>{'✦'}</span>
+                    <span className={styles.titles}>
+                        <span className={styles.title}>{'Stick Lab Duo'}</span>
+                        <span className={styles.subtitle}>{'Claude Opus 5.5'}</span>
+                    </span>
+                    <button
+                        className={styles.headerButton}
+                        title="New chat"
+                        onClick={this.handleNewChat}
+                    >{'New'}</button>
+                    <button
+                        className={classNames(styles.headerButton, {[styles.headerButtonActive]: showSettings})}
+                        title="Duo settings"
+                        onClick={this.toggleSettings}
+                    >{'⚙'}</button>
+                    <button
+                        className={styles.headerButton}
+                        title="Close"
+                        onClick={this.handleClose}
+                    >{'✕'}</button>
+                </div>
+                {showSettings ? (
+                    <div className={styles.settings}>
+                        <div className={styles.settingsTitle}>{'How Duo connects'}</div>
+                        <label className={styles.radio}>
+                            <input
+                                checked={settings.mode === 'server'}
+                                name="duo-mode"
+                                type="radio"
+                                onChange={() => this.updateSetting('mode', 'server')} // eslint-disable-line react/jsx-no-bind
+                            />
+                            <span>
+                                <b>{'Stick Hubs server'}</b>
+                                {serverReady === false ? ' (not switched on yet)' : ' · free daily messages'}
+                            </span>
+                        </label>
+                        <label className={styles.radio}>
+                            <input
+                                checked={settings.mode === 'key'}
+                                name="duo-mode"
+                                type="radio"
+                                onChange={() => this.updateSetting('mode', 'key')} // eslint-disable-line react/jsx-no-bind
+                            />
+                            <span><b>{'My own Anthropic API key'}</b>{' · no daily limit, billed to you'}</span>
+                        </label>
+                        {settings.mode === 'key' ? (
+                            <input
+                                autoComplete="off"
+                                className={styles.field}
+                                placeholder="sk-ant-..."
+                                type="password"
+                                value={settings.apiKey}
+                                onChange={e => this.updateSetting('apiKey', e.target.value.trim())} // eslint-disable-line react/jsx-no-bind
+                            />
+                        ) : (
+                            <React.Fragment>
+                                <div className={styles.fieldLabel}>{'Owner pass (only for the owner\'s device)'}</div>
+                                <input
+                                    autoComplete="off"
+                                    className={styles.field}
+                                    placeholder="Leave empty"
+                                    type="password"
+                                    value={settings.ownerPass}
+                                    onChange={e => this.updateSetting('ownerPass', e.target.value)} // eslint-disable-line react/jsx-no-bind
+                                />
+                            </React.Fragment>
+                        )}
+                        <label className={styles.radio}>
+                            <input
+                                checked={settings.seeCode}
+                                type="checkbox"
+                                onChange={e => this.updateSetting('seeCode', e.target.checked)} // eslint-disable-line react/jsx-no-bind
+                            />
+                            <span>{'Let Duo see the scripts of the sprite I\'m editing'}</span>
+                        </label>
+                        <div className={styles.note}>
+                            {'Keys and passes are saved only in this browser on this device.'}
+                        </div>
+                    </div>
+                ) : null}
+                <div
+                    className={styles.messages}
+                    ref={this.listRef}
+                >
+                    <div className={classNames(styles.bubble, styles.duo)}>
+                        <TextPart text={WELCOME} />
+                    </div>
+                    {messages.length === 0 ? (
+                        <div className={styles.suggestions}>
+                            {SUGGESTIONS.map(s => (
+                                <button
+                                    key={s}
+                                    className={styles.suggestion}
+                                    onClick={() => this.handleSend(s)} // eslint-disable-line react/jsx-no-bind
+                                >{s}</button>
+                            ))}
+                        </div>
+                    ) : null}
+                    {messages.map((m, i) => this.renderMessage(m, i))}
+                    {error ? <div className={styles.error}>{error}</div> : null}
+                </div>
+                <div className={styles.composer}>
+                    <textarea
+                        className={styles.input}
+                        placeholder="Ask Duo anything about your project..."
+                        ref={this.inputRef}
+                        rows={2}
+                        value={input}
+                        onChange={e => this.setState({input: e.target.value})} // eslint-disable-line react/jsx-no-bind
+                        onKeyDown={this.handleKeyDown}
+                    />
+                    {busy ? (
+                        <button
+                            className={classNames(styles.send, styles.stop)}
+                            onClick={this.handleStop}
+                        >{'Stop'}</button>
+                    ) : (
+                        <button
+                            className={styles.send}
+                            disabled={!input.trim()}
+                            onClick={this.handleSend}
+                        >{'Send'}</button>
+                    )}
+                </div>
+                <div className={styles.footer}>
+                    {settings.mode === 'key' ? 'Using your own API key' :
+                        remaining === 'unlimited' ? 'Owner device: unlimited messages' :
+                            remaining !== null ? `${remaining} free message${remaining === '1' ? '' : 's'} left today` :
+                                'Duo can make mistakes. Check its code before you use it.'}
+                </div>
+            </div>
+        );
+    }
+}
+
+DuoPanel.propTypes = {
+    toolboxXML: PropTypes.string,
+    vm: PropTypes.shape({
+        editingTarget: PropTypes.object,
+        runtime: PropTypes.object
+    }).isRequired
+};
+
+const mapStateToProps = state => ({
+    toolboxXML: state.scratchGui.toolbox.toolboxXML
+});
+
+export default connect(mapStateToProps)(DuoPanel);
