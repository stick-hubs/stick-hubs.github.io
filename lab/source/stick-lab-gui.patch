+++ b/src/lib/sl-duo/duo-client.js
@@ -0,0 +1,127 @@
+// Stick Lab Duo: talks to Claude Opus 5.5, through the Stick Hubs Duo server or the user's own API key.
+
+const MODEL = 'claude-opus-5-5';
+const STORAGE_KEY = 'stick-lab-duo-settings';
+
+const loadSettings = () => {
+    try {
+        return {mode: 'server', apiKey: '', ownerPass: '', seeCode: true, ...JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}')};
+    } catch (e) {
+        return {mode: 'server', apiKey: '', ownerPass: '', seeCode: true};
+    }
+};
+
+const saveSettings = settings => {
+    try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
+    } catch (e) {
+        // storage blocked: settings last until the page closes
+    }
+};
+
+let configPromise = null;
+const loadConfig = () => {
+    if (!configPromise) {
+        configPromise = fetch('duo-config.json', {cache: 'no-cache'})
+            .then(r => (r.ok ? r.json() : {}))
+            .catch(() => ({}));
+    }
+    return configPromise;
+};
+
+/**
+ * Read a Claude streaming response and call onText with each new piece of text.
+ * @returns {Promise<string>} the whole reply
+ */
+const readStream = async (response, onText) => {
+    const reader = response.body.getReader();
+    const decoder = new TextDecoder();
+    let buffer = '';
+    let full = '';
+    for (;;) {
+        const {done, value} = await reader.read();
+        if (done) break;
+        buffer += decoder.decode(value, {stream: true});
+        let split;
+        while ((split = buffer.indexOf('\n\n')) !== -1) {
+            const event = buffer.slice(0, split);
+            buffer = buffer.slice(split + 2);
+            for (const line of event.split('\n')) {
+                if (!line.startsWith('data:')) continue;
+                let data;
+                try {
+                    data = JSON.parse(line.slice(5).trim());
+                } catch (e) {
+                    continue;
+                }
+                if (data.type === 'content_block_delta' && data.delta && data.delta.type === 'text_delta') {
+                    full += data.delta.text;
+                    onText(full);
+                } else if (data.type === 'error') {
+                    throw new Error((data.error && data.error.message) || 'Claude had a problem. Try again.');
+                }
+            }
+        }
+    }
+    return full;
+};
+
+const errorFrom = async response => {
+    try {
+        const body = await response.json();
+        return (body.error && (body.error.message || body.error)) || `Error ${response.status}`;
+    } catch (e) {
+        return `Error ${response.status}`;
+    }
+};
+
+/**
+ * Send a conversation to Duo.
+ * @param {{system: string, messages: Array, settings: object, onText: Function, signal: AbortSignal}} options
+ * @returns {Promise<{text: string, remaining: ?string}>} reply
+ */
+const sendToDuo = async ({system, messages, settings, onText, signal}) => {
+    if (settings.mode === 'key') {
+        if (!settings.apiKey) throw new Error('Add your Anthropic API key in Duo settings first.');
+        const response = await fetch('https://api.anthropic.com/v1/messages', {
+            method: 'POST',
+            signal,
+            headers: {
+                'content-type': 'application/json',
+                'x-api-key': settings.apiKey,
+                'anthropic-version': '2023-06-01',
+                'anthropic-dangerous-direct-browser-access': 'true'
+            },
+            body: JSON.stringify({model: MODEL, max_tokens: 2048, system, messages, stream: true})
+        });
+        if (!response.ok) throw new Error(await errorFrom(response));
+        return {text: await readStream(response, onText), remaining: null};
+    }
+    const config = await loadConfig();
+    if (!config.serverUrl) {
+        throw new Error('The Stick Hubs Duo server isn\'t switched on yet. You can add your own Anthropic API key in Duo settings.');
+    }
+    const headers = {'content-type': 'application/json'};
+    if (settings.ownerPass) headers['x-duo-owner'] = settings.ownerPass;
+    const response = await fetch(`${config.serverUrl.replace(/\/$/, '')}/chat`, {
+        method: 'POST',
+        signal,
+        headers,
+        body: JSON.stringify({system, messages})
+    });
+    const remaining = response.headers.get('x-duo-remaining');
+    if (!response.ok) {
+        const error = new Error(await errorFrom(response));
+        error.remaining = remaining;
+        throw error;
+    }
+    return {text: await readStream(response, onText), remaining};
+};
+
+export {
+    MODEL,
+    loadSettings,
+    saveSettings,
+    loadConfig,
+    sendToDuo
+};
diff --git a/src/lib/sl-format.js b/src/lib/sl-format.js
new file mode 100644
index 0000000..e6b14ca
--- /dev/null
+++ b/src/lib/sl-format.js
@@ -0,0 +1,113 @@
+// Stick Lab project format (.sl)
+//
+// A .sl file is a Scratch 3 project that has been scrambled so that only Stick Lab can open it:
+//   bytes 0-7  "STICKLAB" (magic)
+//   byte  8    format version (1)
+//   bytes 9..  the .sb3 zip, every byte XORed with KEY
+// Renaming a .sl file to .sb3 does not make it open in Scratch, because the zip data is scrambled.
+
+const MAGIC = [0x53, 0x54, 0x49, 0x43, 0x4b, 0x4c, 0x41, 0x42]; // "STICKLAB"
+const VERSION = 1;
+const HEADER_LENGTH = MAGIC.length + 1;
+const KEY = new Uint8Array([
+    0x5a, 0x17, 0xc3, 0x2e, 0x91, 0x4b, 0xe8, 0x06, 0x7d, 0xb2, 0x39, 0xf4, 0x60, 0x0d, 0xa5, 0x8c
+]);
+
+const SL_EXTENSION = '.sl';
+const SL_MIME = 'application/x-stick-lab';
+
+const toUint8Array = data => {
+    if (data instanceof Uint8Array) return data;
+    if (data instanceof ArrayBuffer) return new Uint8Array(data);
+    if (ArrayBuffer.isView(data)) return new Uint8Array(data.buffer, data.byteOffset, data.byteLength);
+    return null;
+};
+
+const scramble = (input, output) => {
+    const keyLength = KEY.length;
+    for (let i = 0; i < input.length; i++) {
+        output[i] = input[i] ^ KEY[i % keyLength];
+    }
+};
+
+/**
+ * @param {ArrayBuffer|ArrayBufferView} data Any project data
+ * @returns {boolean} true if the data is a Stick Lab .sl file
+ */
+const isStickLabProject = data => {
+    const bytes = toUint8Array(data);
+    if (!bytes || bytes.length < HEADER_LENGTH) return false;
+    for (let i = 0; i < MAGIC.length; i++) {
+        if (bytes[i] !== MAGIC[i]) return false;
+    }
+    return true;
+};
+
+/**
+ * @param {ArrayBuffer|ArrayBufferView} data Contents of a .sl file
+ * @returns {ArrayBuffer} The .sb3 zip inside it
+ */
+const decodeStickLabProject = data => {
+    const bytes = toUint8Array(data);
+    const version = bytes[MAGIC.length];
+    if (version !== VERSION) {
+        throw new Error(`This .sl file was made by a newer version of Stick Lab (format ${version}). Please update Stick Lab.`);
+    }
+    const body = bytes.subarray(HEADER_LENGTH);
+    const out = new Uint8Array(body.length);
+    scramble(body, out);
+    return out.buffer;
+};
+
+/**
+ * @param {ArrayBuffer|ArrayBufferView} sb3 A .sb3 zip
+ * @returns {Uint8Array} Contents of a .sl file
+ */
+const encodeStickLabProject = sb3 => {
+    const bytes = toUint8Array(sb3);
+    const out = new Uint8Array(HEADER_LENGTH + bytes.length);
+    out.set(MAGIC, 0);
+    out[MAGIC.length] = VERSION;
+    scramble(bytes, out.subarray(HEADER_LENGTH));
+    return out;
+};
+
+/**
+ * @param {Blob} sb3Blob A .sb3 project as a Blob
+ * @returns {Promise<Blob>} The same project as a .sl Blob
+ */
+const sb3BlobToStickLabBlob = async sb3Blob => {
+    const buffer = await sb3Blob.arrayBuffer();
+    return new Blob([encodeStickLabProject(buffer)], {type: SL_MIME});
+};
+
+/**
+ * Make every VM accept .sl data in loadProject().
+ * @param {Function} VirtualMachine The scratch-vm class
+ */
+const installStickLabLoader = VirtualMachine => {
+    const proto = VirtualMachine.prototype;
+    if (proto.__stickLabPatched) return;
+    const originalLoadProject = proto.loadProject;
+    proto.loadProject = function (input) {
+        if (isStickLabProject(input)) {
+            try {
+                input = decodeStickLabProject(input);
+            } catch (e) {
+                return Promise.reject(e);
+            }
+        }
+        return originalLoadProject.call(this, input);
+    };
+    proto.__stickLabPatched = true;
+};
+
+export {
+    SL_EXTENSION,
+    SL_MIME,
+    isStickLabProject,
+    decodeStickLabProject,
+    encodeStickLabProject,
+    sb3BlobToStickLabBlob,
+    installStickLabLoader
+};
