+    addFrame (fromKey) {
+        const {frames, current} = this.state;
+        if (frames.length >= MAX_FRAMES) {
+            this.setState({message: `An animation can have up to ${MAX_FRAMES} frames.`});
+            return;
+        }
+        const key = nextKey++;
+        const canvas = makeCanvas();
+        if (fromKey) canvas.getContext('2d').drawImage(this.canvases.get(fromKey), 0, 0);
+        this.canvases.set(key, canvas);
+        // stickmen carry on into new frames, in the same pose
+        const here = frames[current] && this.copyPoses(frames[current].key);
+        if (here) this.poses.set(key, here);
+        const frame = {key, name: null, source: null, dirty: true, thumb: null};
+        frame.thumb = this.makeThumb(key);
+        const next = frames.slice();
+        next.splice(current + 1, 0, frame);
+        this.setState({frames: next, current: current + 1, message: null});
+    }
+
+    insertKeyframe () {
+        const frame = this.currentFrame();
+        this.addFrame(frame ? frame.key : null);
+    }
+
+    insertBlank () {
+        this.addFrame(null);
+    }
+
+    deleteFrame () {
+        const {frames, current} = this.state;
+        if (frames.length <= 1) {
+            this.setState({message: 'A sprite needs at least one frame.'});
+            return;
+        }
+        const next = frames.slice();
+        next.splice(current, 1);
+        this.setState({frames: next, current: Math.min(current, next.length - 1), message: null});
+    }
+
+    moveFrame (delta) {
+        const {frames, current} = this.state;
+        const to = current + delta;
+        if (to < 0 || to >= frames.length) return;
+        const next = frames.slice();
+        const [f] = next.splice(current, 1);
+        next.splice(to, 0, f);
+        this.setState({frames: next, current: to});
+    }
+
+    goTo (index) {
+        const {frames} = this.state;
+        if (!frames.length) return;
+        const i = ((index % frames.length) + frames.length) % frames.length;
+        this.setState({current: i});
+    }
+
+    centroid (key) {
+        const small = makeCanvas(W / 4, H / 4);
+        const sctx = small.getContext('2d');
+        sctx.drawImage(this.canvases.get(key), 0, 0, W / 4, H / 4);
+        const d = sctx.getImageData(0, 0, W / 4, H / 4).data;
+        let sx = 0;
+        let sy = 0;
+        let n = 0;
+        for (let y = 0; y < H / 4; y++) {
+            for (let x = 0; x < W / 4; x++) {
+                const a = d[(((y * W) / 4) + x) * 4 + 3];
+                if (a > 20) {
+                    sx += x;
+                    sy += y;
+                    n++;
+                }
+            }
+        }
+        return n ? {x: (sx / n) * 4, y: (sy / n) * 4} : null;
+    }
+
+    /** Flash-style tween: fill in frames between this frame and the next one. */
+    tween () {
+        const {frames, current, tweenCount} = this.state;
+        const a = frames[current];
+        const b = frames[current + 1];
+        if (!a || !b) {
+            this.setState({message: 'Select the first of two frames to tween between.'});
+            return;
+        }
+        const count = Math.max(1, Math.min(30, tweenCount | 0));
+        if (frames.length + count > MAX_FRAMES) {
+            this.setState({message: `An animation can have up to ${MAX_FRAMES} frames.`});
+            return;
+        }
+        const ca = this.centroid(a.key);
+        const cb = this.centroid(b.key);
+        const dx = ca && cb ? cb.x - ca.x : 0;
+        const dy = ca && cb ? cb.y - ca.y : 0;
+        const srcA = this.canvases.get(a.key);
+        const srcB = this.canvases.get(b.key);
+        const made = [];
+        for (let i = 1; i <= count; i++) {
+            const t = i / (count + 1);
+            const key = nextKey++;
+            const canvas = makeCanvas();
+            const ctx = canvas.getContext('2d');
+            ctx.globalAlpha = 1 - t;
+            ctx.drawImage(srcA, dx * t, dy * t);
+            ctx.globalAlpha = t;
+            ctx.drawImage(srcB, -dx * (1 - t), -dy * (1 - t));
+            ctx.globalAlpha = 1;
+            this.canvases.set(key, canvas);
+            const pa = this.poses.get(a.key);
+            const pb = this.poses.get(b.key);
+            if (pa) {
+                const poses = new Map();
+                for (const [id, poseA] of pa) {
+                    const poseB = pb && pb.get(id);
+                    poses.set(id, poseB ? Rig.lerpPose(poseA, poseB, t) : Rig.clonePose(poseA));
+                }
+                this.poses.set(key, poses);
+            }
+            made.push({key, name: null, source: null, dirty: true, thumb: this.makeThumb(key)});
+        }
+        const next = frames.slice();
+        next.splice(current + 1, 0, ...made);
+        this.setState({frames: next, message: `Added ${count} tween frame${count === 1 ? '' : 's'}.`});
+    }
+
+    // ------------------------------------------------------------------ stickmen
+
+    markAllDirty () {
+        const frames = this.state.frames.map(f => ({...f, dirty: true, thumb: this.makeThumb(f.key)}));
+        this.setState(st => ({frames, rigVersion: st.rigVersion + 1}));
+    }
+
+    addStickman () {
+        const {frames, current} = this.state;
+        if (!frames.length) return;
+        const offset = (this.rigs.length % 4) * 70;
+        const {rig, pose} = Rig.makeRig(CX - 120 + offset * 2, CY + 110, {color: this.state.color});
+        this.rigs.push(rig);
+        for (const f of frames) {
+            if (!this.poses.has(f.key)) this.poses.set(f.key, new Map());
+            this.poses.get(f.key).set(rig.id, Rig.clonePose(pose));
+        }
+        this.setState({selectedRig: rig.id, tool: 'stick',
+            message: 'Drag the red dots to pose. Drag the orange dot to move. New frames keep the pose.'},
+        () => this.markAllDirty());
+        void current;
+    }
+
+    selected () {
+        return this.rigs.find(r => r.id === this.state.selectedRig) || null;
+    }
+
+    deleteStickman () {
+        const rig = this.selected();
+        if (!rig) return;
+        this.rigs = this.rigs.filter(r => r !== rig);
+        for (const poses of this.poses.values()) poses.delete(rig.id);
+        this.setState({selectedRig: null}, () => this.markAllDirty());
+    }
+
+    flipStickman () {
+        const rig = this.selected();
+        const frame = this.currentFrame();
+        if (!rig || !frame) return;
+        const poses = this.poses.get(frame.key);
+        if (!poses || !poses.get(rig.id)) return;
+        this.pushUndo(frame.key, true);
+        poses.set(rig.id, Rig.mirrorPose(poses.get(rig.id)));
+        this.markDirty(frame.key);
+        this.setState(st => ({rigVersion: st.rigVersion + 1}));
+    }
+
+    toggleSword () {
+        const rig = this.selected();
+        if (!rig) return;
+        rig.sword = !rig.sword;
+        this.markAllDirty();
+    }
+
+    recolorStickman () {
+        const rig = this.selected();
