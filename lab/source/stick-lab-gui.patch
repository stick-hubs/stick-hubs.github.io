+            this.renderView({move: true, dx: p.x - d.x0, dy: p.y - d.y0});
+        } else {
+            this.renderView({shape: {tool: d.tool, x0: d.x0, y0: d.y0, x1: p.x, y1: p.y, color, size, filled}});
+        }
+    }
+
+    handlePointerUp () {
+        const d = this.drag;
+        if (!d) return;
+        this.drag = null;
+        const canvas = this.canvases.get(d.key);
+        const ctx = canvas.getContext('2d');
+        const {color, size, filled} = this.state;
+        if (d.tool === 'move') {
+            const copy = makeCanvas();
+            copy.getContext('2d').drawImage(canvas, 0, 0);
+            ctx.clearRect(0, 0, W, H);
+            ctx.drawImage(copy, d.x1 - d.x0, d.y1 - d.y0);
+        } else if (d.tool === 'line' || d.tool === 'rect' || d.tool === 'ellipse') {
+            this.drawShape(ctx, {tool: d.tool, x0: d.x0, y0: d.y0, x1: d.x1, y1: d.y1, color, size, filled});
+        }
+        this.markDirty(d.key);
+        this.renderView();
+    }
+
+    // ------------------------------------------------------------------ frames
