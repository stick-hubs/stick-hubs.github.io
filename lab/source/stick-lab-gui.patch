+// Stick Lab Text coding -> blocks
+import {ALIASES, BINARY_OPERATORS} from './aliases';
+import {parse, scriptKey, TextCodeError} from './parser';
+import {workspaceToText, describeBlock, variableTypeOf, isVariableField} from './printer';
+
+const STOP_OTHER_OPTIONS = new Set(['other scripts in sprite', 'other scripts in stage']);
+
+const createEl = (tag, attrs, text) => {
+    const el = document.createElement(tag);
+    if (attrs) {
+        for (const [k, v] of Object.entries(attrs)) {
+            if (v !== null && typeof v !== 'undefined') el.setAttribute(k, v);
+        }
+    }
+    if (typeof text !== 'undefined') el.textContent = text;
+    return el;
+};
+
+// ---- information about blocks -------------------------------------------------------------
+
+const blockInfoCache = new Map();
+const getBlockInfo = (ScratchBlocks, opcode) => {
+    if (blockInfoCache.has(opcode)) return blockInfoCache.get(opcode);
+    let info = null;
+    if (ScratchBlocks.Blocks[opcode] && !opcode.startsWith('procedures_') && !opcode.startsWith('argument_')) {
+        const ws = new ScratchBlocks.Workspace();
+        try {
+            const block = ws.newBlock(opcode);
+            const {args, statements} = describeBlock(block, ScratchBlocks);
+            info = {
+                opcode,
+                args: args.map(arg => {
+                    if (arg.kind === 'field') {
+                        return {
+                            kind: 'field',
+                            name: arg.name,
+                            variableType: isVariableField(arg.field, ScratchBlocks) ? variableTypeOf(arg.field) : null
+                        };
+                    }
+                    const check = arg.input.connection && arg.input.connection.check_;
+                    return {kind: 'value', name: arg.name, boolean: !!(check && check.indexOf('Boolean') !== -1)};
+                }),
+                statements: statements.map(s => s.name),
+                isReporter: !!block.outputConnection,
+                isHat: !block.outputConnection && !block.previousConnection,
+                isStatement: !!block.previousConnection
+            };
+        } catch (e) {
+            info = null;
+        } finally {
+            ws.dispose();
+        }
+    }
+    blockInfoCache.set(opcode, info);
+    return info;
+};
+
+const describeArgs = info => info.args.map(a => a.name.toLowerCase()).join(', ');
+
+// ---- default inputs from the block palette -------------------------------------------------
+
+const parseToolbox = toolboxXML => {
+    const map = new Map();
+    if (!toolboxXML) return map;
+    const doc = new DOMParser().parseFromString(toolboxXML, 'text/xml');
+    const walk = el => {
+        for (const child of Array.from(el.children)) {
+            if (child.tagName.toLowerCase() === 'block') {
+                const type = child.getAttribute('type');
+                if (type && !map.has(type)) map.set(type, child);
+            } else {
+                walk(child);
+            }
+        }
+    };
+    walk(doc.documentElement);
+    return map;
+};
+
+const importIntoDocument = el => {
+    // Convert an XML-document element into an HTML-document element tree Blockly accepts.
+    const out = document.createElement(el.tagName);
+    for (const attr of Array.from(el.attributes)) out.setAttribute(attr.name, attr.value);
+    for (const child of Array.from(el.childNodes)) {
+        if (child.nodeType === 1) out.appendChild(importIntoDocument(child));
+        else if (child.nodeType === 3) out.appendChild(document.createTextNode(child.nodeValue));
+    }
+    return out;
+};
+
+// ---- build Blockly XML from the syntax tree -------------------------------------------------
+
+class Builder {
+    constructor ({ScratchBlocks, workspace, isStage, toolbox, procedures}) {
+        this.ScratchBlocks = ScratchBlocks;
+        this.workspace = workspace;
+        this.isStage = isStage;
+        this.toolbox = toolbox;
+        this.procedures = procedures;
+        this.newVariables = new Map(); // key -> {name, type, id}
+        this.params = null;
+    }
+
+    error (message, node) {
+        return new TextCodeError(message, node && node.line);
+    }
+
+    resolve (name, node) {
+        const opcode = ALIASES[name] || name;
+        const info = getBlockInfo(this.ScratchBlocks, opcode);
+        if (!info) {
+            if (name === 'else') throw this.error('"else" must come right after the } of an if', node);
+            throw this.error(`Unknown command "${name}". Check the spelling, or pick it from the Commands list`, node);
+        }
+        return info;
+    }
+
+    variableId (name, type) {
+        const existing = this.workspace.getVariable(name, type);
+        if (existing) return existing.getId();
+        const key = `${type}:${name}`;
+        if (!this.newVariables.has(key)) {
+            this.newVariables.set(key, {name, type, id: this.ScratchBlocks.utils.genUid()});
+        }
+        return this.newVariables.get(key).id;
+    }
+
+    defaultShadow (opcode, inputName) {
+        const blockEl = this.toolbox.get(opcode);
+        if (!blockEl) return null;
+        for (const child of Array.from(blockEl.children)) {
+            if (child.tagName.toLowerCase() === 'value' && child.getAttribute('name') === inputName) {
+                const shadow = Array.from(child.children).find(c => c.tagName.toLowerCase() === 'shadow');
+                return shadow ? importIntoDocument(shadow) : null;
+            }
+        }
+        return null;
+    }
+
+    fieldEl (spec, node, opcode) {
+        if (spec.variableType === '' || spec.variableType === 'list') {
+            const want = spec.variableType === 'list' ? 'list' : 'variable';
+            if (node.type !== want) {
+                const example = want === 'list' ? '@my_list' : '$score';
+                throw this.error(`${opcode} needs a ${want} here, written like ${example}`, node);
+            }
+            return createEl('field', {
+                name: spec.name,
+                id: this.variableId(node.name, spec.variableType),
+                variabletype: spec.variableType
+            }, node.name);
+        }
+        if (node.type !== 'literal') {
+            throw this.error(`This part of ${opcode} must be written in quotes, like "${spec.name.toLowerCase()}"`, node);
+        }
+        if (spec.variableType === 'broadcast_msg') {
+            return createEl('field', {
+                name: spec.name,
+                id: this.variableId(node.value, 'broadcast_msg'),
+                variabletype: 'broadcast_msg'
+            }, node.value);
+        }
+        return createEl('field', {name: spec.name}, node.value);
+    }
+
+    setShadowValue (shadow, value) {
+        let field = Array.from(shadow.children).find(c => c.tagName.toLowerCase() === 'field');
+        if (!field) {
+            // Menus like touching(...) have no default in the palette; find the menu's field name.
+            const info = getBlockInfo(this.ScratchBlocks, shadow.getAttribute('type'));
+            const spec = info && info.args.find(a => a.kind === 'field');
+            if (!spec) return;
+            field = createEl('field', {name: spec.name});
+            if (spec.variableType !== null && typeof spec.variableType !== 'undefined') {
+                field.setAttribute('variabletype', spec.variableType);
+            }
+            shadow.appendChild(field);
+        }
+        const isBroadcast = field.getAttribute('variabletype') === 'broadcast_msg' ||
+            shadow.getAttribute('type') === 'event_broadcast_menu';
+        if (isBroadcast) {
+            field.setAttribute('id', this.variableId(value, 'broadcast_msg'));
+            field.setAttribute('variabletype', 'broadcast_msg');
+        }
+        field.textContent = value;
+    }
+
+    valueEl (inputName, isBoolean, node, opcode) {
+        const value = createEl('value', {name: inputName});
+        let shadow = isBoolean ? null : this.defaultShadow(opcode, inputName);
+        if (node.type === 'empty') {
+            if (!shadow) return null;
+            value.appendChild(shadow);
+            return value;
+        }
+        if (node.type === 'literal') {
+            if (isBoolean) {
+                throw this.error(`${opcode} needs a true/false block here, like touching("_mouse_") or $x > 10`, node);
+            }
+            if (!shadow) {
+                shadow = node.isNumber ?
+                    createEl('shadow', {type: 'math_number'}) :
+                    createEl('shadow', {type: 'text'});
+                shadow.appendChild(createEl('field', {name: node.isNumber ? 'NUM' : 'TEXT'}));
+            }
+            this.setShadowValue(shadow, node.value);
+            value.appendChild(shadow);
+            return value;
+        }
+        if (shadow) value.appendChild(shadow);
+        value.appendChild(this.exprEl(node));
+        return value;
+    }
+
+    exprEl (node) {
+        switch (node.type) {
+        case 'binary': {
+            const op = BINARY_OPERATORS[node.opcode];
+            const isLogic = node.opcode === 'operator_and' || node.opcode === 'operator_or';
+            const block = createEl('block', {type: node.opcode});
+            [node.left, node.right].forEach((child, i) => {
+                const v = this.valueEl(op.inputs[i], isLogic, child, node.opcode);
+                if (v) block.appendChild(v);
+            });
+            return block;
+        }
+        case 'not': {
+            const block = createEl('block', {type: 'operator_not'});
+            const v = this.valueEl('OPERAND', true, node.operand, 'not');
+            if (v) block.appendChild(v);
+            return block;
+        }
+        case 'variable': {
+            const block = createEl('block', {type: 'data_variable'});
+            block.appendChild(createEl('field', {
+                name: 'VARIABLE', id: this.variableId(node.name, ''), variabletype: ''
+            }, node.name));
+            return block;
+        }
+        case 'list': {
+            const block = createEl('block', {type: 'data_listcontents'});
+            block.appendChild(createEl('field', {
+                name: 'LIST', id: this.variableId(node.name, 'list'), variabletype: 'list'
+            }, node.name));
+            return block;
+        }
+        case 'argument': {
+            const isBool = this.params && this.params.get(node.name) === 'b';
+            if (this.params && !this.params.has(node.name)) {
+                throw this.error(`%${node.name} isn't an input of this custom block`, node);
+            }
+            const block = createEl('block', {
+                type: isBool ? 'argument_reporter_boolean' : 'argument_reporter_string_number'
+            });
+            block.appendChild(createEl('field', {name: 'VALUE'}, node.name));
+            return block;
+        }
+        case 'call': {
+            const info = this.resolve(node.name, node);
+            if (!info.isReporter) {
+                throw this.error(`"${node.name}" is a command, so it can't be used as a value`, node);
+            }
+            return this.blockWithArgs(info, node.name, node.args, node);
+        }
+        case 'literal':
+        case 'empty':
+            throw this.error('A value can only go inside a block here', node);
+        default:
+            throw this.error('Unexpected code', node);
+        }
+    }
+
+    blockWithArgs (info, name, args, node) {
+        if (args.length !== info.args.length) {
+            const want = info.args.length;
+            throw this.error(
+                want ?
+                    `${name} needs ${want} value${want === 1 ? '' : 's'}: ${name}(${describeArgs(info)})` :
+                    `${name} doesn't take any values: just write ${name}`,
+                node
+            );
+        }
+        const block = createEl('block', {type: info.opcode});
+        info.args.forEach((spec, i) => {
+            if (spec.kind === 'field') {
+                block.appendChild(this.fieldEl(spec, args[i], name));
+            } else {
+                const v = this.valueEl(spec.name, spec.boolean, args[i], info.opcode);
+                if (v) block.appendChild(v);
+            }
+        });
+        if (info.opcode === 'control_stop') {
+            const option = args[0] && args[0].type === 'literal' ? args[0].value : '';
+            block.insertBefore(createEl('mutation', {
+                hasnext: STOP_OTHER_OPTIONS.has(option) ? 'true' : 'false'
+            }), block.firstChild);
+        }
+        return block;
+    }
+
+    commandEl (node) {
+        if (node.type === 'callProcedure') return this.procedureCallEl(node);
+        let name = node.name;
+        if (name === 'if' && node.bodies.length === 2) name = 'if_else';
+        const info = this.resolve(name, node);
+        if (info.isHat) {
+            throw this.error(`"${node.name}" starts a script, so it can't go inside another script`, node);
+        }
+        if (!info.isStatement) {
+            throw this.error(`"${node.name}" is a value, not a command. Use it inside another block, like say(${node.name})`, node);
+        }
+        if (node.bodies.length > info.statements.length) {
+            throw this.error(
+                info.statements.length ? `${name} has only ${info.statements.length} { } part` :
+                    `${name} doesn't take a { } part`,
+                node
+            );
+        }
+        if (info.statements.length && !node.bodies.length) {
+            throw this.error(`${name} needs a { } part with commands inside`, node);
+        }
+        const block = this.blockWithArgs(info, node.name, node.args, node);
+        node.bodies.forEach((body, i) => {
+            const first = this.chainEl(body);
+            if (first) {
+                const statement = createEl('statement', {name: info.statements[i]});
+                statement.appendChild(first);
+                block.appendChild(statement);
+            }
+        });
+        return block;
+    }
+
+    procedureCallEl (node) {
+        const proc = this.procedures.get(node.proccode);
+        if (!proc) {
+            throw this.error(`There's no custom block called "${node.proccode}". Make it with define "${node.proccode}" (...) { }`, node);
+        }
+        if (node.args.length !== proc.ids.length) {
+            throw this.error(`"${node.proccode}" needs ${proc.ids.length} value${proc.ids.length === 1 ? '' : 's'}`, node);
+        }
+        const block = createEl('block', {type: 'procedures_call'});
+        block.appendChild(createEl('mutation', {
+            proccode: node.proccode,
+            argumentids: JSON.stringify(proc.ids),
+            warp: proc.warp ? 'true' : 'false'
+        }));
+        proc.ids.forEach((id, i) => {
+            const arg = node.args[i];
+            const isBool = proc.types[i] === 'b';
+            const value = createEl('value', {name: id});
+            if (isBool) {
+                if (arg.type === 'empty') return;
+                if (arg.type === 'literal') {
+                    throw this.error(`Input ${i + 1} of "${node.proccode}" needs a true/false block`, arg);
+                }
+                value.appendChild(this.exprEl(arg));
+            } else {
+                const shadow = createEl('shadow', {type: 'text'});
+                shadow.appendChild(createEl('field', {name: 'TEXT'}, arg.type === 'literal' ? arg.value : ''));
+                value.appendChild(shadow);
+                if (arg.type !== 'literal' && arg.type !== 'empty') value.appendChild(this.exprEl(arg));
+            }
+            block.appendChild(value);
+        });
+        return block;
+    }
+
+    chainEl (statements) {
+        let first = null;
+        let last = null;
+        for (const statement of statements) {
+            const el = this.commandEl(statement);
+            if (last) {
+                const next = createEl('next');
+                next.appendChild(el);
+                last.appendChild(next);
+            } else {
+                first = el;
+            }
+            last = el;
+        }
+        return first;
+    }
+
+    appendBody (block, body) {
+        const first = this.chainEl(body);
+        if (first) {
+            const next = createEl('next');
+            next.appendChild(first);
+            block.appendChild(next);
+        }
+        return block;
+    }
+
+    scriptEl (script) {
+        if (script.type === 'stack') {
+            if (!script.body.length) throw this.error('stack { } is empty', script);
+            return this.chainEl(script.body);
+        }
+        if (script.type === 'define') {
+            const proc = this.procedures.get(script.proccode);
+            const block = createEl('block', {type: 'procedures_definition'});
+            const value = createEl('value', {name: 'custom_block'});
+            const prototype = createEl('shadow', {type: 'procedures_prototype'});
+            prototype.appendChild(createEl('mutation', {
+                proccode: script.proccode,
+                argumentids: JSON.stringify(proc.ids),
+                argumentnames: JSON.stringify(script.params),
+                argumentdefaults: JSON.stringify(proc.types.map(t => (t === 'b' ? 'false' : ''))),
+                warp: script.warp ? 'true' : 'false'
+            }));
+            proc.ids.forEach((id, i) => {
+                const v = createEl('value', {name: id});
+                const reporter = createEl('shadow', {
+                    type: proc.types[i] === 'b' ? 'argument_reporter_boolean' : 'argument_reporter_string_number'
+                });
+                reporter.appendChild(createEl('field', {name: 'VALUE'}, script.params[i]));
+                v.appendChild(reporter);
+                prototype.appendChild(v);
+            });
+            value.appendChild(prototype);
+            block.appendChild(value);
+            this.params = new Map(script.params.map((p, i) => [p, proc.types[i]]));
+            try {
+                return this.appendBody(block, script.body);
+            } finally {
+                this.params = null;
+            }
+        }
+        // hat
+        const info = this.resolve(script.name, script);
+        if (!info.isHat) {
+            throw this.error(
+                `"${script.name}" can't start a script. Start with a "when" block like when_flag_clicked, or use stack { }`,
+                script
+            );
+        }
+        return this.appendBody(this.blockWithArgs(info, script.name, script.args, script), script.body);
+    }
+}
+
+// ---- custom blocks --------------------------------------------------------------------------
+
+const placeholderTypes = proccode => (proccode.match(/%[snb]/g) || []).map(p => p[1]);
+
+const existingProcedures = workspace => {
+    const map = new Map();
+    for (const top of workspace.getTopBlocks(false)) {
+        if (top.type !== 'procedures_definition') continue;
+        const prototype = top.getInputTargetBlock('custom_block');
+        if (!prototype) continue;
+        const m = prototype.mutationToDom();
+        const proccode = m.getAttribute('proccode');
+        map.set(proccode, {
+            topId: top.id,
+            ids: JSON.parse(m.getAttribute('argumentids') || '[]'),
+            names: JSON.parse(m.getAttribute('argumentnames') || '[]'),
+            types: placeholderTypes(proccode),
+            warp: m.getAttribute('warp') === 'true'
+        });
+    }
+    return map;
+};
+
+// ---- main entry ------------------------------------------------------------------------------
+
+/**
+ * Replace the scripts in the workspace with the scripts written in text.
+ * Scripts that didn't change keep their blocks, position and comments.
+ * @returns {{changed: boolean, created: number, removed: number}} what happened
+ */
+const applyText = (text, {ScratchBlocks, workspace, vm, toolboxXML}) => {
+    const scripts = parse(text);
+    const current = workspaceToText(workspace, ScratchBlocks).scripts;
+
+    const oldByKey = new Map();
+    const lockedIds = new Set();
+    for (const s of current) {
+        if (s.locked) {
+            lockedIds.add(s.id);
+            continue;
+        }
+        const key = scriptKey(s.text);
+        if (!oldByKey.has(key)) oldByKey.set(key, []);
+        oldByKey.get(key).push(s.id);
+    }
+
+    const keepIds = new Set();
+    const toCreate = [];
+    for (const script of scripts) {
+        if (script.type === 'locked') {
+            if (!lockedIds.has(script.id)) {
+                throw new TextCodeError('This locked_script line doesn\'t match a script any more. Delete the line', script.line);
+            }
+            keepIds.add(script.id);
+            continue;
+        }
+        const ids = oldByKey.get(script.tokenKey);
+        if (ids && ids.length) keepIds.add(ids.shift());
+        else toCreate.push(script);
+    }
+
+    // Custom blocks: kept definitions keep their ids; new or edited ones reuse ids when they still fit.
+    const oldProcs = existingProcedures(workspace);
+    const procedures = new Map();
+    for (const [proccode, proc] of oldProcs) {
+        if (keepIds.has(proc.topId)) procedures.set(proccode, proc);
+    }
+    for (const script of scripts) {
+        if (script.type !== 'define') continue;
+        const types = placeholderTypes(script.proccode);
+        if (types.length !== script.params.length) {
+            throw new TextCodeError(
+                `"${script.proccode}" has ${types.length} input slot${types.length === 1 ? '' : 's'} (%s, %n or %b) ` +
+                `but ${script.params.length} input name${script.params.length === 1 ? '' : 's'}`,
+                script.line
+            );
+        }
+        if (procedures.has(script.proccode) && !toCreate.includes(script)) continue;
+        if (procedures.has(script.proccode)) {
+            throw new TextCodeError(`There are two custom blocks called "${script.proccode}"`, script.line);
+        }
+        const old = oldProcs.get(script.proccode);
+        const ids = old && old.ids.length === types.length ?
+            old.ids :
+            types.map(() => ScratchBlocks.utils.genUid());
+        procedures.set(script.proccode, {ids, types, warp: script.warp});
+    }
+
+    const builder = new Builder({
+        ScratchBlocks,
+        workspace,
+        isStage: !!(vm.editingTarget && vm.editingTarget.isStage),
+        toolbox: parseToolbox(toolboxXML),
+        procedures
+    });
+    // Build everything first, so a mistake anywhere changes nothing.
+    const built = toCreate.map(script => builder.scriptEl(script));
+
+    const toRemove = workspace.getTopBlocks(false).filter(b => !b.isShadow() && !keepIds.has(b.id));
+    if (!built.length && !toRemove.length) {
+        return {changed: false, created: 0, removed: 0};
+    }
+
+    ScratchBlocks.Events.setGroup(true);
+    try {
+        for (const v of builder.newVariables.values()) {
+            const isLocal = v.type !== 'broadcast_msg' && !builder.isStage;
+            workspace.createVariable(v.name, v.type, v.id, isLocal, false);
+        }
+        for (const block of toRemove) block.dispose(false);
+        for (const el of built) ScratchBlocks.Xml.domToBlock(el, workspace);
+    } finally {
+        ScratchBlocks.Events.setGroup(false);
+    }
+    if (built.length) workspace.cleanUp();
+    return {changed: true, created: built.length, removed: toRemove.length};
+};
+
+const shadowDefault = (ScratchBlocks, shadowType, ownerType, fieldName) => {
+    const ws = new ScratchBlocks.Workspace();
+    try {
+        if (shadowType) {
+            const block = ws.newBlock(shadowType);
+            const f = block.inputList.flatMap(i => i.fieldRow).find(x => x.name && x.getValue);
+            return f ? String(f.getValue()) : '';
+        }
+        if (ownerType) {
+            const block = ws.newBlock(ownerType);
+            const f = block.getField(fieldName);
+            return f ? String(f.getValue()) : '';
+        }
+    } catch (e) {
+        return '';
+    } finally {
+        ws.dispose();
+    }
+    return '';
+};
+
+/**
+ * Short examples for the Commands list, made from the block palette.
+ * @returns {Array<{category: string, color: string, items: Array<{label: string, insert: string}>}>} groups
+ */
+const commandList = (ScratchBlocks, toolboxXML, aliases = ALIASES) => {
+    const opcodeToAlias = {};
+    for (const [alias, opcode] of Object.entries(aliases)) {
+        if (!opcodeToAlias[opcode]) opcodeToAlias[opcode] = alias;
+    }
+    const groups = [];
+    if (!toolboxXML) return groups;
+    const doc = new DOMParser().parseFromString(toolboxXML, 'text/xml');
+    for (const category of Array.from(doc.getElementsByTagName('category'))) {
+        const items = [];
+        for (const el of Array.from(category.children)) {
+            if (el.tagName.toLowerCase() !== 'block') continue;
+            const opcode = el.getAttribute('type');
+            if (!opcode || BINARY_OPERATORS[opcode] || opcode === 'operator_not' ||
+                opcode.startsWith('procedures_') || opcode.startsWith('argument_')) continue;
+            if (opcode === 'data_variable' || opcode === 'data_listcontents') continue;
+            const info = getBlockInfo(ScratchBlocks, opcode);
+            if (!info) continue;
+            const name = opcodeToAlias[opcode] || opcode;
+            const argText = info.args.map(spec => {
+                if (spec.variableType === '') return '$my_variable';
+                if (spec.variableType === 'list') return '@my_list';
+                const holder = Array.from(el.children).find(c => c.getAttribute('name') === spec.name);
+                const field = holder && (holder.tagName.toLowerCase() === 'field' ? holder : holder.getElementsByTagName('field')[0]);
+                let value = field ? field.textContent : '';
+                if (!field) {
+                    const shadow = holder && holder.getElementsByTagName('shadow')[0];
+                    value = shadowDefault(ScratchBlocks, shadow ? shadow.getAttribute('type') : null, spec.kind === 'field' ? opcode : null, spec.name);
+                }
+                if (spec.boolean) return '_';
+                return /^-?\d+(\.\d+)?$/.test(value) ? value : JSON.stringify(value);
+            });
+            let call = argText.length ? `${name}(${argText.join(', ')})` : name;
+            if (info.isHat) call += ' {\n    \n}';
+            else if (info.statements.length === 2) call = `if (${argText.join(', ')}) {\n    \n} else {\n    \n}`;
+            else if (info.statements.length) call += ' {\n    \n}';
+            items.push({label: call.split('\n')[0].replace(/ \{$/, ' { }'), insert: call, isHat: info.isHat});
+        }
+        if (items.length) {
+            const rawName = category.getAttribute('name') || '';
+            const categoryName = rawName.replace(/%\{BKY_([A-Z0-9_]+)\}/g, (m, key) => ScratchBlocks.Msg[key] || m);
+            groups.push({category: categoryName, color: category.getAttribute('colour'), items});
+        }
+    }
+    return groups;
+};
+
+export {
+    applyText,
+    commandList,
+    TextCodeError
+};
diff --git a/src/lib/sl-text-code/parser.js b/src/lib/sl-text-code/parser.js
new file mode 100644
index 0000000..4a4e35e
--- /dev/null
+++ b/src/lib/sl-text-code/parser.js
@@ -0,0 +1,319 @@
+// Stick Lab Text coding -> syntax tree
+import {SYMBOL_TO_OPERATOR, NOT_PREC, BINARY_OPERATORS} from './aliases';
+
+class TextCodeError extends Error {
+    constructor (message, line) {
+        super(line ? `Line ${line}: ${message}` : message);
+        this.line = line;
+        this.plainMessage = message;
+    }
+}
+
+const IDENT_START = /[A-Za-z_]/;
+const IDENT_PART = /[A-Za-z0-9_]/;
+
+const tokenize = source => {
+    const tokens = [];
+    let i = 0;
+    let line = 1;
+    const push = (type, value, raw, start) => tokens.push({type, value, raw, line, start, end: i});
+    const readString = () => {
+        const start = i;
+        i++; // opening quote
+        let out = '';
+        while (i < source.length && source[i] !== '"') {
+            if (source[i] === '\n') throw new TextCodeError('Text in quotes must end on the same line (missing ")', line);
+            if (source[i] === '\\') {
+                const next = source[i + 1];
+                if (next === 'n') out += '\n';
+                else if (next === 't') out += '\t';
+                else if (next === 'u') {
+                    out += String.fromCharCode(parseInt(source.substr(i + 2, 4), 16));
+                    i += 4;
+                } else out += next;
+                i += 2;
+            } else {
+                out += source[i++];
+            }
+        }
+        if (source[i] !== '"') throw new TextCodeError('Missing closing " on this line', line);
+        i++;
+        return {value: out, raw: source.slice(start, i)};
+    };
+    const readIdent = () => {
+        const start = i;
+        while (i < source.length && IDENT_PART.test(source[i])) i++;
+        return source.slice(start, i);
+    };
+    while (i < source.length) {
+        const c = source[i];
+        const start = i;
+        if (c === '\n') {
+            line++;
+            i++;
+        } else if (c === ' ' || c === '\t' || c === '\r') {
+            i++;
+        } else if (c === '/' && source[i + 1] === '/') {
+            while (i < source.length && source[i] !== '\n') i++;
+        } else if (c === '/' && source[i + 1] === '*') {
+            const end = source.indexOf('*/', i + 2);
+            const stop = end === -1 ? source.length : end + 2;
+            for (let j = i; j < stop; j++) if (source[j] === '\n') line++;
+            i = stop;
+        } else if (c === '"') {
+            const s = readString();
+            push('string', s.value, s.raw, start);
+        } else if (/[0-9]/.test(c) || (c === '.' && /[0-9]/.test(source[i + 1] || ''))) {
+            const m = /^(\d+\.?\d*|\.\d+)(e[+-]?\d+)?/i.exec(source.slice(i));
+            i += m[0].length;
+            push('number', m[0], m[0], start);
+        } else if (c === '$' || c === '@' || c === '%') {
+            i++;
+            let name;
+            if (source[i] === '"') name = readString().value;
+            else if (IDENT_START.test(source[i] || '')) name = readIdent();
+            else throw new TextCodeError(`"${c}" must be followed by a name, like ${c}score`, line);
+            push(c === '$' ? 'variable' : c === '@' ? 'list' : 'argument', name, source.slice(start, i), start);
+        } else if (IDENT_START.test(c)) {
+            const word = readIdent();
+            push('ident', word, word, start);
+        } else if (c === '=' && source[i + 1] === '=') {
+            i += 2;
+            push('op', '==', '==', start);
+        } else if ('(){},;'.includes(c)) {
+            i++;
+            push('punct', c, c, start);
+        } else if ('+-*/<>'.includes(c)) {
+            i++;
+            push('op', c, c, start);
+        } else if (c === '=') {
+            throw new TextCodeError('Use == to compare. To set a variable use set_var($name, value)', line);
+        } else {
+            throw new TextCodeError(`Stick Lab doesn't understand the character "${c}"`, line);
+        }
+    }
+    tokens.push({type: 'eof', value: null, raw: '', line, start: source.length, end: source.length});
+    return tokens;
+};
+
+const parse = source => {
+    const tokens = tokenize(source);
+    let pos = 0;
+    const peek = (o = 0) => tokens[pos + o];
+    const next = () => tokens[pos++];
+    const is = (type, value) => peek().type === type && (value === undefined || peek().value === value);
+    const isWord = value => is('ident', value);
+    const expect = (type, value, what) => {
+        const t = peek();
+        if (t.type !== type || (value !== undefined && t.value !== value)) {
+            const found = t.type === 'eof' ? 'the end of the code' : `"${t.raw}"`;
+            throw new TextCodeError(`Expected ${what || `"${value}"`} but found ${found}`, t.line);
+        }
+        return next();
+    };
+
+    let parseExpr; // eslint-disable-line prefer-const
+
+    const parseArgs = () => {
+        const args = [];
+        expect('punct', '(');
+        if (!is('punct', ')')) {
+            args.push(parseExpr(0));
+            while (is('punct', ',')) {
+                next();
+                args.push(parseExpr(0));
+            }
+        }
+        expect('punct', ')', '")" or ","');
+        return args;
+    };
+
+    const parsePrimary = () => {
+        const t = peek();
+        if (t.type === 'number') {
+            next();
+            return {type: 'literal', value: t.value, isNumber: true, line: t.line};
+        }
+        if (t.type === 'string') {
+            next();
+            return {type: 'literal', value: t.value, isNumber: false, line: t.line};
+        }
+        if (t.type === 'variable' || t.type === 'list' || t.type === 'argument') {
+            next();
+            return {type: t.type, name: t.value, line: t.line};
+        }
+        if (t.type === 'op' && t.value === '-' && peek(1).type === 'number') {
+            next();
+            const n = next();
+            return {type: 'literal', value: `-${n.value}`, isNumber: true, line: t.line};
+        }
+        if (t.type === 'punct' && t.value === '(') {
+            next();
+            const e = parseExpr(0);
+            expect('punct', ')', '")"');
+            return e;
+        }
+        if (t.type === 'ident') {
+            if (t.value === '_') {
+                next();
+                return {type: 'empty', line: t.line};
+            }
+            if (t.value === 'not') {
+                next();
+                return {type: 'not', operand: parseExpr(NOT_PREC), line: t.line};
+            }
+            next();
+            const args = is('punct', '(') ? parseArgs() : [];
+            return {type: 'call', name: t.value, args, line: t.line};
+        }
+        const found = t.type === 'eof' ? 'the end of the code' : `"${t.raw}"`;
+        throw new TextCodeError(`Expected a value but found ${found}`, t.line);
+    };
+
+    const binaryInfo = t => {
+        let symbol = null;
+        if (t.type === 'op') symbol = t.value;
+        if (t.type === 'ident' && (t.value === 'and' || t.value === 'or' || t.value === 'mod')) symbol = t.value;
+        if (!symbol) return null;
+        const opcode = SYMBOL_TO_OPERATOR[symbol];
+        return opcode ? {opcode, prec: BINARY_OPERATORS[opcode].prec} : null;
+    };
+
+    parseExpr = minPrec => {
+        let left = parsePrimary();
+        for (;;) {
+            const info = binaryInfo(peek());
+            if (!info || info.prec < minPrec) break;
+            const t = next();
+            const right = parseExpr(info.prec + 1);
+            left = {type: 'binary', opcode: info.opcode, left, right, line: t.line};
+        }
+        return left;
+    };
+
+    let parseBody; // eslint-disable-line prefer-const
+
+    const parseStatement = () => {
+        const t = peek();
+        if (t.type === 'punct' && t.value === ';') {
+            next();
+            return null;
+        }
+        if (t.type !== 'ident') {
+            throw new TextCodeError(`A line should start with a command like move(10), not "${t.raw}"`, t.line);
+        }
+        if (t.value === 'call') {
+            next();
+            const proccode = expect('string', undefined, 'the custom block name in quotes, like call "jump %s" (10)');
+            const args = is('punct', '(') ? parseArgs() : [];
+            return {type: 'callProcedure', proccode: proccode.value, args, line: t.line};
+        }
+        if (t.value === 'else') throw new TextCodeError('"else" must come right after the } of an if', t.line);
+        next();
+        const args = is('punct', '(') ? parseArgs() : [];
+        const bodies = [];
+        if (is('punct', '{')) {
+            bodies.push(parseBody());
+            if (isWord('else')) {
+                next();
+                if (isWord('if')) {
+                    // else if (...) { } -> else { if (...) { } }
+                    bodies.push([parseStatement()]);
+                } else {
+                    bodies.push(parseBody());
+                }
+            }
+        }
+        return {type: 'command', name: t.value, args, bodies, line: t.line};
+    };
+
+    parseBody = () => {
+        expect('punct', '{', '"{"');
+        const statements = [];
+        while (!is('punct', '}')) {
+            if (is('eof')) throw new TextCodeError('Missing } at the end of a script', peek().line);
+            const s = parseStatement();
+            if (s) statements.push(s);
+        }
+        next();
+        return statements;
+    };
+
+    const scripts = [];
+    while (!is('eof')) {
+        const startToken = peek();
+        let script;
+        if (is('punct', ';')) {
+            next();
+            continue;
+        }
+        if (isWord('define')) {
+            next();
+            let warp = false;
+            if (isWord('warp')) {
+                next();
+                warp = true;
+            }
+            const proccode = expect('string', undefined, 'the custom block name in quotes, like define "jump %s" (%height)');
+            const params = [];
+            if (is('punct', '(')) {
+                next();
+                while (!is('punct', ')')) {
+                    const p = expect('argument', undefined, 'an input name like %height');
+                    params.push(p.value);
+                    if (is('punct', ',')) next();
+                    else break;
+                }
+                expect('punct', ')', '")"');
+            }
+            script = {type: 'define', proccode: proccode.value, params, warp, body: parseBody(), line: startToken.line};
+        } else if (isWord('stack')) {
+            next();
+            script = {type: 'stack', body: parseBody(), line: startToken.line};
+        } else if (isWord('locked_script')) {
+            next();
+            expect('punct', '(');
+            const id = expect('string', undefined, 'the locked script id in quotes');
+            expect('punct', ')', '")"');
+            script = {type: 'locked', id: id.value, line: startToken.line};
+        } else if (is('ident')) {
+            const name = next();
+            const args = is('punct', '(') ? parseArgs() : [];
+            if (!is('punct', '{')) {
+                throw new TextCodeError(
+                    `"${name.value}" is outside a script. Put commands inside a "when" block like when_flag_clicked { ... } or inside stack { ... }`,
+                    name.line
+                );
+            }
+            script = {type: 'hat', name: name.value, args, body: parseBody(), line: startToken.line};
+        } else {
+            throw new TextCodeError(`A script should start with a "when" block like when_flag_clicked {, not "${peek().raw}"`, peek().line);
+        }
+        const endToken = tokens[pos - 1];
+        script.tokenKey = tokens.slice(tokens.indexOf(startToken), pos).map(tk => `${tk.type}:${tk.value}`)
+            .join(' ');
+        script.endLine = endToken.line;
+        scripts.push(script);
+    }
+    return scripts;
+};
+
+/**
+ * A whitespace- and comment-insensitive key for a piece of code, used to tell if a script changed.
+ * @param {string} source Code for one script
+ * @returns {string} key
+ */
+const scriptKey = source => {
+    try {
+        const tokens = tokenize(source);
+        return tokens.filter(t => t.type !== 'eof').map(t => `${t.type}:${t.value}`).join(' ');
+    } catch (e) {
+        return null;
+    }
+};
+
+export {
+    parse,
+    scriptKey,
+    TextCodeError
+};
diff --git a/src/lib/sl-text-code/printer.js b/src/lib/sl-text-code/printer.js
new file mode 100644
index 0000000..614e8f2
--- /dev/null
+++ b/src/lib/sl-text-code/printer.js
@@ -0,0 +1,247 @@
+// Blocks -> Stick Lab Text coding
+import {OPCODE_TO_ALIAS, BINARY_OPERATORS, NOT_PREC} from './aliases';
+
+const INDENT = '    ';
+const IDENT_RE = /^[A-Za-z_][A-Za-z0-9_]*$/;
+const NUMBER_RE = /^-?(\d+\.?\d*|\.\d+)(e[+-]?\d+)?$/i;
+const NUMBER_SHADOWS = new Set([
+    'math_number', 'math_integer', 'math_whole_number', 'math_positive_number', 'math_angle'
+]);
+
+class Unsupported extends Error {}
+
+const quote = s => JSON.stringify(String(s));
+const nameToken = (prefix, name) => prefix + (IDENT_RE.test(name) ? name : quote(name));
+const blockName = opcode => OPCODE_TO_ALIAS[opcode] || opcode;
+
+const literal = value => {
+    const text = String(value);
+    return NUMBER_RE.test(text.trim()) && text.trim() === text ? text : quote(text);
+};
+
+const getVariableName = (field, block) => {
+    const workspace = block.workspace;
+    const id = field.getValue();
+    const variable = workspace.getVariableById(id);
+    return variable ? variable.name : field.getText();
+};
+
+const variableTypeOf = field => {
+    if (typeof field.defaultType_ === 'string') return field.defaultType_;
+    if (Array.isArray(field.variableTypes_) && field.variableTypes_.length) return field.variableTypes_[0];
+    return '';
+};
+
+const isVariableField = (field, ScratchBlocks) =>
+    ScratchBlocks.FieldVariable && field instanceof ScratchBlocks.FieldVariable;
+
+const isLabelField = (field, ScratchBlocks) =>
+    !field.name ||
+    (ScratchBlocks.FieldLabel && field instanceof ScratchBlocks.FieldLabel && !field.EDITABLE) ||
+    (ScratchBlocks.FieldImage && field instanceof ScratchBlocks.FieldImage);
+
+const fieldToText = (field, block, ScratchBlocks) => {
+    if (isVariableField(field, ScratchBlocks)) {
+        const type = variableTypeOf(field);
+        const name = getVariableName(field, block);
+        if (type === 'list') return nameToken('@', name);
+        if (type === 'broadcast_msg') return quote(name);
+        return nameToken('$', name);
+    }
+    return quote(field.getValue());
+};
+
+/**
+ * Describe the "slots" of a block in visual order.
+ * @returns {{args: Array, statements: Array}} args are field/value inputs, statements are C-block bodies.
+ */
+const describeBlock = (block, ScratchBlocks) => {
+    const args = [];
+    const statements = [];
+    for (const input of block.inputList) {
+        for (const field of input.fieldRow) {
+            if (isLabelField(field, ScratchBlocks)) continue;
+            args.push({kind: 'field', name: field.name, field});
+        }
+        if (input.type === ScratchBlocks.INPUT_VALUE) {
+            args.push({kind: 'value', name: input.name, input});
+        } else if (input.type === ScratchBlocks.NEXT_STATEMENT) {
+            statements.push({name: input.name, input});
+        }
+    }
+    return {args, statements};
+};
+
+const shadowToText = (shadow, ScratchBlocks) => {
+    const fields = [];
+    for (const input of shadow.inputList) {
+        if (input.connection && input.connection.targetBlock()) throw new Unsupported('nested shadow');
+        for (const field of input.fieldRow) {
+            if (!isLabelField(field, ScratchBlocks)) fields.push(field);
+        }
+    }
+    if (fields.length !== 1) throw new Unsupported(`shadow ${shadow.type}`);
+    const field = fields[0];
+    if (isVariableField(field, ScratchBlocks)) return quote(getVariableName(field, shadow));
+    const value = field.getValue();
+    if (NUMBER_SHADOWS.has(shadow.type) || shadow.type === 'text') return literal(value);
+    return quote(value);
+};
+
+let exprToText; // eslint-disable-line prefer-const
+
+const valueToText = (input, ScratchBlocks) => {
+    const target = input.connection && input.connection.targetBlock();
+    if (!target) return '_';
+    if (target.isShadow()) return shadowToText(target, ScratchBlocks);
+    return exprToText(target, ScratchBlocks, 0);
+};
+
+const argsToText = (args, block, ScratchBlocks) => args.map(arg => (
+    arg.kind === 'field' ? fieldToText(arg.field, block, ScratchBlocks) : valueToText(arg.input, ScratchBlocks)
+));
+
+exprToText = (block, ScratchBlocks, parentPrec) => {
+    const type = block.type;
+    if (type === 'data_variable') return nameToken('$', getVariableName(block.getField('VARIABLE'), block));
+    if (type === 'data_listcontents') return nameToken('@', getVariableName(block.getField('LIST'), block));
+    if (type === 'argument_reporter_string_number' || type === 'argument_reporter_boolean') {
+        return nameToken('%', block.getFieldValue('VALUE'));
+    }
+    const op = BINARY_OPERATORS[type];
+    if (op) {
+        const left = valueToText(block.getInput(op.inputs[0]), ScratchBlocks);
+        const right = valueToText(block.getInput(op.inputs[1]), ScratchBlocks);
+        const leftBlock = block.getInputTargetBlock(op.inputs[0]);
+        const rightBlock = block.getInputTargetBlock(op.inputs[1]);
+        const l = leftBlock && !leftBlock.isShadow() ? exprToText(leftBlock, ScratchBlocks, op.prec) : left;
+        const r = rightBlock && !rightBlock.isShadow() ? exprToText(rightBlock, ScratchBlocks, op.prec + 1) : right;
+        const text = `${l} ${op.symbol} ${r}`;
+        return op.prec < parentPrec ? `(${text})` : text;
+    }
+    if (type === 'operator_not') {
+        const inner = block.getInputTargetBlock('OPERAND');
+        const text = `not ${inner && !inner.isShadow() ? exprToText(inner, ScratchBlocks, NOT_PREC) : '_'}`;
+        return NOT_PREC < parentPrec ? `(${text})` : text;
+    }
+    if (!block.outputConnection) throw new Unsupported(`${type} is not a reporter`);
+    if (type === 'procedures_call' || type.startsWith('procedures_')) throw new Unsupported(type);
+    const {args, statements} = describeBlock(block, ScratchBlocks);
+    if (statements.length) throw new Unsupported(`${type} has statements`);
+    const name = blockName(type);
+    return args.length ? `${name}(${argsToText(args, block, ScratchBlocks).join(', ')})` : name;
+};
+
+const procedureInfo = prototype => {
+    const mutation = prototype.mutationToDom();
+    return {
+        proccode: mutation.getAttribute('proccode'),
+        argumentnames: JSON.parse(mutation.getAttribute('argumentnames') || '[]'),
+        warp: mutation.getAttribute('warp') === 'true'
+    };
+};
+
+let chainToLines; // eslint-disable-line prefer-const
+
+const statementToLines = (block, ScratchBlocks, indent) => {
+    const type = block.type;
+    if (block.outputConnection) throw new Unsupported('reporter in a stack');
+    if (type === 'procedures_call') {
+        const mutation = block.mutationToDom();
+        const proccode = mutation.getAttribute('proccode');
+        const values = block.inputList
+            .filter(input => input.type === ScratchBlocks.INPUT_VALUE)
+            .map(input => valueToText(input, ScratchBlocks));
+        return [`${indent}call ${quote(proccode)}${values.length ? ` (${values.join(', ')})` : ''}`];
+    }
+    if (type.startsWith('procedures_')) throw new Unsupported(type);
+    const {args, statements} = describeBlock(block, ScratchBlocks);
+    if (statements.length > 2) throw new Unsupported('more than two bodies');
+    let name = blockName(type);
+    if (type === 'control_if_else') name = 'if';
+    const argText = argsToText(args, block, ScratchBlocks);
+    let head = args.length ? `${name}(${argText.join(', ')})` : name;
+    if (name === 'if' || name === 'repeat' || name === 'repeat_until' || name === 'while' || name === 'wait_until') {
+        head = `${name} (${argText.join(', ')})`;
+    }
+    if (!statements.length) return [indent + head];
+    const lines = [`${indent}${head} {`];
+    statements.forEach((statement, i) => {
+        if (i > 0) lines.push(`${indent}} else {`);
+        const first = statement.input.connection.targetBlock();
+        lines.push(...chainToLines(first, ScratchBlocks, indent + INDENT));
+    });
+    lines.push(`${indent}}`);
+    return lines;
+};
+
+chainToLines = (block, ScratchBlocks, indent) => {
+    const lines = [];
+    while (block) {
+        lines.push(...statementToLines(block, ScratchBlocks, indent));
+        block = block.getNextBlock();
+    }
+    return lines;
+};
+
+const countBlocks = top => top.getDescendants(false).filter(b => !b.isShadow()).length;
+
+const scriptToLines = (top, ScratchBlocks) => {
+    const type = top.type;
+    if (type === 'procedures_definition') {
+        const prototype = top.getInputTargetBlock('custom_block');
+        if (!prototype) throw new Unsupported('definition without prototype');
+        const info = procedureInfo(prototype);
+        const params = info.argumentnames.map(n => nameToken('%', n)).join(', ');
+        return [
+            `define ${info.warp ? 'warp ' : ''}${quote(info.proccode)} (${params}) {`,
+            ...chainToLines(top.getNextBlock(), ScratchBlocks, INDENT),
+            '}'
+        ];
+    }
+    if (top.outputConnection) throw new Unsupported('loose reporter');
+    const isHat = !top.previousConnection;
+    if (isHat) {
+        const {args, statements} = describeBlock(top, ScratchBlocks);
+        if (statements.length) throw new Unsupported('hat with statements');
+        const name = blockName(type);
+        const head = args.length ? `${name}(${argsToText(args, top, ScratchBlocks).join(', ')})` : name;
+        return [`${head} {`, ...chainToLines(top.getNextBlock(), ScratchBlocks, INDENT), '}'];
+    }
+    return ['stack {', ...chainToLines(top, ScratchBlocks, INDENT), '}'];
+};
+
+/**
+ * @param {Blockly.Workspace} workspace The main blocks workspace
+ * @param {object} ScratchBlocks scratch-blocks
+ * @returns {{text: string, scripts: Array<{id: string, text: string, locked: boolean}>}} The workspace as text
+ */
+const workspaceToText = (workspace, ScratchBlocks) => {
+    const scripts = [];
+    const tops = workspace.getTopBlocks(true).filter(b => !b.isShadow() && !b.isInsertionMarker());
+    for (const top of tops) {
+        try {
+            scripts.push({id: top.id, text: scriptToLines(top, ScratchBlocks).join('\n'), locked: false});
+        } catch (e) {
+            if (!(e instanceof Unsupported)) throw e;
+            const n = countBlocks(top);
+            scripts.push({
+                id: top.id,
+                text: `locked_script(${quote(top.id)}) // ${n} block${n === 1 ? '' : 's'}: edit this one in Block coding`,
+                locked: true
+            });
+        }
+    }
+    return {
+        text: scripts.map(s => s.text).join('\n\n') + (scripts.length ? '\n' : ''),
+        scripts
+    };
+};
+
+export {
+    workspaceToText,
+    describeBlock,
+    isLabelField,
+    isVariableField,
+    variableTypeOf
+};
diff --git a/src/lib/sl-workspace-registry.js b/src/lib/sl-workspace-registry.js
new file mode 100644
index 0000000..019d8f1
--- /dev/null
+++ b/src/lib/sl-workspace-registry.js
@@ -0,0 +1,21 @@
+// Stick Lab: lets the Text coding editor reach the main blocks workspace.
+let current = null;
+const listeners = new Set();
+
+const setWorkspace = (workspace, ScratchBlocks) => {
+    current = workspace ? {workspace, ScratchBlocks} : null;
+    listeners.forEach(fn => fn(current));
+};
+
+const getWorkspace = () => current;
+
+const onWorkspaceChange = fn => {
+    listeners.add(fn);
+    return () => listeners.delete(fn);
+};
+
+export {
+    setWorkspace,
+    getWorkspace,
+    onWorkspaceChange
+};
