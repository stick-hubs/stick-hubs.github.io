+            else handled = false;
+        } else {
+            handled = false;
+        }
+        if (handled) {
+            e.preventDefault();
+            e.stopPropagation();
+        }
+    }
+
+    // ------------------------------------------------------------------ saving
+
+    frameBlob (key) {
+        return new Promise(resolve => this.composite(key).toBlob(resolve, 'image/png'));
+    }
+
+    async handleSave () {
+        const vm = this.props.vm;
+        const target = vm.editingTarget;
+        if (!target || this.state.saving) return;
+        this.stopPlaying();
+        this.setState({saving: true, playing: false, message: 'Saving your animation...'});
+        try {
+            const storage = vm.runtime.storage;
+            const used = new Set(target.getCostumes().map(c => c.name));
+            const uniqueName = () => {
+                let n = 1;
+                while (used.has(`frame${n}`)) n++;
+                used.add(`frame${n}`);
+                return `frame${n}`;
+            };
+            const desired = [];
+            for (const frame of this.state.frames) {
+                const canvas = this.canvases.get(frame.key);
+                if (frame.source && !frame.dirty) {
+                    desired.push(frame.source);
+                } else if (frame.source && target.getCostumes().indexOf(frame.source) !== -1 &&
+                    !desired.includes(frame.source)) {
+                    const index = target.getCostumes().indexOf(frame.source);
+                    vm.updateBitmap(index, this.composite(frame.key).getContext('2d').getImageData(0, 0, W, H), CX, CY, 2);
+                    desired.push(frame.source);
+                } else {
+                    const blob = await this.frameBlob(frame.key);
+                    const data = new Uint8Array(await blob.arrayBuffer());
+                    const asset = storage.createAsset(
+                        storage.AssetType.ImageBitmap, storage.DataFormat.PNG, data, null, true
+                    );
+                    const name = uniqueName();
+                    const costume = {
+                        name,
+                        dataFormat: 'png',
+                        asset,
+                        assetId: asset.assetId,
+                        md5: `${asset.assetId}.png`,
+                        bitmapResolution: 2,
+                        rotationCenterX: CX,
+                        rotationCenterY: CY
+                    };
+                    await vm.addCostume(costume.md5, costume, target.id);
+                    const all = target.getCostumes();
+                    desired.push(all.find(c => c.name === name) || all[all.length - 1]);
+                }
+            }
+            // remove costumes that were deleted from the timeline
+            const costumes = target.getCostumes();
+            for (let i = costumes.length - 1; i >= 0; i--) {
+                if (!desired.includes(costumes[i]) && target.getCostumes().length > 1) {
+                    vm.deleteCostume(i);
+                }
+            }
+            // put the costumes in timeline order
+            desired.forEach((costume, i) => {
+                const from = target.getCostumes().indexOf(costume);
+                if (from !== -1 && from !== i) vm.reorderCostume(target.id, from, i);
+            });
+            target.setCostume(0);
+            if (this.state.addScript && desired.length > 1) {
+                await this.addPlayScript(target, desired[0].name);
+            }
+            vm.emitTargetsUpdate();
+            vm.runtime.emitProjectChanged();
+            if (this.rigs.length) {
+                const snapshot = {
+                    rigs: this.rigs.map(r => ({...r})),
+                    frames: this.state.frames.map(f => ({canvas: this.canvases.get(f.key), poses: this.copyPoses(f.key) || new Map()}))
+                };
