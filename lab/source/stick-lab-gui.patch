+// Stick Lab 1.3.1: the ragdoll blocks in the Motion category.
+const defineRagdollBlocks = ScratchBlocks => {
+    if (!ScratchBlocks || ScratchBlocks.Blocks.motion_ragdoll) return;
+    ScratchBlocks.Blocks.motion_ragdoll = {
+        init: function () {
+            this.jsonInit({
+                message0: 'ragdoll %1 %2',
+                args0: [
+                    {type: 'field_dropdown', name: 'STATE', options: [['on', 'on'], ['off', 'off']]},
+                    {type: 'field_dropdown', name: 'PIVOT', options: [['use pivot', 'use pivot'], ['no pivot', 'no pivot']]}
+                ],
+                category: ScratchBlocks.Categories.motion,
+                extensions: ['colours_motion', 'shape_statement']
+            });
+            this.setTooltip('Use pivot: a floppy stickman with joints. No pivot: the whole sprite falls, bounces and tumbles. ' +
+                'Grab a ragdoll with the mouse to throw it.');
+        }
+    };
+    ScratchBlocks.Blocks.motion_ragdollthrow = {
+        init: function () {
+            this.jsonInit({
+                message0: 'throw ragdoll x: %1 y: %2',
+                args0: [
+                    {type: 'input_value', name: 'X'},
+                    {type: 'input_value', name: 'Y'}
+                ],
+                category: ScratchBlocks.Categories.motion,
+                extensions: ['colours_motion', 'shape_statement']
+            });
+        }
+    };
+};
+
+export {defineRagdollBlocks};
diff --git a/src/lib/sl-ragdoll/ragdoll.js b/src/lib/sl-ragdoll/ragdoll.js
new file mode 100644
index 0000000..e48c765
--- /dev/null
+++ b/src/lib/sl-ragdoll/ragdoll.js
@@ -0,0 +1,394 @@
+// Stick Lab 1.3.1: ragdoll physics for sprites.
+//
+//   ragdoll [on/off] [use pivot / no pivot]
+//     no pivot:  the sprite is one stiff body. It falls, bounces, tumbles and can be thrown.
+//     use pivot: the sprite becomes a floppy stickman with joints (head, arms, legs swing on their own).
+//   throw ragdoll x: () y: ()
+//
+// While a sprite is a ragdoll you can grab it with the mouse and fling it.
+import compatBlocks from 'scratch-vm/src/compiler/compat-blocks';
+
+const OPCODES = ['motion_ragdoll', 'motion_ragdollthrow'];
+
+const STAGE = {left: -240, right: 240, top: 180, bottom: -180};
+const GRAVITY = 0.9; // per frame at 30 fps
+const RES = 2; // pivot stickmen are drawn at 2x
+
+// The stickman for "use pivot": points (x, y up) for a 60-unit-tall stickman, and the bones between them.
+const POINTS = {
+    head: [0, 26], neck: [0, 17], hip: [0, -4],
+    elbowL: [-8, 9], handL: [-14, 0], elbowR: [8, 9], handR: [14, 0],
+    kneeL: [-5, -17], footL: [-7, -30], kneeR: [5, -17], footR: [7, -30]
+};
+const BONES = [
+    ['head', 'neck'], ['neck', 'hip'],
+    ['neck', 'elbowL'], ['elbowL', 'handL'], ['neck', 'elbowR'], ['elbowR', 'handR'],
+    ['hip', 'kneeL'], ['kneeL', 'footL'], ['hip', 'kneeR'], ['kneeR', 'footR']
+];
+// Hidden braces that stop the body folding in impossible ways.
+const BRACES = [['head', 'hip', 0.9], ['kneeL', 'kneeR', 0.25], ['elbowL', 'hip', 0.15], ['elbowR', 'hip', 0.15]];
+
+const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
+
+// The main colour of a costume, so the pivot stickman matches the sprite.
+const costumeColor = target => {
+    try {
+        const costume = target.getCostumes()[target.currentCostume];
+        if (costume && costume.dataFormat === 'svg' && costume.asset) {
+            const text = new TextDecoder().decode(costume.asset.data);
+            const counts = {};
+            const re = /#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})\b/g;
+            let m;
+            while ((m = re.exec(text))) {
+                let hex = m[1].toLowerCase();
+                if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');
+                const r = parseInt(hex.slice(0, 2), 16);
+                const g = parseInt(hex.slice(2, 4), 16);
+                const b = parseInt(hex.slice(4, 6), 16);
+                if (r + g + b > 690) continue; // skip white
+                counts[hex] = (counts[hex] || 0) + 1;
+            }
+            const best = Object.keys(counts).sort((a, b) => counts[b] - counts[a])[0];
+            if (best) return `#${best}`;
+        }
+    } catch (e) {
+        // fall through
+    }
+    return '#1e5aa8';
+};
+
+class RagdollWorld {
+    constructor (vm) {
+        this.vm = vm;
+        this.runtime = vm.runtime;
+        this.dolls = new Map(); // target id -> state
+        this.mouseWasDown = false;
+        this.step = this.step.bind(this);
+        this.runtime.on('BEFORE_EXECUTE', this.step);
+        this.runtime.on('PROJECT_STOP_ALL', () => this.stopAll());
+        this.runtime.on('PROJECT_LOADED', () => this.stopAll());
+    }
+
+    get frameScale () {
+        const fps = (this.runtime.frameLoop && this.runtime.frameLoop.framerate) || 30;
+        return fps > 0 ? 30 / fps : 1; // keep the same speed at 30 or 60 fps
+    }
+
+    set (target, on, pivot) {
+        if (!target || target.isStage) return;
+        const old = this.dolls.get(target.id);
+        if (!on) {
+            if (old) this.release(target, old);
+            return;
+        }
+        if (old && old.pivot === pivot) return;
+        if (old) this.release(target, old);
+        const state = pivot ? this.makeStickman(target) : {pivot: false, vx: 0, vy: 0, va: 0};
+        state.lastX = target.x;
+        state.lastY = target.y;
+        this.dolls.set(target.id, state);
+    }
+
+    makeStickman (target) {
+        const bounds = target.getBounds();
+        const height = bounds ? clamp(bounds.top - bounds.bottom, 24, 300) : 60;
+        const s = height / 60;
+        const p = {};
+        for (const [name, [x, y]] of Object.entries(POINTS)) {
+            const px = target.x + (x * s);
+            const py = target.y + (y * s);
+            p[name] = {x: px, y: py, ox: px, oy: py};
+        }
+        const length = (a, b) => Math.hypot(p[a].x - p[b].x, p[a].y - p[b].y);
+        const canvas = document.createElement('canvas');
+        canvas.reusable = false;
+        return {
+            pivot: true, s, p,
+            bones: BONES.map(([a, b]) => [a, b, length(a, b), 1]),
+            braces: BRACES.map(([a, b, k]) => [a, b, length(a, b), k]),
+            color: costumeColor(target),
+            canvas,
+            skinId: null,
+            grab: null
+        };
+    }
+
+    release (target, state) {
+        this.dolls.delete(target.id);
+        if (state.pivot) {
+            if (state.skinId !== null && this.runtime.renderer) {
+                this.runtime.renderer.destroySkin(state.skinId);
+            }
+            if (target.renderer) target.updateAllDrawableProperties();
+        }
+    }
+
+    stopAll () {
+        for (const [id, state] of this.dolls) {
+            const target = this.runtime.getTargetById(id);
+            if (target) this.release(target, state);
+            else this.dolls.delete(id);
+        }
+    }
+
+    throw (target, vx, vy) {
+        const state = target && this.dolls.get(target.id);
+        if (!state) return;
+        vx = clamp(Number(vx) || 0, -80, 80);
+        vy = clamp(Number(vy) || 0, -80, 80);
+        if (state.pivot) {
+            for (const q of Object.values(state.p)) {
+                q.ox = q.x - vx;
+                q.oy = q.y - vy;
+            }
+            // a little spin so it tumbles
+            state.p.head.ox += vy * 0.3;
+            state.p.footL.ox -= vy * 0.3;
+        } else {
+            state.vx = vx;
+            state.vy = vy;
+            state.va = vx * 1.5;
+        }
+    }
+
+    // ------------------------------------------------------------------ every frame
+
+    step () {
+        if (!this.dolls.size) return;
+        // Moving sprites here asks for a redraw, which would stop scripts from running this frame.
+        const redraw = this.runtime.redrawRequested;
+        try {
+            this.stepInner();
+        } finally {
+            this.runtime.redrawRequested = redraw;
+        }
+    }
+
+    stepInner () {
+        const mouse = this.runtime.ioDevices.mouse;
+        const mx = mouse.getScratchX();
+        const my = mouse.getScratchY();
+        const down = mouse.getIsDown();
+        const pressed = down && !this.mouseWasDown;
+        this.mouseWasDown = down;
+        const k = this.frameScale;
+        for (const [id, state] of this.dolls) {
+            const target = this.runtime.getTargetById(id);
+            if (!target) {
+                this.dolls.delete(id);
+                continue;
+            }
+            // a script moved the sprite: move the ragdoll with it
+            const dx = target.x - state.lastX;
+            const dy = target.y - state.lastY;
+            if (state.pivot) {
+                if (dx || dy) for (const q of Object.values(state.p)) {
+                    q.x += dx; q.y += dy; q.ox += dx; q.oy += dy;
+                }
+                this.stepStickman(target, state, {mx, my, down, pressed, k});
+            } else {
+                this.stepRigid(target, state, {mx, my, down, pressed, k});
+            }
+        }
+    }
+
+    stepRigid (target, state, {mx, my, down, pressed, k}) {
+        if (pressed && target.visible && target.isTouchingObject('_mouse_')) {
+            state.grab = {ox: target.x - mx, oy: target.y - my, lx: mx, ly: my};
+        }
+        if (state.grab && !down) state.grab = null;
+        let x = target.x;
+        let y = target.y;
+        if (state.grab) {
+            const g = state.grab;
+            state.vx = (mx - g.lx);
+            state.vy = (my - g.ly);
+            state.va = state.vx * 1.2;
+            g.lx = mx;
+            g.ly = my;
+            x = mx + g.ox;
+            y = my + g.oy;
+            target.setDirection(target.direction + (state.va * 0.3));
+        } else {
+            state.vy -= GRAVITY * k;
+            x += state.vx * k;
+            y += state.vy * k;
+            target.setDirection(target.direction + (state.va * k));
+        }
+        target.setXY(x, y);
+        const b = target.getBounds();
+        if (b && !state.grab) {
+            let fx = 0;
+            let fy = 0;
+            if (b.bottom < STAGE.bottom) {
+                fy = STAGE.bottom - b.bottom;
+                if (state.vy < 0) {
+                    state.vy = Math.abs(state.vy) < 2.5 ? 0 : -state.vy * 0.45;
+                    state.va = (state.va * 0.5) + (state.vx * 0.6);
+                    state.vx *= 0.82;
+                }
+                if (state.vy === 0) {
+                    state.vx *= 0.85;
+                    state.va *= 0.7;
+                }
+            }
+            if (b.top > STAGE.top && state.vy > 0) {
+                fy = STAGE.top - b.top;
+                state.vy = -state.vy * 0.4;
+            }
+            if (b.left < STAGE.left && state.vx < 0) {
+                fx = STAGE.left - b.left;
+                state.vx = -state.vx * 0.55;
+                state.va = -state.va * 0.6;
+            }
+            if (b.right > STAGE.right && state.vx > 0) {
+                fx = STAGE.right - b.right;
+                state.vx = -state.vx * 0.55;
+                state.va = -state.va * 0.6;
+            }
+            if (fx || fy) target.setXY(target.x + fx, target.y + fy);
+        }
+        state.lastX = target.x;
+        state.lastY = target.y;
+    }
+
+    stepStickman (target, state, {mx, my, down, pressed, k}) {
+        const p = state.p;
+        const pts = Object.values(p);
+        const headR = 6.5 * state.s;
+        if (pressed && target.visible) {
+            let best = null;
+            let bestD = Math.max(14, 14 * state.s);
+            for (const [name, q] of Object.entries(p)) {
+                const d = Math.hypot(q.x - mx, q.y - my);
+                if (d < bestD) {
+                    best = name;
+                    bestD = d;
+                }
+            }
+            if (best) state.grab = best;
+        }
+        if (state.grab && !down) state.grab = null;
+
+        // move every point (Verlet), with gravity
+        for (const q of pts) {
+            const vx = (q.x - q.ox) * 0.99;
+            const vy = (q.y - q.oy) * 0.99;
+            q.ox = q.x;
+            q.oy = q.y;
+            q.x += vx;
+            q.y += vy - (GRAVITY * k * 0.55);
+        }
+        if (state.grab) {
+            const q = p[state.grab];
+            q.x = mx;
+            q.y = my;
+        }
+        // keep the bones the right length
+        for (let i = 0; i < 8; i++) {
+            for (const [a, b, len, stiff] of state.bones.concat(state.braces)) {
+                const A = p[a];
+                const B = p[b];
+                const dx = B.x - A.x;
+                const dy = B.y - A.y;
+                const d = Math.hypot(dx, dy) || 0.001;
+                const diff = ((d - len) / d) * 0.5 * stiff;
+                const grabA = state.grab === a;
+                const grabB = state.grab === b;
+                if (!grabA) {
+                    A.x += dx * diff * (grabB ? 2 : 1);
+                    A.y += dy * diff * (grabB ? 2 : 1);
+                }
+                if (!grabB) {
+                    B.x -= dx * diff * (grabA ? 2 : 1);
+                    B.y -= dy * diff * (grabA ? 2 : 1);
+                }
+            }
+            // the stage edges
+            for (const [name, q] of Object.entries(p)) {
+                const r = name === 'head' ? headR : 2 * state.s;
+                if (q.y < STAGE.bottom + r) {
+                    q.y = STAGE.bottom + r;
+                    q.ox = q.x - ((q.x - q.ox) * 0.75); // friction on the ground
+                    if (q.oy < q.y) q.oy = q.y + ((q.y - q.oy) * 0.3);
+                }
+                if (q.y > STAGE.top - r) q.y = STAGE.top - r;
+                if (q.x < STAGE.left + r) q.x = STAGE.left + r;
+                if (q.x > STAGE.right - r) q.x = STAGE.right - r;
+            }
+        }
+        this.drawStickman(target, state, headR);
+    }
+
+    drawStickman (target, state, headR) {
+        const renderer = this.runtime.renderer;
+        if (!renderer || target.drawableID === null || typeof target.drawableID === 'undefined') return;
+        const p = state.p;
+        const line = 4.2 * state.s;
+        const pad = headR + line + 2;
+        let minX = Infinity;
+        let maxX = -Infinity;
+        let minY = Infinity;
+        let maxY = -Infinity;
+        for (const q of Object.values(p)) {
+            minX = Math.min(minX, q.x);
+            maxX = Math.max(maxX, q.x);
+            minY = Math.min(minY, q.y);
+            maxY = Math.max(maxY, q.y);
+        }
+        minX -= pad; maxX += pad; minY -= pad; maxY += pad;
+        const canvas = state.canvas;
+        canvas.width = Math.ceil((maxX - minX) * RES);
+        canvas.height = Math.ceil((maxY - minY) * RES);
+        const ctx = canvas.getContext('2d');
+        const X = q => (q.x - minX) * RES;
+        const Y = q => (maxY - q.y) * RES;
+        ctx.strokeStyle = state.color;
+        ctx.fillStyle = state.color;
+        ctx.lineWidth = line * RES;
+        ctx.lineCap = 'round';
+        ctx.lineJoin = 'round';
+        ctx.beginPath();
+        for (const [a, b] of state.bones) {
+            if (a === 'head') continue;
+            ctx.moveTo(X(p[a]), Y(p[a]));
+            ctx.lineTo(X(p[b]), Y(p[b]));
+        }
+        ctx.stroke();
+        ctx.beginPath();
+        ctx.arc(X(p.head), Y(p.head), headR * RES, 0, Math.PI * 2);
+        ctx.fill();
+        // the sprite's position is the hip
+        const center = [p.hip.x - minX, maxY - p.hip.y];
+        if (state.skinId === null) state.skinId = renderer.createBitmapSkin(canvas, RES, center);
+        else renderer.updateBitmapSkin(state.skinId, canvas, RES, center);
+        renderer.updateDrawableSkinId(target.drawableID, state.skinId);
+        renderer.updateDrawableDirectionScale(target.drawableID, 90, [100, 100]);
+        target.setXY(p.hip.x, p.hip.y, true);
+        renderer.updateDrawablePosition(target.drawableID, [p.hip.x, p.hip.y]);
+        state.lastX = target.x;
+        state.lastY = target.y;
+    }
+}
+
+let world = null;
+
+const installRagdoll = vm => {
+    if (world) return world;
+    world = new RagdollWorld(vm);
+    for (const opcode of OPCODES) {
+        if (!compatBlocks.stacked.includes(opcode)) compatBlocks.stacked.push(opcode);
+    }
+    vm.runtime._primitives.motion_ragdoll = (args, util) => {
+        const on = String(args.STATE).toLowerCase() !== 'off';
+        const value = String(args.PIVOT).toLowerCase();
+        const pivot = value === 'pivot' || value === 'use pivot';
+        world.set(util.target, on, pivot);
+    };
+    vm.runtime._primitives.motion_ragdollthrow = (args, util) => {
+        world.throw(util.target, args.X, args.Y);
+    };
+    return world;
+};
+
+export {installRagdoll};
