+    coin: () => ({svg: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="36" viewBox="0 0 32 36"><ellipse cx="16" cy="18" rx="14" ry="16" fill="#e0a800"/><ellipse cx="16" cy="18" rx="10" ry="12" fill="#ffd54a"/><rect x="13" y="9" width="4" height="18" rx="2" fill="#fff3b0"/></svg>', cx: 16, cy: 18}),
