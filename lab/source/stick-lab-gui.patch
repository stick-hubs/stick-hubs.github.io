+// Stick Lab 1.4: the Physics category's blocks.
+const COLOR = {primary: '#8A6A3B', secondary: '#7A5D33', tertiary: '#644C2A'};
+
+const defineVmPhysicsBlocks = (ScratchBlocks, vm) => {
+    if (!ScratchBlocks || ScratchBlocks.Blocks.motion_phys_enable) return;
+    const colours = {colour: COLOR.primary, colourSecondary: COLOR.secondary, colourTertiary: COLOR.tertiary};
+    const command = (opcode, message, args) => {
+        ScratchBlocks.Blocks[opcode] = {
+            init: function () {
+                this.jsonInit(Object.assign({message0: message, args0: args || [], extensions: ['shape_statement']}, colours));
+            }
+        };
+    };
+    const menu = (name, options) => ({type: 'field_dropdown', name, options: options.map(o => [o, o])});
+    const num = name => ({type: 'input_value', name});
+    // a dropdown of the other sprites (plus the stage for pins)
+    const spriteMenu = withStage => function () {
+        const options = withStage ? [['stage', '_stage_']] : [];
+        const editing = vm.editingTarget;
+        for (const t of vm.runtime.targets) {
+            if (!t.isOriginal || t.isStage || t === editing) continue;
+            options.push([t.getName(), t.getName()]);
+        }
+        if (!options.length) options.push(['(no other sprite)', '_none_']);
+        return options;
+    };
+    const joinBlock = (opcode, label, withStage, extra) => {
+        ScratchBlocks.Blocks[opcode] = {
+            init: function () {
+                this.appendDummyInput().appendField(label).appendField(new ScratchBlocks.FieldDropdown(spriteMenu(withStage)), 'TARGET');
+                if (extra) {
+                    this.appendDummyInput().appendField(extra.label);
+                    this.appendValueInput(extra.name);
+                }
+                this.setInputsInline(true);
+                this.setPreviousStatement(true, null);
+                this.setNextStatement(true, null);
+                this.setColour(COLOR.primary, COLOR.secondary, COLOR.tertiary);
+            }
+        };
+    };
+
+    command('motion_phys_enable', 'enable physics as %1 %2', [menu('SHAPE', ['box', 'circle']), menu('TYPE', ['moving', 'fixed'])]);
+    command('motion_phys_disable', 'disable physics');
+    command('motion_phys_setgravity', 'set gravity x: %1 y: %2', [num('X'), num('Y')]);
+    command('motion_phys_push', 'push x: %1 y: %2', [num('X'), num('Y')]);
+    command('motion_phys_setvelocity', 'set velocity x: %1 y: %2', [num('X'), num('Y')]);
+    command('motion_phys_spin', 'spin %1 degrees per frame', [num('SPEED')]);
+    command('motion_phys_motor', 'motor speed %1', [num('SPEED')]);
+    command('motion_phys_setproperty', 'set %1 to %2 %%', [menu('PROPERTY', ['bounciness', 'friction', 'heaviness']), num('VALUE')]);
+    joinBlock('motion_phys_pin', 'pin to', true);
+    joinBlock('motion_phys_spring', 'spring to', false, {label: 'stiffness', name: 'STIFFNESS'});
+    joinBlock('motion_phys_rod', 'rod to', false);
+    command('motion_phys_unjoin', 'remove joints');
+    command('motion_phys_edges', 'stage edges %1', [menu('STATE', ['on', 'off'])]);
+    ScratchBlocks.Blocks.motion_phys_get = {
+        init: function () {
+            this.jsonInit(Object.assign({message0: 'physics %1', args0: [menu('PROPERTY', ['velocity x', 'velocity y', 'speed', 'spin'])],
+                extensions: ['output_number']}, colours));
+        }
+    };
+    ScratchBlocks.Blocks.motion_phys_onground = {
+        init: function () {
+            this.jsonInit(Object.assign({message0: 'on the ground?', extensions: ['output_boolean']}, colours));
+        }
+    };
+    ScratchBlocks.Blocks.motion_phys_isphysical = {
+        init: function () {
+            this.jsonInit(Object.assign({message0: 'physics on?', extensions: ['output_boolean']}, colours));
+        }
+    };
+};
+
+const n = (name, value) => `<value name="${name}"><shadow type="math_number"><field name="NUM">${value}</field></shadow></value>`;
+
+const physicsToolboxXML = isStage => `
+    <category name="Physics" id="physics" colour="${COLOR.primary}" secondaryColour="${COLOR.tertiary}">
+        ${isStage ? '' : `<block type="motion_phys_enable"/>
+        <block type="motion_phys_disable"/>
+        <sep gap="36"/>
+        <block type="motion_phys_push">${n('X', 0)}${n('Y', 12)}</block>
+        <block type="motion_phys_setvelocity">${n('X', 5)}${n('Y', 0)}</block>
+        <block type="motion_phys_spin">${n('SPEED', 10)}</block>
+        <block type="motion_phys_motor">${n('SPEED', 6)}</block>
+        <sep gap="36"/>
+        <block type="motion_phys_setproperty">${n('VALUE', 50)}</block>
+        <sep gap="36"/>
+        <block type="motion_phys_pin"/>
+        <block type="motion_phys_spring">${n('STIFFNESS', 50)}</block>
+        <block type="motion_phys_rod"/>
+        <block type="motion_phys_unjoin"/>
+        <sep gap="36"/>`}
+        <block type="motion_phys_setgravity">${n('X', 0)}${n('Y', -10)}</block>
+        <block type="motion_phys_edges"/>
+        ${isStage ? '' : `<sep gap="36"/>
+        <block type="motion_phys_get"/>
+        <block type="motion_phys_onground"/>
+        <block type="motion_phys_isphysical"/>`}
+    </category>`;
+
+export {defineVmPhysicsBlocks, physicsToolboxXML};
diff --git a/src/lib/sl-physics/physics.js b/src/lib/sl-physics/physics.js
new file mode 100644
index 0000000..580909f
--- /dev/null
+++ b/src/lib/sl-physics/physics.js
@@ -0,0 +1,317 @@
+// Stick Lab 1.4: Physics blocks. Sprites can become physical bodies in a Matter.js world.
+//
+// Stage coordinates are used everywhere (x right, y up). Matter.js uses y down, so y is flipped inside.
+// Speeds are in steps per frame (at 60 frames a second), like "change x by".
+import Matter from 'matter-js';
+import compatBlocks from 'scratch-vm/src/compiler/compat-blocks';
+
+const {Engine, Bodies, Body, Composite, Constraint} = Matter;
+
+const STACKED = [
+    'motion_phys_enable', 'motion_phys_disable', 'motion_phys_setgravity', 'motion_phys_push', 'motion_phys_setvelocity',
+    'motion_phys_spin', 'motion_phys_motor', 'motion_phys_setproperty', 'motion_phys_pin', 'motion_phys_spring', 'motion_phys_rod',
+    'motion_phys_unjoin', 'motion_phys_edges'
+];
+const INPUTS = ['motion_phys_get', 'motion_phys_onground', 'motion_phys_isphysical'];
+
+const toNum = v => {
+    const n = Number(v);
+    return Number.isFinite(n) ? n : 0;
+};
+
+class PhysicsWorld {
+    constructor (vm) {
+        this.vm = vm;
+        this.runtime = vm.runtime;
+        this.engine = null;
+        this.items = new Map(); // target id -> {body, target, motor, joints: [], lastX, lastY, lastDir}
+        this.edgesOn = true;
+        this.edges = [];
+        this.runtime.on('BEFORE_EXECUTE', () => this.step());
+        this.runtime.on('PROJECT_STOP_ALL', () => this.reset());
+        this.runtime.on('PROJECT_LOADED', () => this.reset());
+    }
+
+    ensure () {
+        if (this.engine) return this.engine;
+        this.engine = Engine.create();
+        this.engine.gravity.y = 1;
+        this.engine.positionIterations = 8;
+        this.engine.velocityIterations = 6;
+        this.setEdges(this.edgesOn);
+        return this.engine;
+    }
+
+    reset () {
+        this.engine = null;
+        this.items.clear();
+        this.edges = [];
+        this.edgesOn = true;
+    }
+
+    setEdges (on) {
+        this.edgesOn = on;
+        if (!this.engine) return;
+        for (const e of this.edges) Composite.remove(this.engine.world, e);
+        this.edges = [];
+        if (!on) return;
+        const thick = 200;
+        const opts = {isStatic: true, friction: 0.6, restitution: 0.1, label: 'edge'};
+        this.edges = [
+            Bodies.rectangle(0, 180 + (thick / 2), 2000, thick, opts), // floor (y down: +180 is the bottom)
+            Bodies.rectangle(0, -180 - (thick / 2), 2000, thick, opts), // ceiling
+            Bodies.rectangle(-240 - (thick / 2), 0, thick, 2000, opts),
+            Bodies.rectangle(240 + (thick / 2), 0, thick, 2000, opts)
+        ];
+        Composite.add(this.engine.world, this.edges);
+    }
+
+    // ------------------------------------------------------------------ bodies
+
+    sizeOf (target) {
+        const renderer = this.runtime.renderer;
+        let w = 40;
+        let h = 40;
+        if (renderer && target.drawableID !== null && typeof target.drawableID !== 'undefined') {
+            const size = renderer.getCurrentSkinSize(target.drawableID);
+            if (size) [w, h] = size;
+        }
+        const scale = target.size / 100;
+        return [Math.max(2, w * scale), Math.max(2, h * scale)];
+    }
+
+    enable (target, shape, fixed) {
+        if (!target || target.isStage) return;
+        const engine = this.ensure();
+        this.disable(target);
+        const [w, h] = this.sizeOf(target);
+        const opts = {
+            isStatic: fixed,
+            friction: 0.4,
+            restitution: 0.3,
+            angle: (target.direction - 90) * Math.PI / 180,
+            label: target.id
+        };
+        const body = shape === 'circle' ?
+            Bodies.circle(target.x, -target.y, Math.max(1, (w + h) / 4), opts) :
+            Bodies.rectangle(target.x, -target.y, w, h, opts);
+        Composite.add(engine.world, body);
+        this.items.set(target.id, {body, target, motor: null, joints: [], lastX: target.x, lastY: target.y, lastDir: target.direction});
+    }
+
+    disable (target) {
+        const item = target && this.items.get(target.id);
+        if (!item || !this.engine) return;
+        this.unjoin(target);
+        // joints from other sprites to this one
+        for (const other of this.items.values()) {
+            other.joints = other.joints.filter(j => {
+                if (j.bodyA === item.body || j.bodyB === item.body) {
+                    Composite.remove(this.engine.world, j);
+                    return false;
+                }
+                return true;
+            });
+        }
+        Composite.remove(this.engine.world, item.body);
+        this.items.delete(target.id);
+    }
+
+    item (target) {
+        return target ? this.items.get(target.id) : null;
+    }
+
+    findTarget (name, from) {
+        if (name === '_stage_' || !name) return null;
+        if (name === '_myself_') return from;
+        return this.runtime.getSpriteTargetByName(String(name));
+    }
+
+    join (target, otherName, kind, stiffness) {
+        const item = this.item(target);
+        if (!item) return;
+        const engine = this.ensure();
+        const other = this.findTarget(otherName, target);
+        const otherItem = other && other !== target ? this.item(other) : null;
+        if (other && other !== target && !otherItem) return; // the other sprite isn't physical
+        let c;
+        if (kind === 'pin') {
+            c = otherItem ?
+                Constraint.create({bodyA: otherItem.body, pointA: Matter.Vector.sub(item.body.position, otherItem.body.position),
+                    bodyB: item.body, pointB: {x: 0, y: 0}, length: 0, stiffness: 1, damping: 0.1}) :
+                Constraint.create({pointA: {x: item.body.position.x, y: item.body.position.y}, bodyB: item.body,
+                    pointB: {x: 0, y: 0}, length: 0, stiffness: 1, damping: 0.1});
+        } else {
+            if (!otherItem) return; // springs and rods join two sprites
+            const s = kind === 'rod' ? 1 : Math.max(0.0005, Math.min(1, toNum(stiffness) / 100 * 0.08));
+            c = Constraint.create({bodyA: otherItem.body, bodyB: item.body, stiffness: s, damping: kind === 'rod' ? 0.1 : 0.02});
+        }
+        Composite.add(engine.world, c);
+        item.joints.push(c);
+    }
+
+    unjoin (target) {
+        const item = this.item(target);
+        if (!item || !this.engine) return;
+        for (const j of item.joints) Composite.remove(this.engine.world, j);
+        item.joints = [];
+    }
+
+    onGround (target) {
+        const item = this.item(target);
+        if (!item || !this.engine) return false;
+        const body = item.body;
+        const pairs = this.engine.pairs.list || [];
+        for (const pair of pairs) {
+            if (pair.isActive === false || !pair.collision) continue;
+            const mine = pair.bodyA === body || pair.bodyB === body || pair.bodyA.parent === body || pair.bodyB.parent === body;
+            if (!mine || Math.abs(pair.collision.normal.y) < 0.5) continue;
+            // standing on something: the touching points are below the middle of the sprite (y grows downward here)
+            const supports = pair.collision.supports || [];
+            const contacts = supports.filter(Boolean);
+            if (!contacts.length) continue;
+            const y = contacts.reduce((n, p) => n + p.y, 0) / contacts.length;
+            if (y > body.position.y) return true;
+        }
+        return false;
+    }
+
+    // ------------------------------------------------------------------ every frame
+
+    step () {
+        if (!this.engine || !this.items.size) return;
+        // Moving sprites here asks for a redraw, which would stop scripts from running this frame.
+        const redraw = this.runtime.redrawRequested;
+        try {
+            this.stepInner();
+        } finally {
+            this.runtime.redrawRequested = redraw;
+        }
+    }
+
+    stepInner () {
+        const fps = (this.runtime.frameLoop && this.runtime.frameLoop.framerate) || 30;
+        // scripts may have moved, turned or resized sprites: tell the physics
+        for (const [id, item] of this.items) {
+            const t = item.target;
+            if (!this.runtime.targets.includes(t)) {
+                this.disable(t);
+                this.items.delete(id);
+                continue;
+            }
+            if (t.x !== item.lastX || t.y !== item.lastY) {
+                Body.setPosition(item.body, {x: t.x, y: -t.y});
+            }
+            if (t.direction !== item.lastDir && t.rotationStyle === 'all around') {
+                Body.setAngle(item.body, (t.direction - 90) * Math.PI / 180);
+            }
+            // sprites that don't rotate stay upright: lock the body's rotation
+            const upright = t.rotationStyle !== 'all around';
+            if (upright && item.body.inertia !== Infinity) {
+                item.inertia = item.body.inertia;
+                Body.setInertia(item.body, Infinity);
+                Body.setAngle(item.body, 0);
+                Body.setAngularVelocity(item.body, 0);
+            } else if (!upright && item.body.inertia === Infinity && item.inertia) {
+                Body.setInertia(item.body, item.inertia);
+            }
+            if (item.motor !== null && !item.body.isStatic) Body.setAngularVelocity(item.body, item.motor);
+        }
+        const delta = 1000 / (fps > 0 ? fps : 30);
+        // bigger frames are split up so fast things don't pass through each other
+        const steps = Math.max(1, Math.round(delta / (1000 / 60)));
+        for (let i = 0; i < steps; i++) Engine.update(this.engine, delta / steps);
+        for (const item of this.items.values()) {
+            const t = item.target;
+            const b = item.body;
+            if (!b.isStatic) {
+                t.setXY(b.position.x, -b.position.y);
+                if (t.rotationStyle === 'all around') t.setDirection(90 + (b.angle * 180 / Math.PI));
+            }
+            item.lastX = t.x;
+            item.lastY = t.y;
+            item.lastDir = t.direction;
+        }
+    }
+}
+
+let world = null;
+
+const installPhysics = vm => {
+    if (world) return world;
+    world = new PhysicsWorld(vm);
+    for (const op of STACKED) if (!compatBlocks.stacked.includes(op)) compatBlocks.stacked.push(op);
+    for (const op of INPUTS) if (!compatBlocks.inputs.includes(op)) compatBlocks.inputs.push(op);
+    const P = vm.runtime._primitives;
+    // Physics commands count as "changing something on screen", like motion blocks, so a forever loop
+    // with a push in it runs once per frame instead of hundreds of times.
+    const command = fn => (args, util) => {
+        util.runtime.requestRedraw();
+        return fn(args, util);
+    };
+    const body = util => {
+        const item = world.item(util.target);
+        return item && item.body;
+    };
+    P.motion_phys_enable = command((args, util) => {
+        world.enable(util.target, String(args.SHAPE) === 'circle' ? 'circle' : 'box', String(args.TYPE) === 'fixed');
+    });
+    P.motion_phys_disable = command((args, util) => world.disable(util.target));
+    P.motion_phys_setgravity = command(args => {
+        const engine = world.ensure();
+        engine.gravity.x = toNum(args.X) / 10;
+        engine.gravity.y = -toNum(args.Y) / 10;
+    });
+    P.motion_phys_push = command((args, util) => {
+        const b = body(util);
+        if (b && !b.isStatic) Body.setVelocity(b, {x: b.velocity.x + toNum(args.X), y: b.velocity.y - toNum(args.Y)});
+    });
+    P.motion_phys_setvelocity = command((args, util) => {
+        const b = body(util);
+        if (b && !b.isStatic) Body.setVelocity(b, {x: toNum(args.X), y: -toNum(args.Y)});
+    });
+    P.motion_phys_spin = command((args, util) => {
+        const b = body(util);
+        if (b && !b.isStatic) Body.setAngularVelocity(b, toNum(args.SPEED) * Math.PI / 180);
+    });
+    P.motion_phys_motor = command((args, util) => {
+        const item = world.item(util.target);
+        if (!item) return;
+        const speed = toNum(args.SPEED);
+        item.motor = speed === 0 ? null : speed * Math.PI / 180;
+        if (speed === 0) Body.setAngularVelocity(item.body, 0);
+    });
+    P.motion_phys_setproperty = command((args, util) => {
+        const b = body(util);
+        if (!b) return;
+        const v = toNum(args.VALUE);
+        const prop = String(args.PROPERTY);
+        if (prop === 'bounciness') b.restitution = Math.max(0, Math.min(1, v / 100));
+        if (prop === 'friction') b.friction = Math.max(0, Math.min(1, v / 100));
+        if (prop === 'heaviness') Body.setDensity(b, Math.max(0.0001, v / 100 * 0.002));
+    });
+    P.motion_phys_pin = command((args, util) => world.join(util.target, args.TARGET, 'pin'));
+    P.motion_phys_spring = command((args, util) => world.join(util.target, args.TARGET, 'spring', args.STIFFNESS));
+    P.motion_phys_rod = command((args, util) => world.join(util.target, args.TARGET, 'rod'));
+    P.motion_phys_unjoin = command((args, util) => world.unjoin(util.target));
+    P.motion_phys_edges = command(args => {
+        world.ensure();
+        world.setEdges(String(args.STATE) !== 'off');
+    });
+    P.motion_phys_get = (args, util) => {
+        const b = body(util);
+        if (!b) return 0;
+        const prop = String(args.PROPERTY);
+        const round = n => Math.round(n * 100) / 100;
+        if (prop === 'velocity x') return round(b.velocity.x);
+        if (prop === 'velocity y') return round(-b.velocity.y);
+        if (prop === 'speed') return round(Math.hypot(b.velocity.x, b.velocity.y));
+        if (prop === 'spin') return round(b.angularVelocity * 180 / Math.PI);
+        return 0;
+    };
+    P.motion_phys_onground = (args, util) => world.onGround(util.target);
+    P.motion_phys_isphysical = (args, util) => !!world.item(util.target);
+    return world;
+};
+
+export {installPhysics};
