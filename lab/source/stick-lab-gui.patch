diff --git a/scripts/sl-patch-scratch-blocks.cjs b/scripts/sl-patch-scratch-blocks.cjs
new file mode 100644
index 0000000..d24d7e0
--- /dev/null
+++ b/scripts/sl-patch-scratch-blocks.cjs
@@ -0,0 +1,37 @@
+// Stick Lab: classic, squarer block shapes.
+// Run after `npm ci` and before building: node scripts/sl-patch-scratch-blocks.cjs
+const fs = require('fs');
+const path = require('path');
+const file = path.join(__dirname, '..', 'node_modules', 'scratch-blocks', 'blockly_compressed_vertical.js');
+let s = fs.readFileSync(file, 'utf8');
+if (s.includes('/*sticklab-shapes*/')) {
+    console.log('scratch-blocks already patched');
+    process.exit(0);
+}
+const swaps = [
+    // straight-sided notch instead of the curvy Scratch notch (same width and depth)
+    ['Blockly.BlockSvg.NOTCH_PATH_LEFT="c 2,0 3,1 4,2 l 4,4 c 1,1 2,2 4,2 h 12 c 2,0 3,-1 4,-2 l 4,-4 c 1,-1 2,-2 4,-2"',
+        'Blockly.BlockSvg.NOTCH_PATH_LEFT="l 8,8 h 20 l 8,-8"'],
+    ['Blockly.BlockSvg.NOTCH_PATH_RIGHT="c -2,0 -3,1 -4,2 l -4,4 c -1,1 -2,2 -4,2 h -12 c -2,0 -3,-1 -4,-2 l -4,-4 c -1,-1 -2,-2 -4,-2"',
+        'Blockly.BlockSvg.NOTCH_PATH_RIGHT="l -8,8 h -20 l -8,-8"'],
+    // flat-topped hat with angled sides instead of the round cap
+    ['Blockly.BlockSvg.START_HAT_PATH="c 25,-22 71,-22 96,0"',
+        'Blockly.BlockSvg.START_HAT_PATH="l 16,-16 h 64 l 16,16"'],
+    // smaller corners
+    ['Blockly.BlockSvg.CORNER_RADIUS=1*Blockly.BlockSvg.GRID_UNIT', 'Blockly.BlockSvg.CORNER_RADIUS=.5*Blockly.BlockSvg.GRID_UNIT'],
+    ['Blockly.BlockSvg.NUMBER_FIELD_CORNER_RADIUS=4*Blockly.BlockSvg.GRID_UNIT', 'Blockly.BlockSvg.NUMBER_FIELD_CORNER_RADIUS=1*Blockly.BlockSvg.GRID_UNIT'],
+    ['Blockly.BlockSvg.FIELD_DEFAULT_CORNER_RADIUS=4*Blockly.BlockSvg.GRID_UNIT', 'Blockly.BlockSvg.FIELD_DEFAULT_CORNER_RADIUS=1*Blockly.BlockSvg.GRID_UNIT'],
+    // round reporters become rounded rectangles (left edge, drawn upwards)
+    ['this.edgeShape_===Blockly.OUTPUT_SHAPE_ROUND?a.push("a "+this.edgeShapeWidth_+" "+this.edgeShapeWidth_+" 0 0 1 0 -"+2*this.edgeShapeWidth_)',
+        'this.edgeShape_===Blockly.OUTPUT_SHAPE_ROUND?a.push(/*sticklab-shapes*/"h "+-(this.edgeShapeWidth_-4)+" a 4 4 0 0 1 -4 -4 v "+-(2*this.edgeShapeWidth_-8)+" a 4 4 0 0 1 4 -4 h "+(this.edgeShapeWidth_-4))'],
+    // ...and the right edge, drawn downwards
+    ['this.edgeShape_===Blockly.OUTPUT_SHAPE_ROUND?a.push("a "+this.edgeShapeWidth_+" "+this.edgeShapeWidth_+" 0 0 1 0 "+2*this.edgeShapeWidth_)',
+        'this.edgeShape_===Blockly.OUTPUT_SHAPE_ROUND?a.push("h "+(this.edgeShapeWidth_-4)+" a 4 4 0 0 1 4 4 v "+(2*this.edgeShapeWidth_-8)+" a 4 4 0 0 1 -4 4 h "+-(this.edgeShapeWidth_-4))']
+];
+for (const [from, to] of swaps) {
+    const count = s.split(from).length - 1;
+    if (count !== 1) throw new Error(`Expected 1 match, found ${count}: ${from.slice(0, 80)}`);
+    s = s.replace(from, to);
+}
+fs.writeFileSync(file, s);
+console.log('scratch-blocks patched for Stick Lab shapes');
