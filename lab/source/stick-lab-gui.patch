+                        remaining === 'unlimited' ? 'Owner device: unlimited messages' :
+                            remaining !== null ? `${remaining} free message${remaining === '1' ? '' : 's'} left today` :
+                                'Duo can make mistakes. Check its code before you use it.'}
+                </div>
+            </div>
+        );
+    }
+}
+
+DuoPanel.propTypes = {
+    toolboxXML: PropTypes.string,
+    vm: PropTypes.shape({
+        editingTarget: PropTypes.object,
+        runtime: PropTypes.object
+    }).isRequired
+};
