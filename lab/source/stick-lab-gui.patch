+// Stick Lab: which kind of coding is shown in the Script tab ("blocks" or "text").
+let mode = 'blocks';
+const listeners = new Set();
+const beforeChange = new Set();
+
+const getCodeMode = () => mode;
+
+/**
+ * @param {'blocks'|'text'} next New mode
+ * @returns {boolean} false if a listener refused the change (e.g. the text has a mistake)
+ */
+const setCodeMode = next => {
+    if (next === mode) return true;
+    for (const fn of beforeChange) {
+        if (fn(mode, next) === false) return false;
+    }
+    mode = next;
+    listeners.forEach(fn => fn(mode));
+    return true;
+};
+
+const onCodeModeChange = fn => {
+    listeners.add(fn);
+    return () => listeners.delete(fn);
+};
+
+const onBeforeCodeModeChange = fn => {
+    beforeChange.add(fn);
+    return () => beforeChange.delete(fn);
+};
+
+export {
+    getCodeMode,
+    setCodeMode,
+    onCodeModeChange,
+    onBeforeCodeModeChange
+};
