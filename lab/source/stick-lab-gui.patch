+        rig.color = this.state.color;
+        this.markAllDirty();
+    }
+
+    // ------------------------------------------------------------------ playback
+
+    togglePlay () {
+        if (this.state.playing) {
+            this.stopPlaying();
+            this.setState({playing: false}, () => this.renderView());
+        } else {
+            this.setState({playing: true}, () => this.startPlaying());
+        }
+    }
+
+    startPlaying () {
+        this.stopPlaying();
+        const tick = () => {
+            const {frames, current, loop, fps} = this.state;
+            if (current >= frames.length - 1 && !loop) {
+                this.setState({playing: false}, () => this.renderView());
+                return;
+            }
+            this.setState({current: (current + 1) % frames.length});
+            this.timer = setTimeout(tick, 1000 / Math.max(1, Math.min(60, fps || 12)));
+        };
+        this.timer = setTimeout(tick, 1000 / Math.max(1, this.state.fps || 12));
+    }
+
+    stopPlaying () {
+        clearTimeout(this.timer);
+        this.timer = null;
+    }
+
+    // ------------------------------------------------------------------ keyboard
+
+    handleKeyDown (e) {
+        const tag = (e.target && e.target.tagName) || '';
+        if (tag === 'INPUT' || tag === 'TEXTAREA') return;
+        const key = e.key;
+        let handled = true;
+        if ((e.ctrlKey || e.metaKey) && key.toLowerCase() === 'z') {
+            if (e.shiftKey) this.redo();
+            else this.undo();
+        } else if ((e.ctrlKey || e.metaKey) && key.toLowerCase() === 'y') {
+            this.redo();
+        } else if (key === 'Enter') {
+            this.togglePlay();
+        } else if (key === 'F6') {
+            this.insertKeyframe();
+        } else if (key === 'F7') {
+            this.insertBlank();
+        } else if (key === ',' || key === 'ArrowLeft') {
+            this.goTo(this.state.current - 1);
+        } else if (key === '.' || key === 'ArrowRight') {
+            this.goTo(this.state.current + 1);
+        } else if (key === 'Delete') {
+            this.deleteFrame();
+        } else if (key === 'Escape') {
+            this.handleClose();
+        } else if (!e.ctrlKey && !e.metaKey && !e.altKey) {
