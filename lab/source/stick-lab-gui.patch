@@ -0,0 +1,583 @@
+import React from 'react';
+import PropTypes from 'prop-types';
+import {connect} from 'react-redux';
+import classNames from 'classnames';
+import {isDuoOpen, setDuoOpen, onDuoChange} from './duo-store';
+import {loadSettings, saveSettings, loadConfig, duoServerOn, sendToDuo} from '../../lib/sl-duo/duo-client';
+import {getWorkspace} from '../../lib/sl-workspace-registry';
+import {workspaceToText} from '../../lib/sl-text-code/printer';
+import {applyText, commandList} from '../../lib/sl-text-code/apply';
+import {buildGame} from '../../lib/sl-duo/game-builder';
+import styles from './duo.css';
+
+const WELCOME = 'Hi! I\'m **Stick Lab Duo**. I can explain your scripts, find and fix bugs, write scripts, ' +
+    'and even build a whole small game. Use the buttons below, or just ask!';
+
+const ACTIONS = [
+    {kind: 'explain', label: 'Explain', title: 'Explain what this sprite\'s scripts do',
+        prompt: 'Explain what the scripts of the sprite I\'m editing do, step by step, in simple words.'},
+    {kind: 'fix', label: 'Fix bugs', title: 'Find bugs in this sprite\'s scripts and fix them',
+        prompt: 'Find the bugs in the scripts of the sprite I\'m editing and fix them.'},
+    {kind: 'build', label: 'Build a game', title: 'Describe a game and Duo makes the sprites and scripts', prompt: null}
+];
+
+const BUILD_PREFIX = 'Build a game: ';
+
+const FIX_RULES = `The user pressed "Fix bugs". Reply with:
+1. A short list of the bugs you found and how you fixed them (or say the scripts look fine).
+2. The complete fixed scripts for this sprite in ONE \`\`\`stick code block. Include every script of the sprite,
+also the ones that were already fine, because the user can press "Replace my scripts" to swap all of them for your block.
+If there are no scripts or no bugs, don't write a code block.`;
+
+const BUILD_RULES = `The user pressed "Build a game". Make a small, fun, working game from their idea (2 to 5 sprites).
+First write 2 or 3 short sentences about the game and how to play it. Then write one \`\`\`stick code block per sprite.
+Put the sprite settings on the same line as the three backticks, like this:
+\`\`\`stick sprite="Player" look="stickman" color="#1e88e5" x="-180" y="-120" size="100"
+when_flag_clicked {
+    ...
+}
+\`\`\`
+looks for sprites: stickman, enemy, ball, box, coin, star, platform, flag. color is a hex colour.
+Use sprite="Stage" with look="day", "night", "grass" or "space" for the backdrop and for scripts like a timer.
+Variables ($name) and lists (@name) are shared by all sprites. Use broadcasts to talk between sprites.
+Every script must start with a "when" block. Use only commands from the list. Keep scripts short and simple.
+The user presses "Build this game" to make all the sprites and scripts.`;
+
+const SUGGESTIONS = [
+    'Make my sprite jump when I press space',
+    'Build a game: a stickman collects coins and dodges a red enemy',
+    'Give me an idea for a game'
+];
+
+const SYNTAX = `Stick Lab Text coding (each script starts with a "when" block):
+when_flag_clicked {
+    go_to_xy(0, 0)
+    repeat (10) {
+        move(10)
+        if (touching("_edge_")) {
+            turn_right(180)
+        } else {
+            change_var($score, 1)
+        }
+    }
+}
+Rules: values go in ( ) separated by commas. Text and menu choices go in "quotes". $name is a variable,
+@name is a list, %name is a custom block input. Maths: + - * / mod. Compare: > < ==. Logic: and or not.
+C blocks (if, repeat, forever, repeat_until, while) use { }. if ... else uses } else {.
+Custom blocks: define "jump %s" (%height) { ... } and call "jump %s" (50).
+Loose commands go in stack { ... }. Comments start with //.`;
+
+const escapeHtml = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+
+const inlineMarkdown = text => escapeHtml(text)
+    .replace(/`([^`]+)`/g, '<code>$1</code>')
+    .replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>')
+    .replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<i>$2</i>');
+
+const splitMessage = text => {
+    const parts = [];
+    const re = /```([a-zA-Z]*)([^\n`]*)\n?([\s\S]*?)(```|$)/g;
+    let last = 0;
+    let m;
+    while ((m = re.exec(text))) {
+        if (m.index > last) parts.push({type: 'text', text: text.slice(last, m.index)});
+        parts.push({type: 'code', lang: m[1], info: m[2].trim(), text: m[3].replace(/\n$/, ''), closed: m[4] === '```'});
+        last = re.lastIndex;
+        if (m[0] === '') re.lastIndex++;
+    }
+    if (last < text.length) parts.push({type: 'text', text: text.slice(last)});
+    return parts;
+};
+
+const TextPart = ({text}) => {
+    const lines = text.split('\n');
+    const out = [];
+    let list = null;
+    lines.forEach((line, i) => {
+        const bullet = /^\s*[-*]\s+(.*)$/.exec(line) || /^\s*\d+[.)]\s+(.*)$/.exec(line);
+        if (bullet) {
+            if (!list) {
+                list = [];
+                out.push({type: 'list', items: list, key: i});
+            }
+            list.push(bullet[1]);
+        } else {
+            list = null;
