+    day: '<svg xmlns="http://www.w3.org/2000/svg" width="480" height="360" viewBox="0 0 480 360"><defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5fb4f0"/><stop offset="1" stop-color="#d8f0ff"/></linearGradient></defs><rect width="480" height="360" fill="url(#g)"/><rect y="300" width="480" height="60" fill="#8a5a32"/><rect y="300" width="480" height="14" fill="#4caf50"/></svg>',
+    night: '<svg xmlns="http://www.w3.org/2000/svg" width="480" height="360" viewBox="0 0 480 360"><defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0b1030"/><stop offset="1" stop-color="#27346b"/></linearGradient></defs><rect width="480" height="360" fill="url(#g)"/><circle cx="400" cy="60" r="22" fill="#f4f1d0"/><g fill="#fff"><circle cx="60" cy="40" r="1.6"/><circle cx="140" cy="90" r="1.3"/><circle cx="230" cy="30" r="1.8"/><circle cx="320" cy="110" r="1.3"/><circle cx="90" cy="150" r="1.2"/><circle cx="270" cy="170" r="1.5"/></g><rect y="310" width="480" height="50" fill="#1d2a1d"/></svg>',
+    grass: '<svg xmlns="http://www.w3.org/2000/svg" width="480" height="360" viewBox="0 0 480 360"><rect width="480" height="360" fill="#8fd16f"/><g fill="#7bc25b"><circle cx="60" cy="60" r="30"/><circle cx="380" cy="120" r="40"/><circle cx="200" cy="260" r="36"/><circle cx="420" cy="300" r="26"/></g></svg>',
+    space: '<svg xmlns="http://www.w3.org/2000/svg" width="480" height="360" viewBox="0 0 480 360"><rect width="480" height="360" fill="#090b1f"/><g fill="#fff"><circle cx="40" cy="50" r="1.5"/><circle cx="120" cy="200" r="1.2"/><circle cx="200" cy="80" r="1.8"/><circle cx="300" cy="300" r="1.4"/><circle cx="380" cy="40" r="1.2"/><circle cx="440" cy="220" r="1.7"/><circle cx="260" cy="160" r="1"/></g><circle cx="410" cy="300" r="40" fill="#7e57c2"/></svg>'
+};
+
+const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
+
+const variableNames = code => {
+    const names = {vars: new Set(), lists: new Set()};
+    const re = /([$@])(?:"([^"]+)"|([A-Za-z_][A-Za-z0-9_]*))/g;
+    let m;
+    while ((m = re.exec(code))) (m[1] === '$' ? names.vars : names.lists).add(m[2] || m[3]);
+    return names;
+};
+
+const uid = () => `sl${Math.random().toString(36).slice(2, 10)}${Date.now().toString(36).slice(-4)}`;
+
+/**
+ * Build a game from Duo's code blocks.
+ * @param {Array<{info: string, text: string}>} parts code blocks with sprite="..." settings
+ * @param {{vm: object, getToolbox: Function}} env Stick Lab
+ * @returns {Promise<string[]>} what was made
+ */
+const buildGame = async (parts, {vm, getToolbox}) => {
+    const sections = parts.map(p => ({attrs: parseAttrs(p.info), code: p.text}))
+        .filter(s => s.attrs.sprite);
+    if (!sections.length) throw new Error('Duo\'s answer has no sprites to build.');
+    const stage = vm.runtime.getTargetForStage();
+
+    // Variables and lists are made for all sprites, so every sprite and the Stage share them.
+    for (const s of sections) {
+        const names = variableNames(s.code);
+        names.vars.forEach(n => {
+            if (!stage.lookupVariableByNameAndType(n, '')) stage.createVariable(uid(), n, '');
+        });
+        names.lists.forEach(n => {
+            if (!stage.lookupVariableByNameAndType(n, 'list')) stage.createVariable(uid(), n, 'list');
+        });
+    }
+
+    const made = [];
+    let firstSprite = null;
+    // the Stage first, then sprites in Duo's order
+    sections.sort((a, b) => (b.attrs.sprite.toLowerCase() === 'stage') - (a.attrs.sprite.toLowerCase() === 'stage'));
+    for (const {attrs, code} of sections) {
+        const isStage = attrs.sprite.toLowerCase() === 'stage';
+        let target;
+        let created = false;
+        if (isStage) {
+            target = stage;
+            vm.setEditingTarget(stage.id);
+            const backdrop = BACKDROPS[(attrs.look || '').toLowerCase()];
+            if (backdrop) {
+                const index = stage.getCostumes().findIndex(c => c.name === attrs.look.toLowerCase());
+                if (index === -1) {
+                    vm.updateSvg(stage.currentCostume, backdrop, 240, 180);
+                    stage.renameCostume(stage.currentCostume, attrs.look.toLowerCase());
+                }
+            }
+        } else {
+            const name = esc(attrs.sprite).slice(0, 40) || 'Sprite';
+            target = vm.runtime.targets.find(t => t.isOriginal && !t.isStage && t.getName() === name);
+            if (!target) {
+                await vm.addSprite(JSON.stringify(emptySprite(name, 'pop', 'look')));
+                target = vm.runtime.targets.find(t => t.isOriginal && !t.isStage && t.getName() === name) ||
+                    vm.editingTarget;
+                created = true;
+            }
+            vm.setEditingTarget(target.id);
+            if (created) {
+                const color = COLOR_RE.test(attrs.color || '') ? attrs.color : '#1e88e5';
+                const look = (LOOKS[(attrs.look || '').toLowerCase()] || LOOKS.stickman)(color);
+                vm.updateSvg(0, look.svg, look.cx, look.cy);
+                const x = parseFloat(attrs.x);
+                const y = parseFloat(attrs.y);
+                if (isFinite(x) && isFinite(y)) target.setXY(x, y);
+                const size = parseFloat(attrs.size);
+                if (isFinite(size) && size > 5) target.setSize(size);
+            }
+        }
+        if (!firstSprite && !isStage) firstSprite = target;
+        // let Stick Lab switch the script area to this sprite
+        await sleep(450);
+        const ws = getWorkspace();
+        if (!ws) throw new Error('Open the Script tab first, then try again.');
+        const current = created ? '' : workspaceToText(ws.workspace, ws.ScratchBlocks).text;
+        try {
+            applyText(`${current}\n\n${code}\n`, {
+                ScratchBlocks: ws.ScratchBlocks,
+                workspace: ws.workspace,
+                vm,
+                toolboxXML: getToolbox()
+            });
+            made.push(`${isStage ? 'the Stage' : `"${target.getName()}"`}${created ? ' (new)' : ''}`);
+            // let the new blocks reach the project before switching to the next sprite
+            await sleep(350);
+        } catch (e) {
+            made.push(`${isStage ? 'the Stage' : `"${target.getName()}"`}: its scripts didn't fit (${e.message})`);
+        }
+    }
+    if (firstSprite) vm.setEditingTarget(firstSprite.id);
+    vm.emitTargetsUpdate();
+    vm.runtime.emitProjectChanged();
+    return made;
+};
+
+export {parseAttrs, buildGame, LOOKS, BACKDROPS};
diff --git a/src/lib/sl-format.js b/src/lib/sl-format.js
new file mode 100644
index 0000000..e6b14ca
--- /dev/null
+++ b/src/lib/sl-format.js
@@ -0,0 +1,113 @@
+// Stick Lab project format (.sl)
+//
+// A .sl file is a Scratch 3 project that has been scrambled so that only Stick Lab can open it:
+//   bytes 0-7  "STICKLAB" (magic)
+//   byte  8    format version (1)
+//   bytes 9..  the .sb3 zip, every byte XORed with KEY
+// Renaming a .sl file to .sb3 does not make it open in Scratch, because the zip data is scrambled.
+
+const MAGIC = [0x53, 0x54, 0x49, 0x43, 0x4b, 0x4c, 0x41, 0x42]; // "STICKLAB"
+const VERSION = 1;
+const HEADER_LENGTH = MAGIC.length + 1;
+const KEY = new Uint8Array([
+    0x5a, 0x17, 0xc3, 0x2e, 0x91, 0x4b, 0xe8, 0x06, 0x7d, 0xb2, 0x39, 0xf4, 0x60, 0x0d, 0xa5, 0x8c
+]);
+
+const SL_EXTENSION = '.sl';
+const SL_MIME = 'application/x-stick-lab';
+
+const toUint8Array = data => {
+    if (data instanceof Uint8Array) return data;
+    if (data instanceof ArrayBuffer) return new Uint8Array(data);
+    if (ArrayBuffer.isView(data)) return new Uint8Array(data.buffer, data.byteOffset, data.byteLength);
+    return null;
+};
+
+const scramble = (input, output) => {
+    const keyLength = KEY.length;
+    for (let i = 0; i < input.length; i++) {
+        output[i] = input[i] ^ KEY[i % keyLength];
+    }
+};
+
+/**
+ * @param {ArrayBuffer|ArrayBufferView} data Any project data
+ * @returns {boolean} true if the data is a Stick Lab .sl file
+ */
+const isStickLabProject = data => {
+    const bytes = toUint8Array(data);
+    if (!bytes || bytes.length < HEADER_LENGTH) return false;
+    for (let i = 0; i < MAGIC.length; i++) {
+        if (bytes[i] !== MAGIC[i]) return false;
+    }
+    return true;
+};
+
+/**
+ * @param {ArrayBuffer|ArrayBufferView} data Contents of a .sl file
+ * @returns {ArrayBuffer} The .sb3 zip inside it
+ */
+const decodeStickLabProject = data => {
+    const bytes = toUint8Array(data);
+    const version = bytes[MAGIC.length];
+    if (version !== VERSION) {
+        throw new Error(`This .sl file was made by a newer version of Stick Lab (format ${version}). Please update Stick Lab.`);
+    }
+    const body = bytes.subarray(HEADER_LENGTH);
+    const out = new Uint8Array(body.length);
+    scramble(body, out);
+    return out.buffer;
+};
+
+/**
+ * @param {ArrayBuffer|ArrayBufferView} sb3 A .sb3 zip
+ * @returns {Uint8Array} Contents of a .sl file
+ */
+const encodeStickLabProject = sb3 => {
+    const bytes = toUint8Array(sb3);
+    const out = new Uint8Array(HEADER_LENGTH + bytes.length);
+    out.set(MAGIC, 0);
+    out[MAGIC.length] = VERSION;
+    scramble(bytes, out.subarray(HEADER_LENGTH));
+    return out;
+};
+
+/**
+ * @param {Blob} sb3Blob A .sb3 project as a Blob
+ * @returns {Promise<Blob>} The same project as a .sl Blob
+ */
+const sb3BlobToStickLabBlob = async sb3Blob => {
+    const buffer = await sb3Blob.arrayBuffer();
+    return new Blob([encodeStickLabProject(buffer)], {type: SL_MIME});
+};
+
+/**
+ * Make every VM accept .sl data in loadProject().
+ * @param {Function} VirtualMachine The scratch-vm class
+ */
+const installStickLabLoader = VirtualMachine => {
+    const proto = VirtualMachine.prototype;
+    if (proto.__stickLabPatched) return;
+    const originalLoadProject = proto.loadProject;
+    proto.loadProject = function (input) {
+        if (isStickLabProject(input)) {
+            try {
+                input = decodeStickLabProject(input);
+            } catch (e) {
+                return Promise.reject(e);
+            }
+        }
+        return originalLoadProject.call(this, input);
+    };
+    proto.__stickLabPatched = true;
+};
+
+export {
+    SL_EXTENSION,
+    SL_MIME,
+    isStickLabProject,
+    decodeStickLabProject,
+    encodeStickLabProject,
+    sb3BlobToStickLabBlob,
+    installStickLabLoader
+};
diff --git a/src/lib/sl-hub/hub-client.js b/src/lib/sl-hub/hub-client.js
new file mode 100644
index 0000000..9838674
--- /dev/null
+++ b/src/lib/sl-hub/hub-client.js
@@ -0,0 +1,130 @@
+// Stick Lab 1.3: publishing projects to the Stick Hubs Game Hub.
+import {loadConfig, loadSettings} from '../sl-duo/duo-client';
+
+const MY_PROJECTS_KEY = 'stick-hub-my-projects';
+const NICKNAME_KEY = 'stick-hub-nickname';
+
+// The Stick Hubs website: the folder above /lab/ when Stick Lab runs on the website, otherwise the live site.
+const siteUrl = () => {
+    try {
+        if (/\/lab\//.test(location.pathname) && /^https?:$/.test(location.protocol)) {
+            return new URL('../', location.href).href;
+        }
+    } catch (e) {
+        // fall through
+    }
+    return 'https://stick-hubs.github.io/';
+};
+
+const serverUrl = async () => {
+    const config = await loadConfig();
+    return config.serverUrl ? config.serverUrl.replace(/\/$/, '') : null;
+};
+
+const readJson = (key, fallback) => {
+    try {
+        return JSON.parse(localStorage.getItem(key) || 'null') || fallback;
+    } catch (e) {
+        return fallback;
+    }
+};
+const writeJson = (key, value) => {
+    try {
+        localStorage.setItem(key, JSON.stringify(value));
+    } catch (e) {
+        // storage blocked
+    }
+};
+
+// Projects this device published: {id: {editKey, title, published}}
+const myProjects = () => readJson(MY_PROJECTS_KEY, {});
+const rememberProject = (id, editKey, title) => {
+    const all = myProjects();
+    all[id] = {...(all[id] || {}), title, published: new Date().toISOString()};
+    if (editKey) all[id].editKey = editKey;
+    writeJson(MY_PROJECTS_KEY, all);
+};
+const findMine = title => {
+    const all = myProjects();
+    const id = Object.keys(all).find(k => all[k].title === title && all[k].editKey);
+    return id ? {id, ...all[id]} : null;
+};
+
+const loadNickname = () => {
+    try {
+        return localStorage.getItem(NICKNAME_KEY) || '';
+    } catch (e) {
+        return '';
+    }
+};
+const saveNickname = name => {
+    try {
+        localStorage.setItem(NICKNAME_KEY, name);
+    } catch (e) {
+        // ignore
+    }
+};
+
+// Signed in to Stick Hubs on the website (same browser): {token, profile}
+const account = () => {
+    try {
+        const token = localStorage.getItem('stick-hubs-session');
+        const profile = JSON.parse(localStorage.getItem('stick-hubs-account') || 'null');
+        return token && profile ? {token, profile} : null;
+    } catch (e) {
+        return null;
+    }
+};
+
+const playUrl = id => `${siteUrl()}hub-play.html?id=${encodeURIComponent(id)}`;
+
+const errorFrom = async response => {
+    try {
+        const body = await response.json();
+        return body.error || `Error ${response.status}`;
+    } catch (e) {
+        return `Error ${response.status}`;
+    }
+};
+
+/**
+ * Publish (or update) a project on the Game Hub.
+ * @returns {Promise<{id: string, url: string}>} where it can be played
+ */
+const publishProject = async ({title, author, description, file, thumb, updateId}) => {
+    const server = await serverUrl();
+    if (!server) throw new Error('Publishing isn\'t switched on yet: the Stick Hubs server hasn\'t been set up.');
+    const form = new FormData();
+    form.append('title', title);
+    form.append('author', author);
+    form.append('description', description || '');
+    form.append('file', file, 'project.sl');
+    if (thumb) form.append('thumb', thumb, 'cover.jpg');
+    const headers = {};
+    if (updateId) {
+        const mine = myProjects()[updateId];
+        form.append('id', updateId);
+        form.append('editKey', (mine && mine.editKey) || '');
+    }
+    const signedIn = account();
+    if (signedIn) headers.authorization = `Bearer ${signedIn.token}`;
+    const ownerPass = loadSettings().ownerPass;
+    if (ownerPass) headers['x-duo-owner'] = ownerPass;
+    const response = await fetch(`${server}/hub/publish`, {method: 'POST', body: form, headers});
+    if (!response.ok) throw new Error(await errorFrom(response));
+    const body = await response.json();
+    rememberProject(body.id, body.editKey, title);
+    return {id: body.id, url: playUrl(body.id)};
+};
+
+export {
+    siteUrl,
+    serverUrl,
+    myProjects,
+    findMine,
+    loadNickname,
+    account,
+    saveNickname,
+    playUrl,
+    publishProject
+};
diff --git a/src/lib/sl-physics/blocks.js b/src/lib/sl-physics/blocks.js
