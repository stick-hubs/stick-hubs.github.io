+// Stick Lab Animate: a Flash-style frame-by-frame animation editor for a sprite's costumes.
+import React from 'react';
+import PropTypes from 'prop-types';
+import classNames from 'classnames';
+import styles from './animate.css';
+import * as Rig from './stick-rig';
+
+const W = 960; // frames are drawn at 2x stage size
+const H = 720;
+const CX = W / 2;
+const CY = H / 2;
+const MAX_FRAMES = 150;
+const MAX_UNDO = 25;
+const THUMB_W = 96;
+const THUMB_H = 72;
+
+const SWATCHES = [
+    '#121212', '#ffffff', '#9a9a9a', '#e53935', '#fb8c00', '#fdd835',
+    '#43a047', '#1e88e5', '#3949ab', '#8e24aa', '#6d4c41', '#f48fb1'
+];
+
+const TOOLS = [
+    {id: 'pencil', label: 'Brush', key: 'b', icon: 'M4 20 L7 19 L19 7 L17 5 L5 17 Z M15 7 L17 9'},
+    {id: 'eraser', label: 'Eraser', key: 'e', icon: 'M8 20 H20 M4 16 L14 6 L19 11 L11 19 H8 Z'},
+    {id: 'line', label: 'Line', key: 'l', icon: 'M4 20 L20 4'},
+    {id: 'rect', label: 'Rectangle', key: 'r', icon: 'M4 6 H20 V18 H4 Z'},
+    {id: 'ellipse', label: 'Ellipse', key: 'o', icon: 'M12 5 C 20 5, 20 19, 12 19 C 4 19, 4 5, 12 5 Z'},
+    {id: 'fill', label: 'Fill', key: 'f', icon: 'M5 12 L12 5 L19 12 L12 19 Z M19 14 C 21 17, 17 17, 19 14'},
+    {id: 'stick', label: 'Pose stickmen', key: 's', icon: 'M12 7 m-3 0 a3 3 0 1 0 6 0 a3 3 0 1 0 -6 0 M12 10 V15 M12 12 L7 14 M12 12 L17 10 M12 15 L8 21 M12 15 L16 21'},
+    {id: 'move', label: 'Move frame', key: 'm', icon: 'M12 3 V21 M3 12 H21 M12 3 L9 6 M12 3 L15 6 M12 21 L9 18 M12 21 L15 18'},
+    {id: 'picker', label: 'Pick colour', key: 'i', icon: 'M5 19 L13 11 M11 9 L15 13 M14 6 L18 10 L20 8 L16 4 Z'}
+];
+
+let nextKey = 1;
+
+// Lets Animate reopen with stickmen still poseable during this session.
+const sessionCache = new Map(); // target id -> {signature, frames, rigs, poses}
+const costumeSignature = target => target.getCostumes().map(c => `${c.name}:${c.assetId}`).join('|');
+
+const makeCanvas = (w = W, h = H) => {
+    const c = document.createElement('canvas');
+    c.width = w;
+    c.height = h;
+    return c;
+};
+
+const hexToRgb = hex => {
+    const n = parseInt(hex.slice(1), 16);
+    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+};
+
+const rgbToHex = (r, g, b) => `#${[r, g, b].map(v => v.toString(16).padStart(2, '0')).join('')}`;
+
+const floodFill = (ctx, x, y, hex) => {
+    const img = ctx.getImageData(0, 0, W, H);
+    const d = img.data;
+    const [fr, fg, fb] = hexToRgb(hex);
+    const start = ((y * W) + x) * 4;
+    const sr = d[start];
+    const sg = d[start + 1];
+    const sb = d[start + 2];
+    const sa = d[start + 3];
+    if (sr === fr && sg === fg && sb === fb && sa === 255) return false;
+    const tol = 48;
+    const match = i => (
+        Math.abs(d[i] - sr) <= tol && Math.abs(d[i + 1] - sg) <= tol &&
+        Math.abs(d[i + 2] - sb) <= tol && Math.abs(d[i + 3] - sa) <= tol
+    );
+    const seen = new Uint8Array(W * H);
+    const stack = [x, y];
+    while (stack.length) {
+        const py = stack.pop();
+        let px = stack.pop();
+        let i = (py * W) + px;
+        while (px >= 0 && !seen[i] && match(i * 4)) {
+            px--;
+            i--;
+        }
+        px++;
+        i++;
+        let up = false;
+        let down = false;
+        while (px < W && !seen[i] && match(i * 4)) {
+            const o = i * 4;
+            d[o] = fr;
+            d[o + 1] = fg;
+            d[o + 2] = fb;
+            d[o + 3] = 255;
+            seen[i] = 1;
+            if (py > 0) {
+                const a = i - W;
+                if (!seen[a] && match(a * 4)) {
+                    if (!up) {
+                        stack.push(px, py - 1);
+                        up = true;
+                    }
+                } else {
+                    up = false;
+                }
+            }
+            if (py < H - 1) {
+                const b = i + W;
+                if (!seen[b] && match(b * 4)) {
+                    if (!down) {
+                        stack.push(px, py + 1);
+                        down = true;
+                    }
+                } else {
+                    down = false;
+                }
+            }
+            px++;
+            i++;
+        }
+    }
+    ctx.putImageData(img, 0, 0);
+    return true;
+};
+
+class AnimateEditor extends React.Component {
+    constructor (props) {
+        super(props);
+        this.state = {
+            frames: [],
+            current: 0,
+            tool: 'pencil',
+            color: '#121212',
+            size: 8,
+            filled: false,
+            onion: true,
+            playing: false,
+            fps: 12,
+            loop: true,
+            addScript: true,
+            tweenCount: 4,
+            rigVersion: 0,
+            selectedRig: null,
+            loading: true,
+            saving: false,
+            message: null
+        };
+        this.canvases = new Map(); // frame key -> canvas (drawing only)
+        this.rigs = []; // stickmen
+        this.poses = new Map(); // frame key -> Map(rig id -> pose)
+        this.undoStack = [];
+        this.redoStack = [];
+        this.viewRef = React.createRef();
+        this.drag = null;
+        this.handlePointerDown = this.handlePointerDown.bind(this);
+        this.handlePointerMove = this.handlePointerMove.bind(this);
+        this.handlePointerUp = this.handlePointerUp.bind(this);
+        this.handleKeyDown = this.handleKeyDown.bind(this);
+        this.handleSave = this.handleSave.bind(this);
+        this.handleClose = this.handleClose.bind(this);
+        this.togglePlay = this.togglePlay.bind(this);
+        this.insertKeyframe = this.insertKeyframe.bind(this);
+        this.insertBlank = this.insertBlank.bind(this);
+        this.deleteFrame = this.deleteFrame.bind(this);
+        this.undo = this.undo.bind(this);
+        this.tween = this.tween.bind(this);
+        this.recolorStickman = this.recolorStickman.bind(this);
+        this.toggleSword = this.toggleSword.bind(this);
+        this.flipStickman = this.flipStickman.bind(this);
+        this.deleteStickman = this.deleteStickman.bind(this);
+        this.addStickman = this.addStickman.bind(this);
+        this.redo = this.redo.bind(this);
+    }
+    componentDidMount () {
+        document.addEventListener('keydown', this.handleKeyDown);
+        this.loadFrames();
+    }
+    componentDidUpdate (prevProps, prevState) {
+        if (prevState.current !== this.state.current || prevState.onion !== this.state.onion ||
+            prevState.frames !== this.state.frames || prevState.rigVersion !== this.state.rigVersion ||
+            prevState.tool !== this.state.tool || prevState.selectedRig !== this.state.selectedRig) {
+            this.renderView();
+        }
+    }
+    componentWillUnmount () {
+        document.removeEventListener('keydown', this.handleKeyDown);
+        this.stopPlaying();
+    }
+
+    // ------------------------------------------------------------------ loading
+
+    loadFrames () {
+        const target = this.props.vm.editingTarget;
+        if (!target) return;
+        const costumes = target.getCostumes();
+        const cached = sessionCache.get(target.id);
+        if (cached && cached.signature === costumeSignature(target) && cached.frames.length === costumes.length) {
+            this.rigs = cached.rigs.map(r => ({...r}));
+            const frames = cached.frames.map((f, i) => {
+                const key = nextKey++;
+                const canvas = makeCanvas();
+                canvas.getContext('2d').drawImage(f.canvas, 0, 0);
+                this.canvases.set(key, canvas);
+                this.poses.set(key, new Map(Array.from(f.poses.entries()).map(([id, pose]) => [id, Rig.clonePose(pose)])));
+                return {key, name: costumes[i].name, source: costumes[i], dirty: false, thumb: null};
+            });
+            frames.forEach(f => {
+                f.thumb = this.makeThumb(f.key);
+            });
+            const current = Math.max(0, Math.min(target.currentCostume, frames.length - 1));
+            this.setState({frames, current, loading: false, selectedRig: this.rigs.length ? this.rigs[0].id : null,
+                message: this.rigs.length ? 'Your stickmen are still poseable.' : null}, () => this.renderView());
+            return;
+        }
+        const frames = costumes.map(costume => ({
+            key: nextKey++,
+            name: costume.name,
+            source: costume,
+            dirty: false,
+            thumb: null
+        }));
+        Promise.all(frames.map(frame => this.drawCostume(frame))).then(() => {
+            frames.forEach(f => {
+                f.thumb = this.makeThumb(f.key);
+            });
+            const current = Math.max(0, Math.min(target.currentCostume, frames.length - 1));
+            this.setState({frames: frames.slice(), current, loading: false}, () => this.renderView());
+        });
+    }
+
+    drawCostume (frame) {
+        const canvas = makeCanvas();
+        this.canvases.set(frame.key, canvas);
+        const costume = frame.source;
+        return new Promise(resolve => {
+            let uri;
+            try {
+                uri = costume.asset.encodeDataURI();
+            } catch (e) {
+                resolve();
+                return;
+            }
+            const img = new Image();
+            img.onload = () => {
+                const isVector = costume.dataFormat === 'svg';
+                const scale = isVector ? 2 : 2 / (costume.bitmapResolution || 1);
+                const ctx = canvas.getContext('2d');
+                ctx.drawImage(
+                    img,
+                    CX - (costume.rotationCenterX * scale),
+                    CY - (costume.rotationCenterY * scale),
+                    img.naturalWidth * scale,
+                    img.naturalHeight * scale
+                );
+                resolve();
+            };
+            img.onerror = () => resolve();
+            img.src = uri;
+        });
+    }
+
+    drawRigs (ctx, key, options = {}) {
+        const poses = this.poses.get(key);
+        if (!poses) return;
+        for (const rig of this.rigs) {
+            const pose = poses.get(rig.id);
+            if (pose) {
+                Rig.draw(ctx, rig, pose, {
+                    tint: options.tint,
+                    handles: options.handles,
+                    selected: options.handles && rig.id === this.state.selectedRig
+                });
+            }
+        }
+    }
+
+    composite (key) {
+        const canvas = makeCanvas();
+        const ctx = canvas.getContext('2d');
+        ctx.drawImage(this.canvases.get(key), 0, 0);
+        this.drawRigs(ctx, key);
+        return canvas;
+    }
+
+    makeThumb (key) {
+        const thumb = makeCanvas(THUMB_W, THUMB_H);
+        const ctx = thumb.getContext('2d');
+        ctx.drawImage(this.composite(key), 0, 0, THUMB_W, THUMB_H);
+        return thumb.toDataURL();
+    }
+
+    // ------------------------------------------------------------------ drawing the view
+
+    currentFrame () {
+        return this.state.frames[this.state.current];
+    }
+
+    renderView (preview) {
+        const view = this.viewRef.current;
+        if (!view) return;
+        const ctx = view.getContext('2d');
+        ctx.clearRect(0, 0, W, H);
+        const {frames, current, onion, playing} = this.state;
+        const frame = frames[current];
+        if (!frame) return;
+        if (onion && !playing) {
+            this.drawOnion(ctx, frames[current - 1], '#e53935', 0.32);
+            this.drawOnion(ctx, frames[current + 1], '#43a047', 0.22);
+        }
+        const src = this.canvases.get(frame.key);
+        if (preview && preview.move) {
+            ctx.drawImage(src, preview.dx, preview.dy);
+        } else {
+            ctx.drawImage(src, 0, 0);
+        }
+        this.drawRigs(ctx, frame.key, {handles: !playing && this.state.tool === 'stick'});
+        if (preview && preview.shape) this.drawShape(ctx, preview.shape);
+        if (!playing) {
+            // stage centre marker, like the paint editor
+            ctx.strokeStyle = 'rgba(29, 79, 145, 0.35)';
+            ctx.lineWidth = 2;
+            ctx.beginPath();
+            ctx.moveTo(CX - 10, CY);
+            ctx.lineTo(CX + 10, CY);
+            ctx.moveTo(CX, CY - 10);
+            ctx.lineTo(CX, CY + 10);
+            ctx.stroke();
+        }
+    }
+
+    drawOnion (ctx, frame, tint, alpha) {
+        if (!frame) return;
+        if (!this.tintCanvas) this.tintCanvas = makeCanvas();
+        const t = this.tintCanvas.getContext('2d');
+        t.globalCompositeOperation = 'source-over';
+        t.clearRect(0, 0, W, H);
+        t.drawImage(this.canvases.get(frame.key), 0, 0);
+        this.drawRigs(t, frame.key);
+        t.globalCompositeOperation = 'source-atop';
+        t.fillStyle = tint;
+        t.globalAlpha = 0.55;
+        t.fillRect(0, 0, W, H);
+        t.globalAlpha = 1;
+        t.globalCompositeOperation = 'source-over';
+        ctx.globalAlpha = alpha;
+        ctx.drawImage(this.tintCanvas, 0, 0);
+        ctx.globalAlpha = 1;
+    }
+
+    drawShape (ctx, shape) {
+        const {tool, x0, y0, x1, y1, color, size, filled} = shape;
+        ctx.save();
+        ctx.lineCap = 'round';
+        ctx.lineJoin = 'round';
+        ctx.strokeStyle = color;
+        ctx.fillStyle = color;
+        ctx.lineWidth = size;
+        ctx.beginPath();
+        if (tool === 'line') {
+            ctx.moveTo(x0, y0);
+            ctx.lineTo(x1, y1);
+            ctx.stroke();
+        } else if (tool === 'rect') {
+            ctx.rect(Math.min(x0, x1), Math.min(y0, y1), Math.abs(x1 - x0), Math.abs(y1 - y0));
+            if (filled) ctx.fill();
+            else ctx.stroke();
+        } else if (tool === 'ellipse') {
+            const rx = Math.abs(x1 - x0) / 2;
+            const ry = Math.abs(y1 - y0) / 2;
+            ctx.ellipse((x0 + x1) / 2, (y0 + y1) / 2, Math.max(rx, 0.5), Math.max(ry, 0.5), 0, 0, Math.PI * 2);
+            if (filled) ctx.fill();
+            else ctx.stroke();
+        }
+        ctx.restore();
+    }
+
+    // ------------------------------------------------------------------ undo
+
+    copyPoses (key) {
+        const poses = this.poses.get(key);
+        return poses ? new Map(Array.from(poses.entries()).map(([id, p]) => [id, Rig.clonePose(p)])) : null;
+    }
+
+    pushUndo (key, poseOnly) {
+        const ctx = this.canvases.get(key).getContext('2d');
+        this.undoStack.push({key, data: poseOnly ? null : ctx.getImageData(0, 0, W, H), poses: this.copyPoses(key)});
+        if (this.undoStack.length > MAX_UNDO) this.undoStack.shift();
+        this.redoStack = [];
+    }
+
+    restore (from, to) {
+        const entry = from.pop();
+        if (!entry || !this.canvases.has(entry.key)) return;
+        const ctx = this.canvases.get(entry.key).getContext('2d');
+        to.push({key: entry.key, data: entry.data ? ctx.getImageData(0, 0, W, H) : null, poses: this.copyPoses(entry.key)});
+        if (entry.data) ctx.putImageData(entry.data, 0, 0);
+        if (entry.poses) this.poses.set(entry.key, entry.poses);
+        else this.poses.delete(entry.key);
+        this.setState(st => ({rigVersion: st.rigVersion + 1}));
+        const index = this.state.frames.findIndex(f => f.key === entry.key);
+        this.markDirty(entry.key, index >= 0 ? index : this.state.current);
+    }
+
+    undo () {
+        this.restore(this.undoStack, this.redoStack);
+    }
+
+    redo () {
+        this.restore(this.redoStack, this.undoStack);
+    }
+
+    markDirty (key, goTo) {
+        const frames = this.state.frames.map(f => (f.key === key ? {...f, dirty: true, thumb: this.makeThumb(key)} : f));
+        this.setState({frames, current: typeof goTo === 'number' ? goTo : this.state.current});
+    }
+
+    // ------------------------------------------------------------------ pointer tools
+
+    toCanvas (e) {
+        const rect = this.viewRef.current.getBoundingClientRect();
+        return {
+            x: Math.round((e.clientX - rect.left) * (W / rect.width)),
+            y: Math.round((e.clientY - rect.top) * (H / rect.height))
+        };
+    }
+
+    handlePointerDown (e) {
+        if (this.state.playing || this.state.loading || e.button !== 0) return;
+        const frame = this.currentFrame();
+        if (!frame) return;
+        e.currentTarget.setPointerCapture(e.pointerId);
+        const p = this.toCanvas(e);
+        const {tool, color, size} = this.state;
+        const ctx = this.canvases.get(frame.key).getContext('2d');
+        if (tool === 'stick') {
+            const poses = this.poses.get(frame.key);
+            let hit = null;
+            if (poses) {
+                for (let r = this.rigs.length - 1; r >= 0 && !hit; r--) {
+                    const rig = this.rigs[r];
+                    const pose = poses.get(rig.id);
+                    const handle = pose && Rig.hitTest(rig, pose, p.x, p.y, 22);
+                    if (handle) hit = {rig, handle};
+                }
+            }
+            if (!hit) {
+                this.setState({selectedRig: null});
+                return;
+            }
+            this.pushUndo(frame.key, true);
+            this.drag = {tool, rigId: hit.rig.id, handle: hit.handle, key: frame.key, x0: p.x, y0: p.y,
+                start: Rig.clonePose(poses.get(hit.rig.id))};
+            this.setState({selectedRig: hit.rig.id});
+            return;
+        }
+        if (tool === 'picker') {
+            const d = ctx.getImageData(Math.min(W - 1, Math.max(0, p.x)), Math.min(H - 1, Math.max(0, p.y)), 1, 1).data;
+            if (d[3] > 0) this.setState({color: rgbToHex(d[0], d[1], d[2]), tool: 'pencil'});
+            return;
+        }
+        if (tool === 'fill') {
+            if (p.x < 0 || p.y < 0 || p.x >= W || p.y >= H) return;
+            this.pushUndo(frame.key);
+            if (floodFill(ctx, p.x, p.y, color)) this.markDirty(frame.key);
+            else this.undoStack.pop();
+            return;
+        }
+        this.pushUndo(frame.key);
+        this.drag = {tool, x0: p.x, y0: p.y, x1: p.x, y1: p.y, last: p, key: frame.key};
+        if (tool === 'pencil' || tool === 'eraser') {
+            ctx.save();
+            ctx.globalCompositeOperation = tool === 'eraser' ? 'destination-out' : 'source-over';
+            ctx.fillStyle = color;
+            ctx.beginPath();
+            ctx.arc(p.x, p.y, (tool === 'eraser' ? size * 2 : size) / 2, 0, Math.PI * 2);
+            ctx.fill();
+            ctx.restore();
+            this.renderView();
+        }
+    }
+
+    handlePointerMove (e) {
+        if (!this.drag) return;
+        const p = this.toCanvas(e);
+        const d = this.drag;
+        const {color, size, filled} = this.state;
+        d.x1 = p.x;
+        d.y1 = p.y;
+        if (d.tool === 'stick') {
+            const poses = this.poses.get(d.key);
+            if (d.handle === 'hip') {
+                const moved = Rig.clonePose(d.start);
+                moved.x += p.x - d.x0;
+                moved.y += p.y - d.y0;
+                poses.set(d.rigId, moved);
+            } else {
+                poses.set(d.rigId, Rig.aimBone(poses.get(d.rigId), d.handle, p.x, p.y));
+            }
+            this.renderView();
+            return;
+        }
+        if (d.tool === 'pencil' || d.tool === 'eraser') {
+            const ctx = this.canvases.get(d.key).getContext('2d');
+            ctx.save();
+            ctx.globalCompositeOperation = d.tool === 'eraser' ? 'destination-out' : 'source-over';
+            ctx.strokeStyle = color;
+            ctx.lineWidth = d.tool === 'eraser' ? size * 2 : size;
+            ctx.lineCap = 'round';
+            ctx.lineJoin = 'round';
+            ctx.beginPath();
+            ctx.moveTo(d.last.x, d.last.y);
+            ctx.lineTo(p.x, p.y);
+            ctx.stroke();
+            ctx.restore();
+            d.last = p;
+            this.renderView();
