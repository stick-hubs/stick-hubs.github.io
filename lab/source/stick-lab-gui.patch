index 0000000..e9ce1e9
--- /dev/null
+++ b/src/components/sl-text-code/text-code-editor.jsx
@@ -0,0 +1,363 @@
+import React from 'react';
+import PropTypes from 'prop-types';
+import {connect} from 'react-redux';
+import classNames from 'classnames';
+import {getWorkspace, onWorkspaceChange} from '../../lib/sl-workspace-registry';
+import {workspaceToText} from '../../lib/sl-text-code/printer';
+import {applyText, commandList} from '../../lib/sl-text-code/apply';
+import {getCodeMode, onCodeModeChange, onBeforeCodeModeChange} from './code-mode-store';
+import styles from './text-code.css';
+
+const INDENT = '    ';
+
+const HELP = [
+    ['when_flag_clicked { ... }', 'A script. Every script starts with a "when" block.'],
+    ['move(10)', 'A command. Values go in ( ), separated by commas.'],
+    ['"hello"', 'Text and menu choices go in quotes.'],
+    ['$score   @items', '$ is a variable, @ is a list. Use $"my score" for names with spaces.'],
+    ['$score + 1   $x > 10', 'Maths: + - * / mod   Compare: > < ==   Logic: and or not'],
+    ['if ($x > 10) { } else { }', 'C blocks like if, repeat and forever use { }.'],
+    ['define "jump %s" (%height) { }', 'A custom block. Use it with call "jump %s" (50).'],
+    ['stack { ... }', 'Commands that aren\'t under a "when" block.'],
+    ['// note', 'A note for yourself. Stick Lab ignores it.']
+];
+
+class TextCodeEditor extends React.Component {
+    constructor (props) {
+        super(props);
+        this.state = {
+            mode: getCodeMode(),
+            text: '',
+            status: null,
+            errorLine: null,
+            groups: [],
+            openGroup: 0,
+            showHelp: false,
+            targetName: ''
+        };
+        this.lastAppliedText = null;
+        this.drafts = new Map();
+        this.textareaRef = React.createRef();
+        this.gutterRef = React.createRef();
+        this.handleChange = this.handleChange.bind(this);
+        this.handleKeyDown = this.handleKeyDown.bind(this);
+        this.handleBlur = this.handleBlur.bind(this);
+        this.handleScroll = this.handleScroll.bind(this);
+        this.handleWorkspaceUpdate = this.handleWorkspaceUpdate.bind(this);
+        this.handleToggleHelp = () => this.setState(s => ({showHelp: !s.showHelp}));
+        this.handleRefresh = this.handleRefresh.bind(this);
+    }
+    componentDidMount () {
+        this.unsubscribeMode = onCodeModeChange(mode => {
+            this.setState({mode});
+            if (mode === 'text') this.loadFromBlocks();
+        });
+        this.unsubscribeBefore = onBeforeCodeModeChange((from, to) => {
+            if (from === 'text' && to === 'blocks') return this.apply();
+            return true;
+        });
+        this.unsubscribeWorkspace = onWorkspaceChange(() => {
+            if (this.state.mode === 'text') setTimeout(() => this.loadFromBlocks(), 0);
+        });
+        this.props.vm.on('workspaceUpdate', this.handleWorkspaceUpdate);
+    }
+    componentDidUpdate (prevProps) {
+        if (prevProps.toolboxXML !== this.props.toolboxXML && this.state.mode === 'text') {
+            this.updateCommands();
+        }
+    }
+    componentWillUnmount () {
+        this.unsubscribeMode();
+        this.unsubscribeBefore();
+        this.unsubscribeWorkspace();
+        this.props.vm.removeListener('workspaceUpdate', this.handleWorkspaceUpdate);
+        clearTimeout(this.reloadTimeout);
+    }
+    getTargetId () {
+        return this.props.vm.editingTarget ? this.props.vm.editingTarget.id : null;
+    }
+    handleWorkspaceUpdate () {
+        // The editor switched to another sprite (or loaded a project). Keep unfinished text as a draft.
+        if (this.state.mode !== 'text') return;
+        if (this.loadedTargetId && this.state.text !== this.lastAppliedText && this.state.status &&
+            this.state.status.kind === 'error') {
+            this.drafts.set(this.loadedTargetId, this.state.text);
+        }
+        clearTimeout(this.reloadTimeout);
+        // Wait for the blocks workspace to show the new sprite first.
+        this.reloadTimeout = setTimeout(() => this.loadFromBlocks(), 120);
+    }
+    updateCommands () {
+        const ws = getWorkspace();
+        if (!ws) return;
+        try {
+            this.setState({groups: commandList(ws.ScratchBlocks, this.props.toolboxXML)});
+        } catch (e) {
+            this.setState({groups: []});
+        }
+    }
+    loadFromBlocks () {
+        const ws = getWorkspace();
+        if (!ws) return;
+        const targetId = this.getTargetId();
+        const target = this.props.vm.editingTarget;
+        this.loadedTargetId = targetId;
+        const draft = this.drafts.get(targetId);
+        let text;
+        try {
+            text = workspaceToText(ws.workspace, ws.ScratchBlocks).text;
+        } catch (e) {
+            text = `// Stick Lab couldn't show these scripts as text: ${e.message}\n`;
+        }
+        this.lastAppliedText = text;
+        if (draft) {
+            this.drafts.delete(targetId);
+            this.setState({
+                text: draft,
+                targetName: target ? target.getName() : '',
+                status: {kind: 'error', message: 'This text has a mistake, so it hasn\'t been turned into blocks yet.'}
+            });
+        } else {
+            this.setState({
+                text: text || '',
+                targetName: target ? target.getName() : '',
+                status: text ? null : {kind: 'info', message: 'No scripts yet. Try: when_flag_clicked { say("Hello!") }'},
+                errorLine: null
+            });
+        }
+        this.updateCommands();
+    }
+    /**
+     * Turn the text into blocks.
+     * @returns {boolean} false if the text has a mistake
+     */
+    apply () {
+        const ws = getWorkspace();
+        if (!ws) return true;
+        if (this.state.text === this.lastAppliedText) return true;
+        if (this.getTargetId() !== this.loadedTargetId) return true;
+        try {
+            const result = applyText(this.state.text, {
+                ScratchBlocks: ws.ScratchBlocks,
+                workspace: ws.workspace,
+                vm: this.props.vm,
+                toolboxXML: this.props.toolboxXML
+            });
+            this.lastAppliedText = this.state.text;
+            this.setState({
+                status: result.changed ? {kind: 'ok', message: 'Saved: your text is now blocks.'} : null,
+                errorLine: null
+            });
+            return true;
+        } catch (e) {
+            const message = e.line ? e.message : `Something went wrong: ${e.message}`;
+            this.setState({status: {kind: 'error', message}, errorLine: e.line || null});
+            if (!e.line) console.error(e); // eslint-disable-line no-console
+            return false;
+        }
+    }
+    handleRefresh () {
+        if (this.apply()) this.loadFromBlocks();
+    }
+    handleBlur () {
+        this.apply();
+    }
+    handleChange (e) {
+        this.setState({text: e.target.value});
+    }
+    handleScroll () {
+        if (this.gutterRef.current && this.textareaRef.current) {
+            this.gutterRef.current.scrollTop = this.textareaRef.current.scrollTop;
+        }
+    }
+    insertText (insert, selectionOffset) {
+        const ta = this.textareaRef.current;
+        if (!ta) return;
+        const {selectionStart, selectionEnd, value} = ta;
+        const next = value.slice(0, selectionStart) + insert + value.slice(selectionEnd);
+        const caret = selectionStart + (typeof selectionOffset === 'number' ? selectionOffset : insert.length);
+        this.setState({text: next}, () => {
+            ta.focus();
+            ta.selectionStart = ta.selectionEnd = caret;
+        });
+    }
+    handleKeyDown (e) {
+        const ta = e.target;
+        const {selectionStart, value} = ta;
+        const lineStart = value.lastIndexOf('\n', selectionStart - 1) + 1;
+        const currentIndent = /^[ \t]*/.exec(value.slice(lineStart))[0];
+        if (e.key === 'Tab') {
+            e.preventDefault();
+            this.insertText(INDENT);
+        } else if (e.key === 'Enter') {
+            e.preventDefault();
+            const before = value.slice(lineStart, selectionStart).trimEnd();
+            const after = value.slice(selectionStart, value.indexOf('\n', selectionStart) === -1 ?
+                value.length : value.indexOf('\n', selectionStart)).trim();
+            if (before.endsWith('{') && after.startsWith('}')) {
+                const inner = `\n${currentIndent}${INDENT}`;
+                this.insertText(`${inner}\n${currentIndent}`, inner.length);
+            } else {
+                this.insertText(`\n${currentIndent}${before.endsWith('{') ? INDENT : ''}`);
+            }
+        } else if (e.key === '}' && /^[ \t]+$/.test(value.slice(lineStart, selectionStart)) &&
+            value.slice(lineStart, selectionStart).length >= INDENT.length) {
+            e.preventDefault();
+            const newIndent = currentIndent.slice(0, -INDENT.length);
+            const next = `${value.slice(0, lineStart)}${newIndent}}${value.slice(selectionStart)}`;
+            const caret = lineStart + newIndent.length + 1;
+            this.setState({text: next}, () => {
+                ta.selectionStart = ta.selectionEnd = caret;
+            });
+        } else if ((e.ctrlKey || e.metaKey) && e.key === 's') {
+            this.apply();
+        }
+    }
+    handleInsertCommand (item) {
+        const ta = this.textareaRef.current;
+        if (!ta) return;
+        const {value, selectionStart} = ta;
+        const lineStart = value.lastIndexOf('\n', selectionStart - 1) + 1;
+        const lineText = value.slice(lineStart, selectionStart);
+        const indent = /^[ \t]*$/.test(lineText) ? lineText : '';
+        let insert = item.insert.split('\n').join(`\n${indent}`);
+        if (!/^[ \t]*$/.test(lineText)) insert = `\n${insert}`;
+        const blank = insert.indexOf(`${INDENT}\n`);
+        this.insertText(insert, blank === -1 ? insert.length : blank + INDENT.length);
+    }
+    render () {
+        if (this.state.mode !== 'text') return null;
+        const {text, status, errorLine, groups, openGroup, showHelp, targetName} = this.state;
+        const lineCount = Math.max(1, text.split('\n').length);
+        const lines = [];
+        for (let i = 1; i <= lineCount; i++) {
+            lines.push(
+                <div
+                    key={i}
+                    className={classNames(styles.lineNumber, {[styles.lineNumberError]: i === errorLine})}
+                >{i}</div>
+            );
+        }
+        return (
+            <div className={styles.overlay}>
+                <div className={styles.toolStrip} />
+                <div className={styles.commands}>
+                    <div className={styles.commandsTitle}>{'Commands'}</div>
+                    <div className={styles.commandsHint}>{'Click one to add it to your code.'}</div>
+                    <div className={styles.commandsScroll}>
+                        {groups.map((group, i) => (
+                            <div
+                                key={group.category}
+                                className={styles.group}
+                            >
+                                <button
+                                    className={styles.groupHeader}
+                                    style={{borderLeftColor: group.color}}
+                                    onClick={() => this.setState({openGroup: openGroup === i ? -1 : i})} // eslint-disable-line react/jsx-no-bind
+                                >
+                                    <span
+                                        className={styles.groupDot}
+                                        style={{background: group.color}}
+                                    />
+                                    {group.category}
+                                    <span className={styles.groupCaret}>{openGroup === i ? '▾' : '▸'}</span>
+                                </button>
+                                {openGroup === i ? group.items.map(item => (
+                                    <button
+                                        key={item.insert}
+                                        className={classNames(styles.command, {[styles.commandHat]: item.isHat})}
+                                        style={{borderLeftColor: group.color}}
+                                        title={item.insert}
+                                        onMouseDown={e => e.preventDefault()} // eslint-disable-line react/jsx-no-bind
+                                        onClick={() => this.handleInsertCommand(item)} // eslint-disable-line react/jsx-no-bind
+                                    >{item.label}</button>
+                                )) : null}
+                            </div>
+                        ))}
+                    </div>
+                </div>
+                <div className={styles.editorColumn}>
+                    <div className={styles.editorHeader}>
+                        <span className={styles.editorTitle}>
+                            {'Text coding'}
+                            {targetName ? <span className={styles.editorTarget}>{` · ${targetName}`}</span> : null}
+                        </span>
+                        <span className={styles.editorButtons}>
+                            <button
+                                className={styles.headerButton}
+                                title="Turn the text into blocks and tidy it up"
+                                onClick={this.handleRefresh}
+                            >{'Save & tidy'}</button>
+                            <button
+                                className={classNames(styles.headerButton, {[styles.headerButtonActive]: showHelp})}
+                                onClick={this.handleToggleHelp}
+                            >{'Help'}</button>
+                        </span>
+                    </div>
+                    {showHelp ? (
+                        <div className={styles.help}>
+                            {HELP.map(([code, desc]) => (
+                                <div
+                                    key={code}
+                                    className={styles.helpRow}
+                                >
+                                    <code>{code}</code>
+                                    <span>{desc}</span>
+                                </div>
+                            ))}
+                            <div className={styles.helpRow}>
+                                <span>
+                                    {'Your text turns into blocks when you click away from the editor, ' +
+                                    'press Ctrl+S, or switch back to Blocks.'}
+                                </span>
+                            </div>
+                        </div>
+                    ) : null}
+                    <div className={styles.editorBody}>
+                        <div
+                            className={styles.gutter}
+                            ref={this.gutterRef}
+                        >{lines}</div>
+                        <textarea
+                            autoCapitalize="off"
+                            autoComplete="off"
+                            autoCorrect="off"
+                            className={styles.textarea}
+                            ref={this.textareaRef}
+                            spellCheck={false}
+                            value={text}
+                            wrap="off"
+                            onBlur={this.handleBlur}
+                            onChange={this.handleChange}
+                            onKeyDown={this.handleKeyDown}
+                            onScroll={this.handleScroll}
+                        />
+                    </div>
+                    {status ? (
+                        <div
+                            className={classNames(styles.status, {
+                                [styles.statusError]: status.kind === 'error',
+                                [styles.statusOk]: status.kind === 'ok'
+                            })}
+                        >{status.message}</div>
+                    ) : null}
+                </div>
+            </div>
+        );
+    }
+}
+
+TextCodeEditor.propTypes = {
+    toolboxXML: PropTypes.string,
+    vm: PropTypes.shape({
+        editingTarget: PropTypes.object,
+        on: PropTypes.func,
+        removeListener: PropTypes.func
+    }).isRequired
+};
+
+const mapStateToProps = state => ({
+    toolboxXML: state.scratchGui.toolbox.toolboxXML
+});
+
+export default connect(mapStateToProps)(TextCodeEditor);
