@@ -0,0 +1,21 @@
+// Stick Lab Duo: is the chat panel open?
+let open = false;
+const listeners = new Set();
+
+const isDuoOpen = () => open;
+const setDuoOpen = value => {
+    open = !!value;
+    listeners.forEach(fn => fn(open));
+};
+const toggleDuo = () => setDuoOpen(!open);
+const onDuoChange = fn => {
+    listeners.add(fn);
+    return () => listeners.delete(fn);
+};
+
+export {
+    isDuoOpen,
+    setDuoOpen,
+    toggleDuo,
+    onDuoChange
+};
