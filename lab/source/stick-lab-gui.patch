+    platform: () => ({svg: '<svg xmlns="http://www.w3.org/2000/svg" width="160" height="24" viewBox="0 0 160 24"><rect x="0" y="0" width="160" height="24" rx="4" fill="#8a5a32"/><rect x="0" y="0" width="160" height="8" rx="4" fill="#4caf50"/></svg>', cx: 80, cy: 12}),
+    flag: () => ({svg: '<svg xmlns="http://www.w3.org/2000/svg" width="44" height="70" viewBox="0 0 44 70"><rect x="6" y="2" width="5" height="66" fill="#6b4a2b"/><path d="M11 4 L42 13 L11 22 Z" fill="#e53935"/></svg>', cx: 8, cy: 66})
