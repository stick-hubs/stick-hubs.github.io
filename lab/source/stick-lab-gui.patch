+// Stick Lab 1.3: is the Publish window open?
+let open = false;
+const listeners = new Set();
+const isPublishOpen = () => open;
+const setPublishOpen = value => {
+    open = !!value;
+    listeners.forEach(fn => fn(open));
+};
+const onPublishChange = fn => {
+    listeners.add(fn);
+    return () => listeners.delete(fn);
+};
+export {isPublishOpen, setPublishOpen, onPublishChange};
