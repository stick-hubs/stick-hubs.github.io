+            const sprites = vm.runtime.targets.filter(t => t.isOriginal && !t.isStage).map(t => t.getName());
+            lines.push('', `The user is editing: ${target.isStage ? 'the Stage' : `the sprite "${target.getName()}"`}.`);
+            lines.push(`Sprites in the project: ${sprites.join(', ') || 'none'}.`);
