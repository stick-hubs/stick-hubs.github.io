@@ -0,0 +1,550 @@
+// Stick Lab 1.3: a tile level editor. Paint a level from tiles; it saves as a costume (or backdrop)
+// plus a list "<name> map" that scripts can read with the "tile at x y" block.
+import React from 'react';
+import PropTypes from 'prop-types';
+import classNames from 'classnames';
+import styles from './level.css';
+import {T, COLS, ROWS, SOLID, TILES, BACKGROUNDS, drawLevel, starterRows, emptyRows} from './tiles';
+
+const W = COLS * T;
+const H = ROWS * T;
+const MAX_UNDO = 40;
+const PROCCODE = 'tile at x %s y %s';
+
+const TOOLS = [
+    {id: 'paint', label: 'Paint', icon: 'M4 20 L7 19 L19 7 L17 5 L5 17 Z'},
+    {id: 'erase', label: 'Erase', icon: 'M8 20 H20 M4 16 L14 6 L19 11 L11 19 H8 Z'},
+    {id: 'rect', label: 'Box', icon: 'M4 6 H20 V18 H4 Z'},
+    {id: 'fill', label: 'Fill', icon: 'M5 12 L12 5 L19 12 L12 19 Z M19 14 C 21 17, 17 17, 19 14'}
+];
+
+const isLevelList = v => v.type === 'list' && / map$/.test(v.name) && Array.isArray(v.value) &&
+    v.value.length >= ROWS && v.value.slice(0, ROWS).every(r => typeof r === 'string' && r.length === COLS);
+
+const levelLists = vm => Object.values(vm.runtime.getTargetForStage().variables).filter(isLevelList);
+
+const uid = () => `sl${Math.random().toString(36).slice(2, 10)}${Date.now().toString(36).slice(-4)}`;
+
+class LevelEditor extends React.Component {
+    constructor (props) {
+        super(props);
+        const stage = props.vm.runtime.getTargetForStage();
+        const existing = levelLists(props.vm);
+        const sprites = props.vm.runtime.targets.filter(t => t.isOriginal && !t.isStage);
+        let name = 'level1';
+        let n = 1;
+        const taken = new Set(existing.map(v => v.name.replace(/ map$/, '')));
+        while (taken.has(name)) name = `level${++n}`;
+        this.state = {
+            name,
+            rows: starterRows(),
+            background: 'day',
+            tile: 'G',
+            tool: 'paint',
+            existing: existing.map(v => v.name.replace(/ map$/, '')),
+            helperFor: sprites.length ? sprites[0].id : '',
+            addHelper: sprites.length > 0,
+            sprites: sprites.map(t => ({id: t.id, name: t.getName()})),
+            onStage: props.vm.editingTarget === stage,
+            saving: false,
+            message: null,
+            hover: null,
+            dragRect: null
+        };
+        this.undo = [];
+        this.canvasRef = React.createRef();
+        this.painting = false;
+        this.handlePointerDown = this.handlePointerDown.bind(this);
+        this.handlePointerMove = this.handlePointerMove.bind(this);
+        this.handlePointerUp = this.handlePointerUp.bind(this);
+        this.handleSave = this.handleSave.bind(this);
+        this.handleClose = this.handleClose.bind(this);
+        this.handleUndo = this.handleUndo.bind(this);
+        this.handleKey = this.handleKey.bind(this);
+        this.dirty = false;
+    }
+    componentDidMount () {
+        this.redraw();
+        window.addEventListener('pointerup', this.handlePointerUp);
+        window.addEventListener('keydown', this.handleKey);
+    }
+    componentDidUpdate () {
+        this.redraw();
+    }
+    componentWillUnmount () {
+        window.removeEventListener('pointerup', this.handlePointerUp);
+        window.removeEventListener('keydown', this.handleKey);
+    }
+    handleKey (e) {
+        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
+            e.preventDefault();
+            this.handleUndo();
+        }
+    }
+    redraw () {
+        const canvas = this.canvasRef.current;
+        if (!canvas) return;
+        const ctx = canvas.getContext('2d');
+        let rows = this.state.rows;
+        const r = this.state.dragRect;
+        if (r) rows = this.applyRect(rows, r, this.state.tool === 'erase' ? '.' : this.state.tile);
+        drawLevel(ctx, rows, this.state.background, {grid: true});
+        const h = this.state.hover;
+        if (h && !r) {
+            ctx.strokeStyle = '#ffffff';
+            ctx.lineWidth = 3;
+            ctx.strokeRect(h.c * T + 1.5, h.r * T + 1.5, T - 3, T - 3);
+            ctx.strokeStyle = '#1b4f8f';
+            ctx.lineWidth = 1;
+            ctx.strokeRect(h.c * T + 0.5, h.r * T + 0.5, T - 1, T - 1);
+        }
+    }
+    cellAt (e) {
+        const box = this.canvasRef.current.getBoundingClientRect();
+        const c = Math.floor((e.clientX - box.left) / box.width * COLS);
+        const r = Math.floor((e.clientY - box.top) / box.height * ROWS);
+        if (c < 0 || r < 0 || c >= COLS || r >= ROWS) return null;
+        return {c, r};
+    }
+    pushUndo () {
+        this.undo.push(this.state.rows);
+        if (this.undo.length > MAX_UNDO) this.undo.shift();
+    }
+    setCell (rows, {c, r}, ch) {
+        if (rows[r][c] === ch) return rows;
+        const next = rows.slice();
+        next[r] = next[r].slice(0, c) + ch + next[r].slice(c + 1);
+        return next;
+    }
+    applyRect (rows, {a, b}, ch) {
+        let next = rows;
+        for (let r = Math.min(a.r, b.r); r <= Math.max(a.r, b.r); r++) {
+            for (let c = Math.min(a.c, b.c); c <= Math.max(a.c, b.c); c++) {
+                next = this.setCell(next, {c, r}, ch);
+            }
+        }
+        return next;
+    }
+    floodFill (rows, start, ch) {
+        const from = rows[start.r][start.c];
+        if (from === ch) return rows;
+        const grid = rows.map(r => r.split(''));
+        const stack = [start];
+        while (stack.length) {
+            const {c, r} = stack.pop();
+            if (c < 0 || r < 0 || c >= COLS || r >= ROWS || grid[r][c] !== from) continue;
+            grid[r][c] = ch;
+            stack.push({c: c + 1, r}, {c: c - 1, r}, {c, r: r + 1}, {c, r: r - 1});
+        }
+        return grid.map(r => r.join(''));
+    }
+    handlePointerDown (e) {
+        const cell = this.cellAt(e);
+        if (!cell) return;
+        e.preventDefault();
+        const {tool, tile} = this.state;
+        const ch = tool === 'erase' || e.button === 2 ? '.' : tile;
+        this.pushUndo();
+        this.dirty = true;
+        if (tool === 'fill') {
+            this.setState(s => ({rows: this.floodFill(s.rows, cell, ch)}));
+            return;
+        }
+        if (tool === 'rect') {
+            this.setState({dragRect: {a: cell, b: cell}});
+            return;
+        }
+        this.painting = ch;
+        this.setState(s => ({rows: this.setCell(s.rows, cell, ch)}));
+    }
+    handlePointerMove (e) {
+        const cell = this.cellAt(e);
+        if (this.state.dragRect && cell) {
+            this.setState(s => ({dragRect: {a: s.dragRect.a, b: cell}}));
+            return;
+        }
+        if (this.painting !== false && cell) {
+            const ch = this.painting;
+            this.setState(s => ({rows: this.setCell(s.rows, cell, ch), hover: cell}));
+            return;
+        }
+        const h = this.state.hover;
+        if (!cell && h) this.setState({hover: null});
+        else if (cell && (!h || h.c !== cell.c || h.r !== cell.r)) this.setState({hover: cell});
+    }
+    handlePointerUp () {
+        this.painting = false;
+        if (this.state.dragRect) {
+            const ch = this.state.tool === 'erase' ? '.' : this.state.tile;
+            this.setState(s => ({rows: this.applyRect(s.rows, s.dragRect, ch), dragRect: null}));
+        }
+    }
+    handleUndo () {
+        if (!this.undo.length) return;
+        this.setState({rows: this.undo.pop()});
+    }
+    handleClear () {
+        this.pushUndo();
+        this.dirty = true;
+        this.setState({rows: emptyRows()});
+    }
+    handleOpen (name) {
+        const list = levelLists(this.props.vm).find(v => v.name === `${name} map`);
+        if (!list) return;
+        const bgItem = list.value.find(v => typeof v === 'string' && v.startsWith('bg:'));
+        const bg = bgItem ? bgItem.slice(3) : 'day';
+        this.undo = [];
+        this.dirty = false;
+        this.setState({
+            name,
+            rows: list.value.slice(0, ROWS),
+            background: BACKGROUNDS.some(b => b.id === bg) ? bg : 'day',
+            message: `Opened ${name}.`
+        });
+    }
+    handleClose () {
+        // eslint-disable-next-line no-alert
+        if (this.dirty && !window.confirm('Close the level editor without saving?')) return;
+        this.props.onClose(false);
+    }
+
+    // ------------------------------------------------------------------ saving
+
+    async handleSave () {
+        const vm = this.props.vm;
+        const target = vm.editingTarget;
+        const name = this.state.name.trim().replace(/\s+/g, ' ').slice(0, 40);
+        if (!target || this.state.saving) return;
+        if (!name) {
+            this.setState({message: 'Give your level a name first.'});
+            return;
+        }
+        this.setState({saving: true, message: 'Saving your level...'});
+        try {
+            const canvas = document.createElement('canvas');
+            canvas.width = W;
+            canvas.height = H;
+            const ctx = canvas.getContext('2d');
+            drawLevel(ctx, this.state.rows, this.state.background);
+            const costumes = target.getCostumes();
+            let index = costumes.findIndex(c => c.name === name);
+            if (index !== -1 && costumes[index].dataFormat !== 'svg') {
+                vm.updateBitmap(index, ctx.getImageData(0, 0, W, H), W / 2, H / 2, 2);
+            } else {
+                const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
+                const data = new Uint8Array(await blob.arrayBuffer());
+                const storage = vm.runtime.storage;
+                const asset = storage.createAsset(storage.AssetType.ImageBitmap, storage.DataFormat.PNG, data, null, true);
+                const finalName = index !== -1 ? `${name} level` : name;
+                await vm.addCostume(`${asset.assetId}.png`, {
+                    name: finalName,
+                    dataFormat: 'png',
+                    asset,
+                    assetId: asset.assetId,
+                    md5: `${asset.assetId}.png`,
+                    bitmapResolution: 2,
+                    rotationCenterX: W / 2,
+                    rotationCenterY: H / 2
+                }, target.id);
+                index = target.getCostumes().findIndex(c => c.name === finalName);
+            }
+            if (index !== -1) target.setCostume(index);
+
+            // the map list, on the Stage so every sprite can read it
+            const stage = vm.runtime.getTargetForStage();
+            const listName = `${name} map`;
+            let list = stage.lookupVariableByNameAndType(listName, 'list');
+            if (!list) {
+                stage.createVariable(uid(), listName, 'list');
+                list = stage.lookupVariableByNameAndType(listName, 'list');
+            }
+            list.value = this.state.rows.concat(`bg:${this.state.background}`);
+            list._monitorUpToDate = false;
+
+            let note = '';
+            if (this.state.addHelper && this.state.helperFor) {
+                note = await this.addHelper(this.state.helperFor, list);
+            }
+            vm.emitTargetsUpdate();
+            vm.emitWorkspaceUpdate();
+            vm.runtime.emitProjectChanged();
+            this.dirty = false;
+            this.props.onClose(true, `Saved "${name}" as a ${target.isStage ? 'backdrop' : 'costume'} and the list "${listName}".${note}`);
+        } catch (e) {
+            console.error(e); // eslint-disable-line no-console
+            this.setState({saving: false, message: `Couldn't save the level: ${e.message}`});
+        }
+    }
+
+    // Adds the "tile at x () y ()" custom block to a sprite. It sets the variables "tile" (the tile's letter or
+    // symbol) and "solid" (true for solid tiles) for the point (x, y) on the stage.
+    async addHelper (spriteId, list) {
+        const vm = this.props.vm;
+        const sprite = vm.runtime.getTargetById(spriteId);
+        const stage = vm.runtime.getTargetForStage();
+        if (!sprite) return '';
+        const already = Object.values(sprite.blocks._blocks).some(b => b.opcode === 'procedures_prototype' &&
+            b.mutation && b.mutation.proccode === PROCCODE);
+        if (already) return ` "${sprite.getName()}" already has the "tile at x y" block.`;
+        const variable = name => {
+            let v = stage.lookupVariableByNameAndType(name, '');
+            if (!v) {
+                stage.createVariable(uid(), name, '');
+                v = stage.lookupVariableByNameAndType(name, '');
+            }
+            return v;
+        };
+        const tileVar = variable('tile');
+        const solidVar = variable('solid');
+
+        const blocks = [];
+        const make = (opcode, parent, extra = {}) => {
+            const block = {id: uid(), opcode, inputs: {}, fields: {}, next: null, parent,
+                shadow: false, topLevel: false, ...extra};
+            blocks.push(block);
+            return block;
+        };
+        // put a value in an input: a number/text shadow, or a reporter block over a shadow
+        const input = (block, name, value, shadowOpcode, field) => {
+            const shadow = make(shadowOpcode, block.id, {shadow: true,
+                fields: {[field]: {name: field, value: typeof value === 'function' ? (shadowOpcode === 'text' ? '' : '0') : String(value)}}});
+            if (typeof value === 'function') {
+                const reporter = value(block.id);
+                block.inputs[name] = {name, block: reporter.id, shadow: shadow.id};
+            } else {
+                block.inputs[name] = {name, block: shadow.id, shadow: shadow.id};
+            }
+        };
+        const argIds = [uid(), uid()];
+        const arg = name => parent => make('argument_reporter_string_number', parent,
+            {fields: {VALUE: {name: 'VALUE', value: name}}});
+        const op = (opcode, a, b, names = ['NUM1', 'NUM2']) => parent => {
+            const block = make(opcode, parent);
+            input(block, names[0], a, 'math_number', 'NUM');
+            input(block, names[1], b, 'math_number', 'NUM');
+            return block;
+        };
+        const floor = value => parent => {
+            const block = make('operator_mathop', parent, {fields: {OPERATOR: {name: 'OPERATOR', value: 'floor'}}});
+            input(block, 'NUM', value, 'math_number', 'NUM');
+            return block;
+        };
+        // column = floor((x + 240) / 20) + 1, row = floor((180 - y) / 20) + 1
+        const column = op('operator_add', floor(op('operator_divide', op('operator_add', arg('x'), 240), 20)), 1);
+        const row = op('operator_add', floor(op('operator_divide', op('operator_subtract', 180, arg('y')), 20)), 1);
+        const itemOfList = parent => {
+            const block = make('data_itemoflist', parent, {fields: {LIST: {name: 'LIST', id: list.id, value: list.name}}});
+            input(block, 'INDEX', row, 'math_integer', 'NUM');
+            return block;
+        };
+        const letterOf = parent => {
+            const block = make('operator_letter_of', parent);
+            input(block, 'LETTER', column, 'math_whole_number', 'NUM');
+            input(block, 'STRING', itemOfList, 'text', 'TEXT');
+            return block;
+        };
+        const tileReporter = parent => make('data_variable', parent,
+            {fields: {VARIABLE: {name: 'VARIABLE', id: tileVar.id, value: tileVar.name}}});
+        const contains = parent => {
+            const block = make('operator_contains', parent);
+            input(block, 'STRING1', SOLID, 'text', 'TEXT');
+            input(block, 'STRING2', tileReporter, 'text', 'TEXT');
+            return block;
+        };
+
+        const definition = make('procedures_definition', null, {topLevel: true, x: 520, y: 40});
+        const prototype = make('procedures_prototype', definition.id, {
+            shadow: true,
+            mutation: {
+                tagName: 'mutation', children: [], proccode: PROCCODE,
+                argumentids: JSON.stringify(argIds), argumentnames: JSON.stringify(['x', 'y']),
+                argumentdefaults: JSON.stringify(['', '']), warp: 'true'
+            }
+        });
+        definition.inputs.custom_block = {name: 'custom_block', block: prototype.id, shadow: prototype.id};
+        ['x', 'y'].forEach((name, i) => {
+            const reporter = make('argument_reporter_string_number', prototype.id,
+                {shadow: true, fields: {VALUE: {name: 'VALUE', value: name}}});
+            prototype.inputs[argIds[i]] = {name: argIds[i], block: reporter.id, shadow: reporter.id};
+        });
+        const setTile = make('data_setvariableto', definition.id,
+            {fields: {VARIABLE: {name: 'VARIABLE', id: tileVar.id, value: tileVar.name}}});
+        input(setTile, 'VALUE', letterOf, 'text', 'TEXT');
+        definition.next = setTile.id;
+        const setSolid = make('data_setvariableto', setTile.id,
+            {fields: {VARIABLE: {name: 'VARIABLE', id: solidVar.id, value: solidVar.name}}});
+        input(setSolid, 'VALUE', contains, 'text', 'TEXT');
+        setTile.next = setSolid.id;
+
+        await vm.shareBlocksToTarget(blocks, sprite.id);
+        return ` Added the "tile at x y" block to "${sprite.getName()}".`;
+    }
+
+    // ------------------------------------------------------------------ UI
+
+    renderTileButton (tile) {
+        return (
+            <button
+                key={tile.ch}
+                className={classNames(styles.tile, {[styles.tileActive]: this.state.tile === tile.ch && this.state.tool !== 'erase'})}
+                title={`${tile.name} (${tile.ch})${SOLID.includes(tile.ch) ? ' · solid' : ''}`}
+                onClick={() => this.setState(s => ({tile: tile.ch, tool: s.tool === 'erase' ? 'paint' : s.tool}))} // eslint-disable-line react/jsx-no-bind
+            >
+                <canvas
+                    height={T}
+                    ref={el => { // eslint-disable-line react/jsx-no-bind
+                        if (el) {
+                            const ctx = el.getContext('2d');
+                            ctx.clearRect(0, 0, T, T);
+                            tile.draw(ctx, 0, 0);
+                        }
+                    }}
+                    width={T}
+                />
+                <span>{tile.name}</span>
+            </button>
+        );
+    }
+    render () {
+        const {name, background, tool, existing, sprites, addHelper, helperFor, saving, message, onStage} = this.state;
+        return (
+            <div className={styles.level}>
+                <div className={styles.topBar}>
+                    <span className={styles.title}>{'Level editor'}</span>
+                    <label className={styles.topField}>
+                        {'Name'}
+                        <input
+                            className={styles.nameInput}
+                            maxLength={40}
+                            value={name}
+                            onChange={e => this.setState({name: e.target.value})} // eslint-disable-line react/jsx-no-bind
+                        />
+                    </label>
+                    <label className={styles.topField}>
+                        {'Background'}
+                        <select
+                            value={background}
+                            onChange={e => { // eslint-disable-line react/jsx-no-bind
+                                this.dirty = true;
+                                this.setState({background: e.target.value});
+                            }}
+                        >
+                            {BACKGROUNDS.map(b => <option key={b.id} value={b.id}>{b.name}</option>)}
+                        </select>
+                    </label>
+                    {existing.length ? (
+                        <label className={styles.topField}>
+                            {'Open'}
+                            <select
+                                value=""
+                                onChange={e => this.handleOpen(e.target.value)} // eslint-disable-line react/jsx-no-bind
+                            >
+                                <option value="">{'a saved level...'}</option>
+                                {existing.map(n => <option key={n} value={n}>{n}</option>)}
+                            </select>
+                        </label>
+                    ) : null}
+                    <span className={styles.spacer} />
+                    <button
+                        className={styles.saveButton}
+                        disabled={saving}
+                        onClick={this.handleSave}
+                    >{saving ? 'Saving...' : 'Save level'}</button>
+                    <button
+                        className={styles.closeButton}
+                        disabled={saving}
+                        onClick={this.handleClose}
+                    >{'Close'}</button>
+                </div>
+                <div className={styles.main}>
+                    <div className={styles.side}>
+                        <div className={styles.sideTitle}>{'Tools'}</div>
+                        <div className={styles.tools}>
+                            {TOOLS.map(t => (
+                                <button
+                                    key={t.id}
+                                    className={classNames(styles.tool, {[styles.toolActive]: tool === t.id})}
+                                    onClick={() => this.setState({tool: t.id})} // eslint-disable-line react/jsx-no-bind
+                                >
+                                    <svg
+                                        aria-hidden="true"
+                                        height="16"
+                                        viewBox="0 0 24 24"
+                                        width="16"
+                                    ><path
+                                        d={t.icon}
+                                        fill="none"
+                                        stroke="currentColor"
+                                        strokeLinejoin="round"
+                                        strokeWidth="2"
+                                    /></svg>
+                                    {t.label}
+                                </button>
+                            ))}
+                            <button
+                                className={styles.tool}
+                                onClick={this.handleUndo}
+                            >{'↶ Undo'}</button>
+                            <button
+                                className={styles.tool}
+                                onClick={() => this.handleClear()} // eslint-disable-line react/jsx-no-bind
+                            >{'Clear'}</button>
+                        </div>
+                        <div className={styles.sideTitle}>{'Tiles'}</div>
+                        <div className={styles.tiles}>{TILES.map(t => this.renderTileButton(t))}</div>
+                    </div>
+                    <div className={styles.center}>
+                        <div className={styles.canvasWrap}>
+                            <canvas
+                                className={styles.canvas}
+                                height={H}
+                                ref={this.canvasRef}
+                                width={W}
+                                onContextMenu={e => e.preventDefault()} // eslint-disable-line react/jsx-no-bind
+                                onPointerDown={this.handlePointerDown}
+                                onPointerLeave={() => this.setState({hover: null})} // eslint-disable-line react/jsx-no-bind
+                                onPointerMove={this.handlePointerMove}
+                            />
+                        </div>
+                        <div className={styles.bottom}>
+                            {sprites.length ? (
+                                <label className={styles.helper}>
+                                    <input
+                                        checked={addHelper}
+                                        type="checkbox"
+                                        onChange={e => this.setState({addHelper: e.target.checked})} // eslint-disable-line react/jsx-no-bind
+                                    />
+                                    {'Add the "tile at x () y ()" block to'}
+                                    <select
+                                        value={helperFor}
+                                        onChange={e => this.setState({helperFor: e.target.value})} // eslint-disable-line react/jsx-no-bind
+                                    >
+                                        {sprites.map(s => <option key={s.id} value={s.id}>{s.name}</option>)}
+                                    </select>
+                                </label>
+                            ) : null}
+                            <div className={styles.note}>
+                                {message || (onStage ?
+                                    'Click or drag to paint. Right-click erases. The level is saved as a backdrop.' :
+                                    'Tip: levels work best as Stage backdrops. Select the Stage, then open the level editor there.')}
+                            </div>
+                            <div className={styles.note}>
+                                {'In scripts: "tile at x y" sets "tile" to the tile\'s letter and "solid" to true for ground, brick, stone, wood, ice and bonus blocks.'}
+                            </div>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        );
+    }
+}
+
+LevelEditor.propTypes = {
+    onClose: PropTypes.func.isRequired,
+    vm: PropTypes.shape({
+        editingTarget: PropTypes.object,
+        runtime: PropTypes.object
+    }).isRequired
+};
+
+export default LevelEditor;
diff --git a/src/components/sl-level/level.css b/src/components/sl-level/level.css
new file mode 100644
index 0000000..fc324d0
--- /dev/null
+++ b/src/components/sl-level/level.css
@@ -0,0 +1,203 @@
+/* Stick Lab 1.3 level editor (Aero style) */
+
+.level {
+    position: absolute;
+    inset: 0;
+    z-index: 60;
+    display: flex;
+    flex-direction: column;
+    background: #dfe8f3;
+    font-family: Verdana, Tahoma, "Segoe UI", sans-serif;
+    font-size: 0.75rem;
+    color: #1f3550;
+    border: 1px solid #9db4cf;
+    border-radius: 3px;
+}
+
+.top-bar {
+    display: flex;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 0.75rem;
+    padding: 0.4rem 0.6rem;
+    background: linear-gradient(180deg, #a3d2f7 0%, #62a7e8 46%, #2a6ab8 50%, #3283d6 100%);
+    color: #ffffff;
+    border-bottom: 1px solid #1b4f8f;
+}
+
+.title {
+    font: bold 1rem "Trebuchet MS", "Segoe UI", Verdana, sans-serif;
+    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.3);
+}
+
+.top-field {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.35rem;
+    font-weight: bold;
+    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.25);
+}
+
+.top-field select,
+.name-input,
+.helper select {
+    border: 1px solid #1b4f8f;
+    border-radius: 3px;
+    padding: 0.15rem 0.3rem;
+    font: 0.75rem Verdana, Tahoma, sans-serif;
+    color: #1f3550;
+    background: #ffffff;
+}
+
+.name-input {
+    width: 7.5rem;
+}
+
+.spacer {
+    flex: 1;
+}
+
+.save-button,
+.close-button {
+    padding: 0.3rem 0.9rem;
+    border-radius: 4px;
+    font: bold 0.8rem "Trebuchet MS", "Segoe UI", Verdana, sans-serif;
+    cursor: pointer;
+}
+
+.save-button {
+    border: 1px solid #1b6a2a;
+    background: linear-gradient(180deg, #a6e69a 0%, #5cc14f 45%, #2f9a2a 50%, #46b53d 100%);
+    color: #ffffff;
+    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.3);
+    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
+}
+
+.close-button {
+    border: 1px solid rgba(255, 255, 255, 0.7);
+    background: rgba(255, 255, 255, 0.18);
+    color: #ffffff;
+}
+
+.main {
+    flex: 1;
+    min-height: 0;
+    display: flex;
+}
+
+.side {
+    width: 11.5rem;
+    padding: 0.5rem;
+    overflow-y: auto;
+    background: linear-gradient(180deg, #f7fafd 0%, #e6eef8 100%);
+    border-right: 1px solid #b6c8de;
+}
+
+.side-title {
+    margin: 0.3rem 0 0.35rem;
+    font-weight: bold;
+    color: #2a5a94;
+}
+
+.tools {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 0.3rem;
+}
+
+.tool {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.3rem;
+    padding: 0.28rem 0.35rem;
+    border: 1px solid #9db4cf;
+    border-radius: 3px;
+    background: linear-gradient(180deg, #ffffff 0%, #edf3fa 49%, #dde8f5 50%, #e8f0f9 100%);
+    color: #1f3550;
+    font: 0.72rem Verdana, Tahoma, sans-serif;
+    cursor: pointer;
+}
+
+.tool-active {
+    border-color: #1b4f8f;
+    background: linear-gradient(180deg, #d6ecff 0%, #a9d3f7 49%, #7fbcef 50%, #a6d2f6 100%);
+    font-weight: bold;
+}
+
+.tiles {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 0.3rem;
+}
+
+.tile {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 0.15rem;
+    padding: 0.3rem 0.2rem;
+    border: 1px solid #c3d3e6;
+    border-radius: 4px;
+    background: #ffffff;
+    color: #1f3550;
+    font: 0.66rem Verdana, Tahoma, sans-serif;
+    cursor: pointer;
+}
+
+.tile canvas {
+    width: 30px;
+    height: 30px;
+    background: repeating-conic-gradient(#eef2f6 0% 25%, #ffffff 0% 50%) 50% / 10px 10px;
+}
+
+.tile-active {
+    border: 2px solid #2a6ab8;
+    padding: calc(0.3rem - 1px) calc(0.2rem - 1px);
+    background: #e3f1ff;
+}
+
+.center {
+    flex: 1;
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+    padding: 0.5rem;
+    gap: 0.4rem;
+}
+
+.canvas-wrap {
+    flex: 1;
+    min-height: 0;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+}
+
+.canvas {
+    max-width: 100%;
+    max-height: 100%;
+    aspect-ratio: 4 / 3;
+    border: 1px solid #5f7fa6;
+    box-shadow: 0 2px 8px rgba(20, 50, 90, 0.25);
+    background: repeating-conic-gradient(#eef2f6 0% 25%, #ffffff 0% 50%) 50% / 20px 20px;
+    cursor: crosshair;
+    touch-action: none;
+}
+
+.bottom {
+    display: flex;
+    flex-direction: column;
+    gap: 0.25rem;
+}
+
+.helper {
+    display: flex;
+    align-items: center;
+    gap: 0.35rem;
+    font-weight: bold;
+}
+
+.note {
+    color: #4a6280;
+    font-size: 0.7rem;
+}
diff --git a/src/components/sl-level/tiles.js b/src/components/sl-level/tiles.js
new file mode 100644
index 0000000..e1cf04e
--- /dev/null
+++ b/src/components/sl-level/tiles.js
@@ -0,0 +1,255 @@
+// Stick Lab 1.3 level editor: tiles and backgrounds, drawn at 2x (a tile is 40x40 px, 20x20 on the stage).
+
+const T = 40;
+const COLS = 24;
+const ROWS = 18;
+
+// Letters are solid tiles; symbols are not. The "tile at x y" block sets "solid" from this.
+const SOLID = 'GDBSWIQ';
+
+const rect = (ctx, x, y, w, h, c) => {
+    ctx.fillStyle = c;
+    ctx.fillRect(x, y, w, h);
+};
+
+const TILES = [
+    {ch: 'G', name: 'Grass', draw (ctx, x, y) {
+        rect(ctx, x, y, T, T, '#8a5a32');
+        rect(ctx, x, y + 26, T, 14, '#76492a');
+        rect(ctx, x, y, T, 11, '#4caf50');
+        rect(ctx, x, y + 11, T, 3, '#388e3c');
+        ctx.fillStyle = '#6fd36f';
+        for (let i = 0; i < 5; i++) ctx.fillRect(x + 3 + i * 8, y + 2, 3, 4);
+        ctx.fillStyle = '#a0703f';
+        ctx.fillRect(x + 8, y + 20, 5, 4);
+        ctx.fillRect(x + 26, y + 30, 6, 4);
+    }},
+    {ch: 'D', name: 'Dirt', draw (ctx, x, y) {
+        rect(ctx, x, y, T, T, '#8a5a32');
+        ctx.fillStyle = '#a0703f';
+        ctx.fillRect(x + 6, y + 8, 6, 5);
+        ctx.fillRect(x + 24, y + 18, 7, 5);
+        ctx.fillRect(x + 12, y + 29, 6, 4);
+        ctx.fillStyle = '#6e4526';
+        ctx.fillRect(x + 28, y + 5, 5, 4);
+        ctx.fillRect(x + 4, y + 22, 5, 4);
+    }},
+    {ch: 'B', name: 'Brick', draw (ctx, x, y) {
+        rect(ctx, x, y, T, T, '#e0d2c0');
+        ctx.fillStyle = '#c0533a';
+        for (let r = 0; r < 4; r++) {
+            const off = r % 2 ? -10 : 0;
+            for (let c = 0; c < 3; c++) {
+                const bx = x + off + c * 20 + 1;
+                const x0 = Math.max(bx, x);
+                const x1 = Math.min(bx + 18, x + T);
+                if (x1 > x0) ctx.fillRect(x0, y + r * 10 + 1, x1 - x0, 8);
+            }
+        }
+        ctx.fillStyle = 'rgba(255,255,255,0.18)';
+        ctx.fillRect(x, y + 1, T, 2);
+    }},
+    {ch: 'S', name: 'Stone', draw (ctx, x, y) {
+        rect(ctx, x, y, T, T, '#8d939a');
+        rect(ctx, x, y, T, 3, '#b3b9bf');
+        rect(ctx, x, y + 37, T, 3, '#6b7177');
+        ctx.strokeStyle = '#5f656b';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(x + 8, y + 10); ctx.lineTo(x + 16, y + 18); ctx.lineTo(x + 14, y + 27);
+        ctx.moveTo(x + 28, y + 6); ctx.lineTo(x + 25, y + 15);
+        ctx.stroke();
+    }},
+    {ch: 'W', name: 'Wood', draw (ctx, x, y) {
+        rect(ctx, x, y, T, T, '#b9803f');
+        ctx.fillStyle = '#93602c';
+        ctx.fillRect(x, y + 12, T, 2);
+        ctx.fillRect(x, y + 26, T, 2);
+        ctx.fillRect(x + 18, y, 2, 12);
+        ctx.fillRect(x + 8, y + 14, 2, 12);
+        ctx.fillRect(x + 30, y + 28, 2, 12);
+        ctx.fillStyle = '#d39a55';
+        ctx.fillRect(x, y, T, 2);
+    }},
+    {ch: 'I', name: 'Ice', draw (ctx, x, y) {
+        rect(ctx, x, y, T, T, '#bfe9fb');
+        rect(ctx, x, y + 30, T, 10, '#94d3f0');
+        ctx.fillStyle = 'rgba(255,255,255,0.85)';
+        ctx.beginPath();
+        ctx.moveTo(x + 6, y + 6); ctx.lineTo(x + 16, y + 6); ctx.lineTo(x + 6, y + 18);
+        ctx.fill();
+        ctx.strokeStyle = '#7cc3e6';
+        ctx.lineWidth = 2;
+        ctx.strokeRect(x + 1, y + 1, T - 2, T - 2);
+    }},
+    {ch: 'Q', name: 'Bonus block', draw (ctx, x, y) {
+        rect(ctx, x, y, T, T, '#b8860b');
+        rect(ctx, x + 2, y + 2, T - 4, T - 4, '#f6c22b');
+        ctx.fillStyle = '#b8860b';
+        [[4, 4], [32, 4], [4, 32], [32, 32]].forEach(([a, b]) => ctx.fillRect(x + a, y + b, 4, 4));
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'bold 26px Arial, sans-serif';
+        ctx.textAlign = 'center';
+        ctx.textBaseline = 'middle';
+        ctx.fillText('?', x + 20, y + 21);
+    }},
+    {ch: '~', name: 'Water', draw (ctx, x, y) {
+        rect(ctx, x, y + 6, T, T - 6, 'rgba(33, 133, 230, 0.75)');
+        ctx.strokeStyle = '#9fd5ff';
+        ctx.lineWidth = 3;
+        ctx.beginPath();
+        ctx.moveTo(x, y + 8);
+        ctx.quadraticCurveTo(x + 10, y + 2, x + 20, y + 8);
+        ctx.quadraticCurveTo(x + 30, y + 14, x + 40, y + 8);
+        ctx.stroke();
+    }},
+    {ch: '!', name: 'Lava', draw (ctx, x, y) {
+        rect(ctx, x, y + 6, T, T - 6, '#e2461f');
+        rect(ctx, x, y + 22, T, 18, '#b8320f');
+        ctx.fillStyle = '#ffb02e';
+        ctx.beginPath();
+        ctx.moveTo(x, y + 8);
+        ctx.quadraticCurveTo(x + 10, y, x + 20, y + 8);
+        ctx.quadraticCurveTo(x + 30, y + 16, x + 40, y + 8);
+        ctx.lineTo(x + 40, y + 12); ctx.lineTo(x, y + 12);
+        ctx.fill();
+        ctx.fillStyle = '#ffd36b';
+        ctx.fillRect(x + 10, y + 26, 4, 4);
+        ctx.fillRect(x + 28, y + 32, 4, 4);
+    }},
+    {ch: '^', name: 'Spikes', draw (ctx, x, y) {
+        ctx.fillStyle = '#c9ced3';
+        ctx.strokeStyle = '#5f656b';
+        ctx.lineWidth = 1.5;
+        for (let i = 0; i < 4; i++) {
+            ctx.beginPath();
+            ctx.moveTo(x + i * 10, y + T);
+            ctx.lineTo(x + i * 10 + 5, y + 16);
+            ctx.lineTo(x + i * 10 + 10, y + T);
+            ctx.closePath();
+            ctx.fill();
+            ctx.stroke();
+        }
+    }},
+    {ch: '*', name: 'Coin', draw (ctx, x, y) {
+        ctx.fillStyle = '#e0a800';
+        ctx.beginPath(); ctx.ellipse(x + 20, y + 20, 12, 14, 0, 0, Math.PI * 2); ctx.fill();
+        ctx.fillStyle = '#ffd54a';
+        ctx.beginPath(); ctx.ellipse(x + 20, y + 20, 9, 11, 0, 0, Math.PI * 2); ctx.fill();
+        ctx.fillStyle = '#fff3b0';
+        ctx.fillRect(x + 17, y + 12, 3, 16);
+    }},
+    {ch: '>', name: 'Goal flag', draw (ctx, x, y) {
+        rect(ctx, x + 8, y + 2, 4, T - 2, '#6b4a2b');
+        ctx.fillStyle = '#e53935';
+        ctx.beginPath();
+        ctx.moveTo(x + 12, y + 4); ctx.lineTo(x + 36, y + 11); ctx.lineTo(x + 12, y + 18);
+        ctx.fill();
+        rect(ctx, x + 4, y + 36, 12, 4, '#4a3020');
+    }}
+];
+
+const TILE_BY_CHAR = {};
+TILES.forEach(t => {
+    TILE_BY_CHAR[t.ch] = t;
+});
+
+const BACKGROUNDS = [
+    {id: 'day', name: 'Day sky', draw (ctx, w, h) {
+        const g = ctx.createLinearGradient(0, 0, 0, h);
+        g.addColorStop(0, '#5fb4f0'); g.addColorStop(1, '#d8f0ff');
+        ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
+        ctx.fillStyle = 'rgba(255,255,255,0.9)';
+        [[140, 110, 1], [520, 70, 1.3], [800, 150, 0.9]].forEach(([cx, cy, s]) => {
+            ctx.beginPath();
+            ctx.arc(cx, cy, 26 * s, 0, Math.PI * 2);
+            ctx.arc(cx + 30 * s, cy - 12 * s, 32 * s, 0, Math.PI * 2);
+            ctx.arc(cx + 62 * s, cy, 26 * s, 0, Math.PI * 2);
+            ctx.fill();
+        });
+    }},
+    {id: 'sunset', name: 'Sunset', draw (ctx, w, h) {
+        const g = ctx.createLinearGradient(0, 0, 0, h);
+        g.addColorStop(0, '#3a2a6b'); g.addColorStop(0.55, '#e0706b'); g.addColorStop(1, '#ffd08a');
+        ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
+        ctx.fillStyle = 'rgba(255, 220, 120, 0.9)';
+        ctx.beginPath(); ctx.arc(w * 0.72, h * 0.6, 60, 0, Math.PI * 2); ctx.fill();
+    }},
+    {id: 'night', name: 'Night', draw (ctx, w, h) {
+        const g = ctx.createLinearGradient(0, 0, 0, h);
+        g.addColorStop(0, '#0b1030'); g.addColorStop(1, '#27346b');
+        ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
+        ctx.fillStyle = '#ffffff';
+        for (let i = 0; i < 70; i++) {
+            const sx = (i * 137.5) % w;
+            const sy = ((i * 89.3) % (h * 0.7));
+            ctx.fillRect(sx, sy, i % 5 ? 2 : 3, i % 5 ? 2 : 3);
+        }
+        ctx.fillStyle = '#f4f1d0';
+        ctx.beginPath(); ctx.arc(w * 0.82, h * 0.16, 34, 0, Math.PI * 2); ctx.fill();
+    }},
+    {id: 'cave', name: 'Cave', draw (ctx, w, h) {
+        ctx.fillStyle = '#2a2420'; ctx.fillRect(0, 0, w, h);
+        ctx.fillStyle = '#352d27';
+        for (let i = 0; i < 40; i++) ctx.fillRect((i * 211) % w, (i * 97) % h, 30, 18);
+    }},
+    {id: 'none', name: 'See-through', draw () {}}
+];
+
+/** Draw a whole level (rows of characters) onto a 960x720 canvas. */
+const drawLevel = (ctx, rows, background, {grid = false} = {}) => {
+    const w = COLS * T;
+    const h = ROWS * T;
+    ctx.clearRect(0, 0, w, h);
+    const bg = BACKGROUNDS.find(b => b.id === background) || BACKGROUNDS[0];
+    ctx.save();
+    bg.draw(ctx, w, h);
+    ctx.restore();
+    for (let r = 0; r < ROWS; r++) {
+        for (let c = 0; c < COLS; c++) {
+            const tile = TILE_BY_CHAR[(rows[r] || '')[c]];
+            if (tile) {
+                ctx.save();
+                tile.draw(ctx, c * T, r * T);
+                ctx.restore();
+            }
+        }
+    }
+    if (grid) {
+        ctx.strokeStyle = 'rgba(0, 0, 0, 0.12)';
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        for (let c = 1; c < COLS; c++) {
+            ctx.moveTo(c * T + 0.5, 0); ctx.lineTo(c * T + 0.5, h);
+        }
+        for (let r = 1; r < ROWS; r++) {
+            ctx.moveTo(0, r * T + 0.5); ctx.lineTo(w, r * T + 0.5);
+        }
+        ctx.stroke();
+    }
+};
+
+const emptyRows = () => Array.from({length: ROWS}, () => '.'.repeat(COLS));
+
+const starterRows = () => {
+    const rows = emptyRows().map(r => r.split(''));
+    for (let c = 0; c < COLS; c++) {
+        rows[15][c] = 'G';
+        rows[16][c] = 'D';
+        rows[17][c] = 'D';
+    }
+    return rows.map(r => r.join(''));
+};
+
+export {
+    T,
+    COLS,
+    ROWS,
+    SOLID,
+    TILES,
+    TILE_BY_CHAR,
+    BACKGROUNDS,
+    drawLevel,
+    emptyRows,
+    starterRows
+};
diff --git a/src/components/sl-publish/publish-dialog.jsx b/src/components/sl-publish/publish-dialog.jsx
new file mode 100644
index 0000000..d0afa4e
--- /dev/null
+++ b/src/components/sl-publish/publish-dialog.jsx
@@ -0,0 +1,300 @@
+// Stick Lab 1.3: publish the project to the Stick Hubs Game Hub.
+import React from 'react';
+import PropTypes from 'prop-types';
+import {connect} from 'react-redux';
+import {isPublishOpen, setPublishOpen, onPublishChange} from './publish-store';
+import {serverUrl, findMine, loadNickname, saveNickname, publishProject, siteUrl, account} from '../../lib/sl-hub/hub-client';
+import {sb3BlobToStickLabBlob} from '../../lib/sl-format';
+import styles from './publish.css';
+
+const THUMB_W = 480;
+const THUMB_H = 360;
+
+const snapshot = vm => new Promise(resolve => {
+    const renderer = vm.runtime.renderer;
+    if (!renderer || typeof renderer.requestSnapshot !== 'function') {
+        resolve(null);
+        return;
+    }
+    renderer.requestSnapshot(dataUrl => {
+        const img = new Image();
+        img.onload = () => {
+            const canvas = document.createElement('canvas');
+            canvas.width = THUMB_W;
+            canvas.height = THUMB_H;
+            const ctx = canvas.getContext('2d');
+            ctx.fillStyle = '#ffffff';
+            ctx.fillRect(0, 0, THUMB_W, THUMB_H);
+            ctx.drawImage(img, 0, 0, THUMB_W, THUMB_H);
+            canvas.toBlob(blob => resolve({blob, url: canvas.toDataURL('image/jpeg', 0.85)}), 'image/jpeg', 0.85);
+        };
+        img.onerror = () => resolve(null);
+        img.src = dataUrl;
+    });
+});
+
+class PublishDialog extends React.Component {
+    constructor (props) {
+        super(props);
+        this.state = this.freshState(isPublishOpen());
+        this.handleClose = () => {
+            if (!this.state.busy) setPublishOpen(false);
+        };
+        this.handlePublish = this.handlePublish.bind(this);
+        this.handleRetake = this.handleRetake.bind(this);
+    }
+    componentDidMount () {
+        this.unsubscribe = onPublishChange(open => {
+            if (open) {
+                this.setState(this.freshState(true), () => this.prepare());
+            } else {
+                this.setState({open: false});
+            }
+        });
+    }
+    componentWillUnmount () {
+        this.unsubscribe();
+    }
+    freshState (open) {
+        return {
+            open,
+            title: '',
+            author: (account() && account().profile.displayName) || loadNickname(),
+            signedIn: account(),
+            description: '',
+            agree: false,
+            mode: 'new',
+            existing: null,
+            thumb: null,
+            busy: false,
+            error: null,
+            done: null,
+            server: undefined
+        };
+    }
+    async prepare () {
+        const title = (this.props.projectTitle || '').trim() || 'My project';
+        const existing = findMine(title);
+        this.setState({title, existing, mode: existing ? 'update' : 'new'});
+        const [server, thumb] = await Promise.all([serverUrl(), snapshot(this.props.vm)]);
+        this.setState({server, thumb});
+    }
+    async handleRetake () {
+        this.setState({thumb: await snapshot(this.props.vm)});
+    }
+    async handlePublish () {
+        const {title, author, description, agree, mode, existing, thumb} = this.state;
+        if (!title.trim() || !author.trim()) {
+            this.setState({error: 'Add a title and a nickname first.'});
+            return;
+        }
+        if (!agree) {
+            this.setState({error: 'Tick the box to say the project is OK to share.'});
+            return;
+        }
+        this.setState({busy: true, error: null});
+        try {
+            saveNickname(author.trim());
+            const sb3 = await this.props.vm.saveProjectSb3();
+            const file = await sb3BlobToStickLabBlob(sb3);
+            const result = await publishProject({
+                title: title.trim(),
+                author: author.trim(),
+                description: description.trim(),
+                file,
+                thumb: thumb && thumb.blob,
+                updateId: mode === 'update' && existing ? existing.id : null
+            });
+            this.setState({busy: false, done: result});
+        } catch (e) {
+            this.setState({busy: false, error: e.message});
+        }
+    }
+    renderField (label, key, props = {}) {
+        const Tag = props.multiline ? 'textarea' : 'input';
+        return (
+            <label className={styles.field}>
+                <span className={styles.label}>{label}</span>
+                <Tag
+                    className={styles.input}
+                    maxLength={props.max}
+                    placeholder={props.placeholder}
+                    rows={props.multiline ? 3 : undefined}
+                    value={this.state[key]}
+                    onChange={e => this.setState({[key]: e.target.value, error: null})} // eslint-disable-line react/jsx-no-bind
+                />
+                {props.hint ? <span className={styles.hint}>{props.hint}</span> : null}
+            </label>
+        );
+    }
+    renderBody () {
+        const {server, done, thumb, existing, mode, busy, error, agree} = this.state;
+        if (done) {
+            return (
+                <div className={styles.body}>
+                    <div className={styles.success}>
+                        <div className={styles.bigTick}>{'✓'}</div>
+                        <div>
+                            <b>{mode === 'update' ? 'Your project is updated on the Game Hub!' : 'Your project is on the Game Hub!'}</b>
+                            <div className={styles.hint}>{'Anyone can play it with this link:'}</div>
+                        </div>
+                    </div>
+                    <input
+                        readOnly
+                        className={styles.input}
+                        value={done.url}
+                        onFocus={e => e.target.select()} // eslint-disable-line react/jsx-no-bind
+                    />
+                    <div className={styles.buttons}>
+                        <a
+                            className={styles.primary}
+                            href={done.url}
+                            rel="noopener noreferrer"
+                            target="_blank"
+                        >{'Play it'}</a>
+                        <a
+                            className={styles.secondary}
+                            href={`${siteUrl()}games.html#community`}
+                            rel="noopener noreferrer"
+                            target="_blank"
+                        >{'Open the Game Hub'}</a>
+                        <button
+                            className={styles.secondary}
+                            onClick={this.handleClose}
+                        >{'Close'}</button>
+                    </div>
+                </div>
+            );
+        }
+        if (server === null) {
+            return (
+                <div className={styles.body}>
+                    <p>{'Publishing isn\'t switched on yet. The Stick Hubs server needs to be set up first.'}</p>
+                    <p className={styles.hint}>{'You can still save your project as a .sl file with File → Save to your computer.'}</p>
+                    <div className={styles.buttons}>
+                        <button
+                            className={styles.secondary}
+                            onClick={this.handleClose}
+                        >{'Close'}</button>
+                    </div>
+                </div>
+            );
+        }
+        return (
+            <div className={styles.body}>
+                <div className={styles.columns}>
+                    <div className={styles.form}>
+                        {this.renderField('Title', 'title', {max: 60})}
+                        {this.renderField('Your nickname', 'author', {
+                            max: 30,
+                            placeholder: 'e.g. StickFan99',
+                            hint: this.state.signedIn ?
+                                `Signed in as @${this.state.signedIn.profile.login}: it will show on your Stick Hubs profile.` :
+                                'Shown with your project. Don\'t use your real full name. Sign in on the Stick Hubs website to add it to your profile.'
+                        })}
+                        {this.renderField('About this project (optional)', 'description', {
+                            max: 500,
+                            multiline: true,
+                            placeholder: 'How to play, controls, credits...'
+                        })}
+                    </div>
+                    <div className={styles.cover}>
+                        <span className={styles.label}>{'Cover picture'}</span>
+                        {thumb ? (
+                            <img
+                                alt="Cover"
+                                className={styles.thumb}
+                                src={thumb.url}
+                            />
+                        ) : <div className={styles.thumbEmpty}>{'...'}</div>}
+                        <button
+                            className={styles.small}
+                            onClick={this.handleRetake}
+                        >{'Use the stage as it looks now'}</button>
+                    </div>
+                </div>
+                {existing ? (
+                    <div className={styles.choice}>
+                        <label>
+                            <input
+                                checked={mode === 'update'}
+                                type="radio"
+                                onChange={() => this.setState({mode: 'update'})} // eslint-disable-line react/jsx-no-bind
+                            />
+                            {' Update my published project (same link)'}
+                        </label>
+                        <label>
+                            <input
+                                checked={mode === 'new'}
+                                type="radio"
+                                onChange={() => this.setState({mode: 'new'})} // eslint-disable-line react/jsx-no-bind
+                            />
+                            {' Publish as a new project'}
+                        </label>
+                    </div>
+                ) : null}
+                <label className={styles.agree}>
+                    <input
+                        checked={agree}
+                        type="checkbox"
+                        onChange={e => this.setState({agree: e.target.checked, error: null})} // eslint-disable-line react/jsx-no-bind
+                    />
+                    <span>{'This is my own project (or I have permission), and it\'s OK for kids to see. ' +
+                        'Everyone will be able to play it and open it in Stick Lab.'}</span>
+                </label>
+                {error ? <div className={styles.error}>{error}</div> : null}
+                <div className={styles.buttons}>
+                    <button
+                        className={styles.primary}
+                        disabled={busy || server === undefined}
+                        onClick={this.handlePublish}
+                    >{busy ? 'Publishing...' : mode === 'update' ? 'Update on the Game Hub' : 'Publish to the Game Hub'}</button>
+                    <button
+                        className={styles.secondary}
+                        disabled={busy}
+                        onClick={this.handleClose}
+                    >{'Cancel'}</button>
+                </div>
+            </div>
+        );
+    }
+    render () {
+        if (!this.state.open) return null;
+        return (
+            <div
+                className={styles.backdrop}
+                onClick={e => e.target === e.currentTarget && this.handleClose()} // eslint-disable-line react/jsx-no-bind
+            >
+                <div
+                    aria-label="Publish to the Game Hub"
+                    className={styles.window}
+                    role="dialog"
+                >
+                    <div className={styles.header}>
+                        <span>{'Publish to the Game Hub'}</span>
+                        <button
+                            className={styles.close}
+                            title="Close"
+                            onClick={this.handleClose}
+                        >{'✕'}</button>
+                    </div>
+                    {this.renderBody()}
+                </div>
+            </div>
+        );
+    }
+}
+
+PublishDialog.propTypes = {
+    projectTitle: PropTypes.string,
+    vm: PropTypes.shape({
+        runtime: PropTypes.object,
+        saveProjectSb3: PropTypes.func
+    }).isRequired
+};
+
+const mapStateToProps = state => ({
+    projectTitle: state.scratchGui.projectTitle
+});
+
+export default connect(mapStateToProps)(PublishDialog);
