+/* Stick Lab: Blocks/Text switch and Text coding editor (classic Stick Hubs style) */
+
+.toggle {
+    display: flex;
+    flex-direction: column;
+    width: 100%;
+    height: 100%;
+}
+
+.toggle-button {
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    gap: 1px;
+    border: 0;
+    margin: 0;
+    padding: 0;
+    cursor: pointer;
+    background: transparent;
+    color: rgba(255, 255, 255, 0.8);
+    font-family: "Trebuchet MS", "Segoe UI", Verdana, sans-serif;
+    font-size: 0.65rem;
+    font-weight: bold;
+    letter-spacing: 0.02em;
+}
+
+.toggle-button + .toggle-button {
+    border-top: 1px solid rgba(255, 255, 255, 0.35);
+}
+
+.toggle-button:hover {
+    color: #ffffff;
+    background: rgba(255, 255, 255, 0.12);
+}
+
+.toggle-active,
+.toggle-active:hover {
+    color: #1d4f91;
+    background: linear-gradient(180deg, #ffffff 0%, #f2f6fb 45%, #dde7f3 50%, #e8eff8 100%);
+    box-shadow: inset 0 0 0 1px #8ea4c1, inset 0 2px 0 rgba(255, 255, 255, 0.9);
+}
+
+/* ---- editor ---- */
+
+.overlay {
+    position: absolute;
+    inset: 0;
+    z-index: 45;
+    display: flex;
+    background: #f5f8fc;
+    border-top: 1px solid #c3d1e2;
+    font-family: Verdana, Tahoma, "Segoe UI", sans-serif;
+}
+
+.tool-strip {
+    width: calc(3.75rem + 1px);
+    flex: none;
+    background: linear-gradient(180deg, #f4f8fd, #dbe6f3);
+    border-right: 1px solid #a9bcd3;
+}
+
+.commands {
+    width: 15.5rem;
+    flex: none;
+    display: flex;
+    flex-direction: column;
+    background: #eef3fa;
+    border-right: 1px solid #a9bcd3;
+    min-height: 0;
+}
+
+.commands-title {
+    padding: 0.5rem 0.75rem 0;
+    font: bold 0.95rem "Trebuchet MS", "Segoe UI", Verdana, sans-serif;
+    color: #1d4f91;
+}
+
+.commands-hint {
+    padding: 0 0.75rem 0.4rem;
+    font-size: 0.7rem;
+    color: #555;
+    border-bottom: 1px solid #c3d1e2;
+}
+
+.commands-scroll {
+    overflow-y: auto;
+    flex: 1;
+    padding: 0.25rem 0.4rem 0.5rem;
+}
+
+.group + .group {
+    margin-top: 2px;
+}
+
+.group-header {
+    width: 100%;
+    display: flex;
+    align-items: center;
+    gap: 0.4rem;
+    padding: 0.35rem 0.5rem;
+    border: 1px solid #c3d1e2;
+    border-left-width: 4px;
+    border-radius: 2px;
+    background: linear-gradient(180deg, #ffffff 0%, #f2f6fb 45%, #dde7f3 50%, #e8eff8 100%);
+    color: #1d4f91;
+    font: bold 0.75rem Verdana, Tahoma, sans-serif;
+    text-align: left;
+    cursor: pointer;
+}
+
+.group-dot {
+    width: 0.6rem;
+    height: 0.6rem;
+    border-radius: 1px;
+    flex: none;
+}
+
+.group-caret {
+    margin-left: auto;
+    color: #5d82b0;
+}
+
+.command {
+    display: block;
+    width: 100%;
+    margin: 2px 0 0;
+    padding: 0.25rem 0.5rem;
+    border: 1px solid #d5dfeb;
+    border-left: 4px solid;
+    border-radius: 2px;
+    background: #ffffff;
+    color: #1f3550;
+    font: 0.72rem/1.35 Consolas, "Courier New", monospace;
+    text-align: left;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    cursor: pointer;
+}
+
+.command:hover {
+    background: #e4edf8;
+}
+
+.command-hat {
+    font-weight: bold;
+}
+
+.editor-column {
+    flex: 1;
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+}
+
+.editor-header {
+    display: flex;
+    align-items: center;
+    padding: 0.35rem 0.6rem;
+    background: linear-gradient(180deg, #fdfeff 0%, #ebf2fb 45%, #d6e4f5 50%, #e3edf9 100%);
+    border-bottom: 1px solid #a9bcd3;
+}
+
+.editor-title {
+    font: bold 0.85rem "Trebuchet MS", "Segoe UI", Verdana, sans-serif;
+    color: #1d4f91;
+}
+
+.editor-target {
+    font-weight: normal;
+    color: #555;
+}
+
+.editor-buttons {
+    margin-left: auto;
+    display: flex;
+    gap: 0.35rem;
+}
+
+.header-button {
+    font: bold 0.72rem Verdana, Tahoma, sans-serif;
+    color: #1d4f91;
+    padding: 0.25rem 0.6rem;
+    border: 1px solid #8ea4c1;
+    border-radius: 3px;
+    background: linear-gradient(180deg, #ffffff 0%, #f2f6fb 45%, #dde7f3 50%, #e8eff8 100%);
+    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
+    cursor: pointer;
+}
+
+.header-button:hover,
+.header-button-active {
+    background: linear-gradient(180deg, #ffffff, #d3e1f1);
+    border-color: #5d82b0;
+}
+
+.help {
+    padding: 0.5rem 0.75rem;
+    background: #fffbe6;
+    border-bottom: 1px solid #e6d58a;
+    font-size: 0.72rem;
+    color: #333;
+    max-height: 40%;
+    overflow-y: auto;
+}
+
+.help-row {
+    display: flex;
+    gap: 0.6rem;
+    padding: 0.15rem 0;
+}
+
+.help-row code {
+    flex: none;
+    width: 14rem;
+    font-family: Consolas, "Courier New", monospace;
+    color: #1d4f91;
+}
+
+.editor-body {
+    flex: 1;
+    min-height: 0;
+    display: flex;
+    background: #ffffff;
+}
+
+.gutter {
+    flex: none;
+    width: 2.75rem;
+    overflow: hidden;
+    padding: 0.5rem 0;
+    background: #f0f4f9;
