+import React from 'react';
+import classNames from 'classnames';
+import {getCodeMode, setCodeMode, onCodeModeChange} from './code-mode-store';
+import styles from './text-code.css';
+
+const BlocksIcon = () => (
+    <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
+        <path d="M3 5h7l1.5 1.5L13 5h8v6h-8l-1.5 1.5L10 11H3z" fill="currentColor" />
+        <path d="M3 14h7l1.5 1.5L13 14h5v5H3z" fill="currentColor" opacity="0.75" />
+    </svg>
+);
+
+const TextIcon = () => (
+    <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
+        <path
+            d="M8 6l-5 6 5 6M16 6l5 6-5 6"
+            fill="none"
+            stroke="currentColor"
+            strokeLinecap="round"
+            strokeLinejoin="round"
+            strokeWidth="2.4"
+        />
+    </svg>
+);
+
+class CodeModeToggle extends React.Component {
+    constructor (props) {
+        super(props);
+        this.state = {mode: getCodeMode()};
+        this.handleBlocks = () => setCodeMode('blocks');
+        this.handleText = () => setCodeMode('text');
+    }
+    componentDidMount () {
+        this.unsubscribe = onCodeModeChange(mode => this.setState({mode}));
+    }
+    componentWillUnmount () {
+        this.unsubscribe();
+    }
+    render () {
+        const {mode} = this.state;
+        return (
+            <div
+                className={styles.toggle}
+                role="radiogroup"
+                aria-label="Type of coding"
+            >
+                <button
+                    aria-checked={mode === 'blocks'}
+                    className={classNames(styles.toggleButton, {[styles.toggleActive]: mode === 'blocks'})}
+                    role="radio"
+                    title="Block coding"
+                    onClick={this.handleBlocks}
+                >
+                    <BlocksIcon />
+                    <span>{'Blocks'}</span>
+                </button>
+                <button
+                    aria-checked={mode === 'text'}
+                    className={classNames(styles.toggleButton, {[styles.toggleActive]: mode === 'text'})}
+                    role="radio"
+                    title="Text coding"
+                    onClick={this.handleText}
+                >
+                    <TextIcon />
+                    <span>{'Text'}</span>
+                </button>
+            </div>
+        );
+    }
+}
+
+export default CodeModeToggle;
diff --git a/src/components/sl-text-code/text-code-editor.jsx b/src/components/sl-text-code/text-code-editor.jsx
