+            const vars = Object.values(target.variables).concat(
+                target.isStage ? [] : Object.values(vm.runtime.getTargetForStage().variables)
+            ).filter(v => v.type === '' || v.type === 'list').map(v => (v.type === 'list' ? `@${v.name}` : `$${v.name}`));
+            if (vars.length) lines.push(`Variables and lists: ${vars.join(', ')}.`);
+            if ((this.state.settings.seeCode || kind === 'explain' || kind === 'fix') && ws && kind !== 'build') {
+                try {
+                    const code = workspaceToText(ws.workspace, ws.ScratchBlocks).text.trim();
+                    lines.push('', code ? `The user's current scripts for this sprite:\n\`\`\`stick\n${code}\n\`\`\`` :
